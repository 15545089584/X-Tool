                    <Border Grid.Column="0" Width="6" Height="7" VerticalAlignment="Center" Background="#A48DFF" CornerRadius="3" /><Border Grid.Column="1" Width="6" Height="10" VerticalAlignment="Center" Background="#7C9FFF" CornerRadius="3" /><Border Grid.Column="2" Width="6" Height="14" VerticalAlignment="Center" Background="#5BC9FF" CornerRadius="3" /><Border Grid.Column="3" Width="6" Height="17" VerticalAlignment="Center" Background="#5DE9DA" CornerRadius="3" /><Border Grid.Column="4" Width="6" Height="20" VerticalAlignment="Center" Background="#6FE7A0" CornerRadius="3" /><Border Grid.Column="5" Width="6" Height="23" VerticalAlignment="Center" Background="#B6EF6B" CornerRadius="3" /><Border Grid.Column="6" Width="6" Height="26" VerticalAlignment="Center" Background="#F4EC65" CornerRadius="3" /><Border Grid.Column="7" Width="6" Height="29" VerticalAlignment="Center" Background="#FFC866" CornerRadius="3" /><Border Grid.Column="8" Width="6" Height="32" VerticalAlignment="Center" Background="#FF8E7A" CornerRadius="3" /><Border Grid.Column="9" Width="6" Height="29" VerticalAlignment="Center" Background="#FF77B7" CornerRadius="3" /><Border Grid.Column="10" Width="6" Height="26" VerticalAlignment="Center" Background="#D789FF" CornerRadius="3" /><Border Grid.Column="11" Width="6" Height="23" VerticalAlignment="Center" Background="#9E82FF" CornerRadius="3" /><Border Grid.Column="12" Width="6" Height="20" VerticalAlignment="Center" Background="#6EA3FF" CornerRadius="3" /><Border Grid.Column="13" Width="6" Height="17" VerticalAlignment="Center" Background="#66D6FF" CornerRadius="3" /><Border Grid.Column="14" Width="6" Height="14" VerticalAlignment="Center" Background="#63E6C5" CornerRadius="3" /><Border Grid.Column="15" Width="6" Height="10" VerticalAlignment="Center" Background="#91E98A" CornerRadius="3" /><Border Grid.Column="16" Width="6" Height="7" VerticalAlignment="Center" Background="#C4E97A" CornerRadius="3" />
