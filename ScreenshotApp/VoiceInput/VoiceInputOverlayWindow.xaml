<Window x:Class="ScreenshotApp.VoiceInput.VoiceInputOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="474" Height="112" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True">
    <Border Padding="18,14" Background="#DDF9FCFF" BorderBrush="#C7FFFFFF" BorderThickness="1" CornerRadius="24">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#314A6D" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid><TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="#294765" Text="正在聆听…" /><TextBlock x:Name="DetailText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#66809A" Text="按右 Alt 结束" TextTrimming="CharacterEllipsis" /></Grid>
            <Border Grid.Row="2" Padding="20,8" Background="#CC17263B" BorderBrush="#6DFFFFFF" BorderThickness="1" CornerRadius="18">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="6" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="6" Height="9" VerticalAlignment="Center" Background="#A48DFF" CornerRadius="3" /><Border Grid.Column="1" Width="6" Height="14" VerticalAlignment="Center" Background="#7C9FFF" CornerRadius="3" /><Border Grid.Column="2" Width="6" Height="18" VerticalAlignment="Center" Background="#5BC9FF" CornerRadius="3" /><Border Grid.Column="3" Width="6" Height="22" VerticalAlignment="Center" Background="#5DE9DA" CornerRadius="3" /><Border Grid.Column="4" Width="6" Height="26" VerticalAlignment="Center" Background="#6FE7A0" CornerRadius="3" /><Border Grid.Column="5" Width="6" Height="30" VerticalAlignment="Center" Background="#B6EF6B" CornerRadius="3" /><Border Grid.Column="6" Width="6" Height="34" VerticalAlignment="Center" Background="#F4EC65" CornerRadius="3" /><Border Grid.Column="7" Width="6" Height="38" VerticalAlignment="Center" Background="#FFC866" CornerRadius="3" /><Border Grid.Column="8" Width="6" Height="42" VerticalAlignment="Center" Background="#FF8E7A" CornerRadius="3" /><Border Grid.Column="9" Width="6" Height="38" VerticalAlignment="Center" Background="#FF77B7" CornerRadius="3" /><Border Grid.Column="10" Width="6" Height="34" VerticalAlignment="Center" Background="#D789FF" CornerRadius="3" /><Border Grid.Column="11" Width="6" Height="30" VerticalAlignment="Center" Background="#9E82FF" CornerRadius="3" /><Border Grid.Column="12" Width="6" Height="26" VerticalAlignment="Center" Background="#6EA3FF" CornerRadius="3" /><Border Grid.Column="13" Width="6" Height="22" VerticalAlignment="Center" Background="#66D6FF" CornerRadius="3" /><Border Grid.Column="14" Width="6" Height="18" VerticalAlignment="Center" Background="#63E6C5" CornerRadius="3" /><Border Grid.Column="15" Width="6" Height="14" VerticalAlignment="Center" Background="#91E98A" CornerRadius="3" /><Border Grid.Column="16" Width="6" Height="9" VerticalAlignment="Center" Background="#C4E97A" CornerRadius="3" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
