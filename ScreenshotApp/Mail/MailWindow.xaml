<Window x:Class="ScreenshotApp.Mail.MailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="邮箱中心 · X-Tool" Width="1440" Height="960" MinWidth="1000" MinHeight="620" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#152C48" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MailStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border x:Name="WindowSurface" CornerRadius="16" BorderThickness="0" Padding="0">
 <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAF6FF"/><GradientStop Color="#F1EDFF" Offset="0.55"/><GradientStop Color="#FFEDF6" Offset="0.8"/><GradientStop Color="#EFF3FF" Offset="1"/></LinearGradientBrush></Border.Background>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Grid Margin="16,0,6,0" Background="Transparent">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#DFFFFFFF" CornerRadius="8" Padding="5"><TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource MailGradient}" FontSize="18"/></Border><TextBlock Text="X-Tool  /" FontWeight="Bold" Margin="10,0,12,0"/><TextBlock Text="邮箱中心" Foreground="#657D9E"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化"><TextBlock Text="—" FontFamily="Segoe UI" FontSize="18" Foreground="#536B89"/></Button>
    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化 / 还原"><TextBlock Text="□" FontFamily="Segoe UI" FontSize="18" Foreground="#536B89"/></Button>
    <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="关闭邮箱窗口"><TextBlock Text="×" FontFamily="Segoe UI" FontSize="18" Foreground="#536B89"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="24,6,24,14">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="5" Height="28" VerticalAlignment="Center" CornerRadius="3" Margin="0,0,12,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3B82F6"/><GradientStop Color="#4F46E5" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="邮箱工作台" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="↻  刷新" Click="Refresh_Click" Background="White" Margin="0,0,10,0"/>
    <Button Style="{StaticResource MailPrimary}" Click="Add_Click"><TextBlock Text="＋  添加邮箱" Foreground="White"/></Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Margin="0" Background="Transparent" CornerRadius="0" BorderBrush="Transparent" BorderThickness="0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AccountColumn" Width="280" MinWidth="170"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="ListColumn" Width="0.36*" MinWidth="270"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="ReaderColumn" Width="0.64*" MinWidth="350"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" CornerRadius="0" BorderBrush="#E6EDF7" BorderThickness="0,0,1,0" Padding="16,20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <DockPanel Margin="8,0,8,14"><TextBlock x:Name="AccountCount" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#7487A2"/><TextBlock Text="我的邮箱" FontWeight="SemiBold" Foreground="#7487A2"/></DockPanel>
      <ListBox x:Name="Accounts" SelectionChanged="Account_Changed" HorizontalContentAlignment="Stretch" Margin="0,0,0,14" ToolTip="点击切换邮箱；右键编辑备注与账户设置">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource MailCard}"><EventSetter Event="PreviewMouseRightButtonUp" Handler="Account_RightClick"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Address}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" Background="#F6F9FC" CornerRadius="10" VerticalAlignment="Center"><Image Source="{Binding Logo}" Width="24" Height="24"/></Border>
        <StackPanel Grid.Column="1" Margin="6,0,3,0"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="14"/><TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" Foreground="#71829E" Margin="0,5,0,0" FontSize="12" FontFamily="Consolas"/></StackPanel>
        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding ConnectionColor}" VerticalAlignment="Center" ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Status}"><Ellipse.Effect><DropShadowEffect Color="{Binding ConnectionColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect></Ellipse>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
        <TextBlock Text="收件箱分类" FontWeight="SemiBold" Foreground="#7487A2" Margin="10,22,0,14"/>
        <Button Click="All_Click" Background="{StaticResource MailGradient}" HorizontalContentAlignment="Stretch"><DockPanel><TextBlock x:Name="InboxCount" DockPanel.Dock="Right" Foreground="White" HorizontalAlignment="Right"/><TextBlock Text="全部收件箱" Foreground="White"/></DockPanel></Button>
        <Button Click="Starred_Click" Background="Transparent" HorizontalContentAlignment="Stretch" Margin="0,8,0,0"><DockPanel><TextBlock x:Name="StarredCount" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8396B3"/><TextBlock Text="☆   星标邮件" Foreground="#536783"/></DockPanel></Button>
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,24,0,0">
       <Button Content="⚙  账户设置" Click="Settings_Click" Background="#CCFFFFFF"/>

      </StackPanel>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E9EDF6" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="Splitter_DragCompleted" ToolTip="拖动调整账户栏宽度"/>
    <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#E9EDF6" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="Splitter_DragCompleted" ToolTip="拖动调整列表与正文比例"/>
    <Border Grid.Column="2" Background="Transparent" BorderBrush="#E6EDF7" BorderThickness="0,0,1,0">
     <Grid Margin="8,12,8,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><TextBox x:Name="Search" TextChanged="Filter_Changed" Height="38" MinHeight="0" VerticalContentAlignment="Center" Padding="34,8,12,8" ToolTip="搜索发件人或主题"/>
       <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#8B9BB0" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <TextBlock Text="搜索发件人、主题…" Foreground="#8B9BB0" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,10,0,10">
       <RadioButton x:Name="AllFilter" Content="全部" Tag="all" GroupName="MailFilter" Style="{StaticResource MailFilter}" IsChecked="True" Checked="Mode_Changed"/>
       <RadioButton x:Name="UnreadFilter" Content="未读" Tag="unread" GroupName="MailFilter" Style="{StaticResource MailFilter}" Checked="Mode_Changed"/>
       <RadioButton x:Name="StarredFilter" Content="星标" ToolTip="筛选邮箱中已有的星标邮件" Tag="flagged" GroupName="MailFilter" Style="{StaticResource MailFilter}" Checked="Mode_Changed"/>
       <RadioButton Content="含附件" Tag="attachment" GroupName="MailFilter" Style="{StaticResource MailFilter}" Checked="Mode_Changed"/>
       <TextBlock x:Name="ListCount" VerticalAlignment="Center" Foreground="#8997AA" FontSize="10" Margin="8,0,0,0"/>
      </StackPanel>
      <ListBox ItemContainerStyle="{StaticResource MailCard}" Grid.Row="2" Margin="0,0,0,26" x:Name="Messages" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" SelectionChanged="Message_Changed" ScrollViewer.VerticalScrollBarVisibility="Auto">
       <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <Grid Margin="0,0,0,10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="30" Height="30" CornerRadius="8" Background="Transparent" VerticalAlignment="Top">
          <Grid><TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold" Foreground="#4568BD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <Image Source="{Binding Logo}" Width="26" Height="26"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
          </Grid>
         </Border>
         <StackPanel Grid.Column="1" Margin="2,0,4,0">
          <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14" ToolTip="{Binding Sender}"/>
          <TextBlock Text="{Binding SenderAddress}" Foreground="#8590A2" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="#8997AA" FontSize="11" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" FontSize="14" LineHeight="22" MaxHeight="46"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#25354B"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding Seen}" Value="True"><Setter Property="FontWeight" Value="Normal"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding AccountLabel}" TextTrimming="CharacterEllipsis" Foreground="#8899B0" FontSize="12" Margin="0,8,0,0"/>
        <DockPanel Margin="0,10,0,0">
         <TextBlock Text="{Binding AttachmentLabel}" Foreground="#7C3AED" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10"/>
         <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E0F2FE"/><Style.Triggers><DataTrigger Binding="{Binding Seen}" Value="True"><Setter Property="Background" Value="#F1F5F9"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StateLabel}" Foreground="#387693" FontSize="10"/></Border>
        </DockPanel>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="ListBottomFade" Grid.Row="2" Height="30" Margin="0,0,12,26" VerticalAlignment="Bottom" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00F1EDFF"/><GradientStop Color="#F1EDFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <TextBlock x:Name="ListScrollHint" Grid.Row="2" Height="22" VerticalAlignment="Bottom" Text="向下滚动查看更多" HorizontalAlignment="Center" Foreground="#7D8BA5" FontSize="10" IsHitTestVisible="False"/>
      <TextBlock x:Name="ListEmpty" Grid.Row="2" Text="暂无邮件&#xA;添加账户后，来信会显示在这里" TextAlignment="Center" TextWrapping="Wrap" Foreground="#8B9BB0" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <Grid Grid.Column="4" Background="#35FFFFFF">
     <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="#E6EDF7" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel LastChildFill="False">
       <Button x:Name="ReadButton" Content="✓  标为已读" Click="Read_Click" IsEnabled="False" DockPanel.Dock="Left" Padding="12,6" Background="#F3F6FC"/>
       <Button x:Name="TranslateButton" Style="{StaticResource MailTranslationButton}" Click="Translate_Click" IsEnabled="False" DockPanel.Dock="Left" Width="36" Height="34" Padding="6" Margin="6,0,0,0" Background="#F3F6FC" ToolTip="翻译为中文（本地离线）" AutomationProperties.Name="翻译邮件标题与正文">
        <TextBlock Text="&#xE8C1;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#5558D9"/>
       </Button>
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <TextBlock x:Name="Position" VerticalAlignment="Center" Foreground="#8899B0" FontSize="11" Margin="0,0,10,0"/>
        <Button x:Name="Previous" Content="‹" FontSize="20" Padding="10,2" Click="Previous_Click" IsEnabled="False" ToolTip="上一封" Margin="0,0,6,0"/>
        <Button x:Name="Next" Content="›" FontSize="20" Padding="10,2" Click="Next_Click" IsEnabled="False" ToolTip="下一封"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <Grid Grid.Row="1" x:Name="Reader" Margin="24,20" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="Subject" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="128" LineHeight="33"/>
      <Border Grid.Row="1" Background="#BFFFFFFF" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,16">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" Background="Transparent" CornerRadius="10" VerticalAlignment="Center">
         <Grid><TextBlock x:Name="SenderInitial" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#4568BD"/><Image x:Name="SenderLogo" Width="36" Height="36"/></Grid>
        </Border>
        <StackPanel Grid.Column="1">
         <TextBlock x:Name="SenderName" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
         <TextBlock x:Name="Sender" Foreground="#8895AB" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"/>
        </StackPanel>
       </Grid>
      </Border>
      <RichTextBox Grid.Row="2" x:Name="Body" IsReadOnly="True" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,5" FontSize="15"/>
      <ScrollViewer Grid.Row="3" MaxHeight="170" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Attachments"/></ScrollViewer>
     </Grid>
     <StackPanel x:Name="ReaderEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
      <Border CornerRadius="28" Width="100" Height="100" HorizontalAlignment="Center" BorderBrush="#EFFFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D6EAFE"/><GradientStop Color="#E3DAFF" Offset="0.55"/><GradientStop Color="#FADEEE" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons" FontSize="42" Foreground="{StaticResource MailGradient}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="留一处空间，读一封来信" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,10"/>
      <TextBlock Text="选择左侧邮件，查看正文与附件&#xA;阅读不会自动改变已读状态" Foreground="#8899B0" TextAlignment="Center" LineHeight="23"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <DockPanel Grid.Row="3" Margin="26,0"><TextBlock Text="最近 200 封 / 账户" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#8899B0" VerticalAlignment="Center"/><TextBlock x:Name="Notice" FontSize="11" Foreground="#7487A2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
  <Border x:Name="ModalShade" Grid.RowSpan="4" Background="#553E506C" Visibility="Collapsed" CornerRadius="12"/>
 </Grid>
 </Border>
</Window>
