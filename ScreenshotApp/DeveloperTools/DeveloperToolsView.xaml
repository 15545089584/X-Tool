<UserControl x:Class="ScreenshotApp.DeveloperTools.DeveloperToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Loaded="DeveloperToolsView_Loaded"
             IsVisibleChanged="DeveloperToolsView_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="DeveloperTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#506B85" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="#70FFFFFF" BorderBrush="#90D5E6F5" BorderThickness="1" CornerRadius="11">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C6FFFFFF" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#4D7CFE" /><Setter TargetName="Root" Property="BorderBrush" Value="#739BFF" /><Setter Property="Foreground" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeveloperSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#84FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9D4E8F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#46627D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEEFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#74A9E8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeveloperPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DeveloperSmallButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#739BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DeveloperStatusButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock FontSize="10" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.58" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeveloperGlassComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9CEE8F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#405F7C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Foreground" Value="#405F7C" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#DCEBFF" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#C9DEFF" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboRoot" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboRoot" Property="Background" Value="#E4F1FFFF" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboRoot" Property="Background" Value="#DCEBFF" /><Setter TargetName="ComboRoot" Property="BorderBrush" Value="#609BFE" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.58" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5"
                                        Background="#F2FAFFFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect>
                                    <ScrollViewer MaxHeight="220"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeveloperGlassScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="3,7,3,7" />
            <Setter Property="Background" Value="#38D3E5F5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#89A9C7E5" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DeveloperGlassScrollBar}" />
    </UserControl.Resources>

    <Grid Margin="38,30,38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="开发环境中心" />
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                           Text="识别本机实际生效的开发工具版本，定位冲突，并在确认后按需配置当前用户或系统环境。" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanStateText" HorizontalAlignment="Right" FontSize="12" Foreground="#58738D" Text="尚未扫描" />
                    <TextBlock x:Name="ScanDetailText" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="#8795A4" Text="进入页面后自动开始" />
                </StackPanel>
                <Button x:Name="ScanButton" Style="{StaticResource DeveloperPrimaryButtonStyle}" Content="重新扫描" Click="ScanButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="OverviewTab" GroupName="DeveloperTabs" IsChecked="True" Tag="Overview" Style="{StaticResource DeveloperTabStyle}" Content="开发环境总览" Checked="DeveloperTab_Checked" />
                <RadioButton GroupName="DeveloperTabs" Tag="Toolchains" Style="{StaticResource DeveloperTabStyle}" Content="SDK 与工具链" Checked="DeveloperTab_Checked" />
                <RadioButton GroupName="DeveloperTabs" Tag="Diagnostics" Style="{StaticResource DeveloperTabStyle}" Content="环境诊断" Checked="DeveloperTab_Checked" />
            </StackPanel>
            <Border x:Name="ProgressTrack" Width="210" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#B7DDE7F0" CornerRadius="3" Visibility="Collapsed">
                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="#4D7CFE" CornerRadius="3" />
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid x:Name="EmptyState" Panel.ZIndex="5" Background="#60F4F8FC" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" HorizontalAlignment="Center" Background="#DCEBFF" CornerRadius="18">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#3D79CE" Text="&#xE9D9;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="正在读取开发环境" />
                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="扫描可随时取消；只有明确确认后才会修改环境变量" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="OverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="22" Background="#76FFFFFF" BorderBrush="#A0FFFFFF" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#557493" Text="本机开发环境" />
                                <TextBlock Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding SummaryText}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ScannedAtText}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Border Padding="14,9" Background="#DDF6EA" CornerRadius="10"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#367A59" Text="{Binding DetectedToolCount}" /><TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#5F7C6D" Text="已识别类别" /></StackPanel></Border>
                                <Border Margin="10,0,0,0" Padding="14,9" Background="#FFF0D9" CornerRadius="10"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#A56B13" Text="{Binding WarningCount}" /><TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#826B49" Text="需关注" /></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,22,0,12" FontSize="16" FontWeight="SemiBold" Text="工具链状态" />
                    <ItemsControl ItemsSource="{Binding Toolchains}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="142" Margin="0,0,10,10" Padding="17" Background="#74FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Border Width="38" Height="38" HorizontalAlignment="Left" Background="{Binding IconBackground}" CornerRadius="10"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{Binding IconForeground}" Text="{Binding IconGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DeveloperStatusButtonStyle}"
                                                    Background="{Binding StatusBackground}" Foreground="{Binding StatusForeground}" Content="{Binding StatusText}"
                                                    IsEnabled="{Binding CanConfigureFromStatus}" CommandParameter="{Binding}" Click="ConfigureToolchain_Click" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,8">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#426B98" Text="{Binding ActiveVersion}" />
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#7E8D9D" Text="{Binding CountText}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ToolchainsView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ItemsControl ItemsSource="{Binding Toolchains}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="20" Background="#78FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="15">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" Background="{Binding IconBackground}" CornerRadius="11"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding IconForeground}" Text="{Binding IconGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Description}" /></StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" Background="{Binding StatusBackground}" CornerRadius="8"><TextBlock FontSize="11" Foreground="{Binding StatusForeground}" Text="{Binding CountText}" /></Border>
                                    </Grid>
                                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Installations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="14,12" Background="#5CF2F7FC" BorderBrush="#78D5E3EF" BorderThickness="1" CornerRadius="11" ToolTip="{Binding Evidence}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="196" /></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center"><TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Version}" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#7D8B99" Text="{Binding Architecture}" /></StackPanel>
                                                        <Border Grid.Column="1" Margin="8,0" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding StateBackground}" CornerRadius="8"><TextBlock FontSize="10" Foreground="{Binding StateForeground}" Text="{Binding StateText}" /></Border>
                                                        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="#496984" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#8492A0" Text="{Binding Source}" /></StackPanel>
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                                            <Button Width="88" Margin="0,0,8,0" Style="{StaticResource DeveloperSmallButtonStyle}" Content="配置环境" CommandParameter="{Binding}" Click="ConfigureInstallation_Click" />
                                                            <Button Width="88" Style="{StaticResource DeveloperSmallButtonStyle}" Content="打开位置" CommandParameter="{Binding}" Click="OpenInstallationLocation_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#8492A0" Text="未发现时请确认工具已安装，或其命令目录已加入 PATH；当前版本不会执行全盘扫描。">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding InstallationCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="诊断结果" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="所有建议均来自当前扫描证据；只有用户明确确认后才会修改环境变量。" /></StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DeveloperSmallButtonStyle}" Content="复制报告" Click="CopyReport_Click" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Border Padding="22" Background="#72FFFFFF" BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="14">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Issues.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#4A9A6C" Text="&#xE73E;" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" FontSize="15" FontWeight="SemiBold" Text="未发现需要关注的配置问题" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="此结论仅覆盖当前支持的工具与扫描来源" /></StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="#78FFFFFF" BorderBrush="#96FFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{Binding AccentColor}" CornerRadius="14,0,0,14" />
                                        <Grid Grid.Column="1" Margin="18,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Padding="9,5" VerticalAlignment="Top" Background="{Binding BadgeBackground}" CornerRadius="8"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding AccentColor}" Text="{Binding SeverityText}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#66788A" Text="{Binding Description}" TextWrapping="Wrap" /><Border Margin="0,9,0,0" Padding="10,8" Background="#55EAF1F7" CornerRadius="8"><TextBlock FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Foreground="#587087" Text="{Binding Evidence}" TextWrapping="Wrap" /></Border></StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="EnvironmentConfigurationOverlay" Grid.RowSpan="5" Margin="-38,-30,-38,-30" Panel.ZIndex="30" Visibility="Collapsed">
            <Border Background="#520F2235" CornerRadius="22" />
            <Border Width="600" MaxHeight="650" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F5F9FC" BorderBrush="#D7E6F2" BorderThickness="1" CornerRadius="18">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#35516A" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" />
                        <RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ConfigurationTitleText" FontSize="21" FontWeight="SemiBold" Text="配置开发环境" />
                            <TextBlock x:Name="ConfigurationSubtitleText" Margin="0,6,0,0" FontSize="11" Foreground="#718295" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Width="30" MinWidth="30" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DeveloperSmallButtonStyle}" Content="×" Click="CancelEnvironmentConfiguration_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#6683A0" Text="目标安装" />
                            <ComboBox x:Name="ConfigurationInstallationComboBox" Margin="0,6,0,0" Style="{StaticResource DeveloperGlassComboBox}"
                                      SelectionChanged="ConfigurationSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#405F7C" Text="{Binding ConfigurationDisplayText}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11" Foreground="#6683A0" Text="作用范围" />
                            <ComboBox x:Name="ConfigurationScopeComboBox" Margin="0,6,0,0" Style="{StaticResource DeveloperGlassComboBox}" SelectionChanged="ConfigurationScopeChanged">
                                <ComboBoxItem Tag="Machine" IsSelected="True">系统变量（默认，需要 UAC）</ComboBoxItem>
                                <ComboBoxItem Tag="User">当前用户</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Padding="14,11" Background="#E8F2FF" BorderBrush="#C9DFF6" BorderThickness="1" CornerRadius="10">
                        <TextBlock x:Name="ConfigurationPathText" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="#456987" TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer Grid.Row="6" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ConfigurationPlanText" FontSize="12" Foreground="#536A80" TextWrapping="Wrap" />
                            <Border x:Name="ConfigurationWarningBorder" Margin="0,12,0,0" Padding="12,10" Background="#FFF0D9" CornerRadius="9" Visibility="Collapsed">
                                <TextBlock x:Name="ConfigurationWarningText" FontSize="11" Foreground="#8A631E" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock x:Name="ConfigurationResultText" Margin="0,12,0,0" FontSize="11" Foreground="#39765A" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="8">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#7E8D9D" Text="新启动的终端和程序才会读取新环境" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="88" Margin="0,0,10,0" Style="{StaticResource DeveloperSmallButtonStyle}" Content="取消" Click="CancelEnvironmentConfiguration_Click" />
                            <Button x:Name="ApplyEnvironmentConfigurationButton" Width="116" Style="{StaticResource DeveloperPrimaryButtonStyle}" Content="加入 PATH" Click="ApplyEnvironmentConfiguration_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
