                    </ItemsControl>

                    <StackPanel x:Name="ManagedHistoricalPythonSection" Visibility="Collapsed">
                        <TextBlock Margin="0,12,0,3" FontSize="13" FontWeight="SemiBold" Foreground="#7C643D" Text="历史兼容版本" />
                        <TextBlock Margin="0,0,0,10" FontSize="10" Foreground="#8B785B" Text="这些 Python 分支已经结束官方安全维护，只建议用于无法升级的旧项目。" />
                        <ItemsControl x:Name="ManagedHistoricalPythonReleasesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="16,14" Background="#72FFF9EF" BorderBrush="#99E8D8BA" BorderThickness="1" CornerRadius="13">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="#FFF0D9" CornerRadius="11">
                                                <TextBlock FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="#B0782B" Text="Py" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <Border Margin="10,0,0,0" Padding="8,3" Background="#F2E8D7" CornerRadius="7"><TextBlock FontSize="10" Foreground="#86622C" Text="{Binding Version, Mode=OneWay}" /></Border>
                                                    <Border Margin="7,0,0,0" Padding="8,3" Background="{Binding SupportBackground}" CornerRadius="7"><TextBlock FontSize="10" Foreground="{Binding SupportForeground}" Text="{Binding SupportText, Mode=OneWay}" /></Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#756B5D"><Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Architecture, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#8A7A66" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Width="104" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding ActionText}" CommandParameter="{Binding}" Click="ManagedReleaseAction_Click">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DeveloperSmallButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Foreground" Value="#B14F4F" /><Setter Property="Background" Value="#FFF0F0" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Margin="0,14,0,10">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Volta 管理 Node.js" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="ManagedNodeStateText" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="#66809A" Text="等待读取 Node.js 目录" />
                            <Button x:Name="InstallVoltaButton" MinWidth="156" Padding="16,0" Style="{StaticResource DeveloperSmallButtonStyle}"
                                    Content="通过 WinGet 安装 Volta" Visibility="Collapsed" Click="InstallVolta_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="版本来自 Node.js 官方发行目录；“缓存版本”仅调用 volta fetch，不设置全局默认版本，也不修改 PATH。Volta 缓存由多个项目共享，因此不直接删除其内部目录。" />
                    <Border x:Name="ManagedNodeEmptyState" Padding="20" Background="#72FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#74879A" Text="未读取到当前仍受支持的 Windows x64 Node.js 版本" />
                    </Border>
                    <ItemsControl x:Name="ManagedNodeReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,14" Background="#78FFFFFF" BorderBrush="#99D5E3EF" BorderThickness="1" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#E2F7E9" CornerRadius="11">
                                            <TextBlock FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#3C9361" Text="JS" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border Margin="10,0,0,0" Padding="8,3" Background="#DDF6EA" CornerRadius="7">
                                                    <TextBlock FontSize="10" Foreground="#367A59" Text="{Binding VersionText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#687D91">
                                                <Run Text="Node.js 官方发行版" /><Run Text="  ·  " /><Run Text="Volta 缓存" /><Run Text="  ·  " /><Run Text="{Binding Architecture, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#74899D" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="104" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Content="{Binding ActionText}" CommandParameter="{Binding}" Click="ManagedReleaseAction_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DeveloperSmallButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanExecuteAction}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReadOnlyInstalled}" Value="True"><Setter Property="Foreground" Value="#54788E" /><Setter Property="Background" Value="#E9F2F7" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,14,0,10">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Docker" />
                        <TextBlock x:Name="ManagedDockerStateText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#66809A" Text="等待读取官方目录" />
                    </Grid>
                    <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="Docker Desktop 安装器来自官方更新源，下载后校验数字签名并启动安装向导（需要管理员权限与 WSL2）；docker CLI 静态包可解压到 X-Tool 托管目录，但只提供命令行客户端，容器引擎仍需 Docker Desktop 或远程 DOCKER_HOST。" />
                    <TextBlock Margin="0,2,0,10" FontSize="13" FontWeight="SemiBold" Foreground="#526E87" Text="Docker Desktop 安装器" />
                    <Border x:Name="ManagedDesktopEmptyState" Padding="20" Background="#72FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#74879A" Text="点击“刷新版本”读取 Docker Desktop 官方目录" />
                    </Border>
                    <ItemsControl x:Name="ManagedDesktopReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,14" Background="#78FFFFFF" BorderBrush="#99D5E3EF" BorderThickness="1" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#E5F1FF" CornerRadius="11">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#2F6FB3" Text="&#xE9A3;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border Margin="10,0,0,0" Padding="8,3" Background="#DDEEFF" CornerRadius="7">
                                                    <TextBlock FontSize="10" Foreground="#36709A" Text="{Binding Version}" />
                                                </Border>
                                                <Border Margin="7,0,0,0" Padding="8,3" Background="{Binding SupportBackground}" CornerRadius="7">
                                                    <TextBlock FontSize="10" Foreground="{Binding SupportForeground}" Text="{Binding SupportText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#687D91">
                                                    <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Architecture, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#74899D" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="112" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Content="{Binding ActionText}" CommandParameter="{Binding}" Click="ManagedReleaseAction_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DeveloperSmallButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanExecuteAction}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReadOnlyInstalled}" Value="True"><Setter Property="Foreground" Value="#54788E" /><Setter Property="Background" Value="#E9F2F7" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,12,0,10" FontSize="13" FontWeight="SemiBold" Foreground="#526E87" Text="docker CLI 静态包" />
                    <Border x:Name="ManagedDockerCliEmptyState" Padding="20" Background="#72FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#74879A" Text="Docker 官方静态包目录未返回可用版本" />
                    </Border>
                    <ItemsControl x:Name="ManagedDockerCliReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,14" Background="#78FFFFFF" BorderBrush="#99D5E3EF" BorderThickness="1" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#E5F1FF" CornerRadius="11">
                                            <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="#2F6FB3" Text="docker" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border Margin="10,0,0,0" Padding="8,3" Background="#DDEEFF" CornerRadius="7">
                                                    <TextBlock FontSize="10" Foreground="#36709A" Text="{Binding Version}" />
                                                </Border>
                                                <Border Margin="7,0,0,0" Padding="8,3" Background="{Binding SupportBackground}" CornerRadius="7">
                                                    <TextBlock FontSize="10" Foreground="{Binding SupportForeground}" Text="{Binding SupportText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#687D91">
                                                    <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Architecture, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#74899D" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="112" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Content="{Binding ActionText}" CommandParameter="{Binding}" Click="ManagedReleaseAction_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DeveloperSmallButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Foreground" Value="#B14F4F" /><Setter Property="Background" Value="#FFF0F0" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,10,0,0" Padding="18" Background="#66E8F2FF" BorderBrush="#88CFE0F3" BorderThickness="1" CornerRadius="13">
                        <TextBlock FontSize="11" Foreground="#647B91" TextWrapping="Wrap"
                                Text="当前托管页不会改变 Java、Python、Node.js 或 MySQL 的全局默认版本。默认版本、项目绑定和专用终端将在后续增量统一处理。" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="诊断结果" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="所有建议均来自当前扫描证据；只有用户明确确认后才会修改环境变量。" /></StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DeveloperSmallButtonStyle}" Content="复制报告" Click="CopyReport_Click" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Border Padding="22" Background="#72FFFFFF" BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="14">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Issues.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#4A9A6C" Text="&#xE73E;" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" FontSize="15" FontWeight="SemiBold" Text="未发现需要关注的配置问题" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="此结论仅覆盖当前支持的工具与扫描来源" /></StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="#78FFFFFF" BorderBrush="#96FFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{Binding AccentColor}" CornerRadius="14,0,0,14" />
                                        <Grid Grid.Column="1" Margin="18,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Padding="9,5" VerticalAlignment="Top" Background="{Binding BadgeBackground}" CornerRadius="8"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding AccentColor}" Text="{Binding SeverityText}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#66788A" Text="{Binding Description}" TextWrapping="Wrap" />
                                                <Border Margin="0,9,0,0" Padding="11,9" Background="#55EAF1F7" CornerRadius="8">
                                                    <TextBlock FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" LineHeight="17"
                                                               Foreground="#587087" Text="{Binding Evidence}" TextWrapping="Wrap"
                                                               TextOptions.TextFormattingMode="Display" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="EnvironmentConfigurationOverlay" Grid.RowSpan="5" Margin="-38,-30,-38,-30" Panel.ZIndex="30" Visibility="Collapsed">
            <Border Background="#520F2235" CornerRadius="22" />
            <Border Width="600" MaxHeight="650" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F5F9FC" BorderBrush="#D7E6F2" BorderThickness="1" CornerRadius="18">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#35516A" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" />
                        <RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ConfigurationTitleText" FontSize="21" FontWeight="SemiBold" Text="配置开发环境" />
                            <TextBlock x:Name="ConfigurationSubtitleText" Margin="0,6,0,0" FontSize="11" Foreground="#718295" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Width="30" MinWidth="30" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DeveloperSmallButtonStyle}" Content="×" Click="CancelEnvironmentConfiguration_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#6683A0" Text="目标安装" />
                            <ComboBox x:Name="ConfigurationInstallationComboBox" Margin="0,6,0,0" Style="{StaticResource DeveloperGlassComboBox}"
                                      SelectionChanged="ConfigurationSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#405F7C" Text="{Binding ConfigurationDisplayText}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11" Foreground="#6683A0" Text="作用范围" />
                            <ComboBox x:Name="ConfigurationScopeComboBox" Margin="0,6,0,0" Style="{StaticResource DeveloperGlassComboBox}" SelectionChanged="ConfigurationScopeChanged">
                                <ComboBoxItem Tag="Machine" IsSelected="True">系统变量（默认，需要 UAC）</ComboBoxItem>
                                <ComboBoxItem Tag="User">当前用户</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Padding="14,11" Background="#E8F2FF" BorderBrush="#C9DFF6" BorderThickness="1" CornerRadius="10">
                        <TextBlock x:Name="ConfigurationPathText" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="#456987" TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer Grid.Row="6" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ConfigurationPlanText" FontSize="12" Foreground="#536A80" TextWrapping="Wrap" />
                            <Border x:Name="ConfigurationWarningBorder" Margin="0,12,0,0" Padding="12,10" Background="#FFF0D9" CornerRadius="9" Visibility="Collapsed">
                                <TextBlock x:Name="ConfigurationWarningText" FontSize="11" Foreground="#8A631E" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock x:Name="ConfigurationResultText" Margin="0,12,0,0" FontSize="11" Foreground="#39765A" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="8">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#7E8D9D" Text="新启动的终端和程序才会读取新环境" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="88" Margin="0,0,10,0" Style="{StaticResource DeveloperSmallButtonStyle}" Content="取消" Click="CancelEnvironmentConfiguration_Click" />
                            <Button x:Name="ApplyEnvironmentConfigurationButton" Width="116" Style="{StaticResource DeveloperPrimaryButtonStyle}" Content="加入 PATH" Click="ApplyEnvironmentConfiguration_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
