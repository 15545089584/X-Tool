                    <TextBlock Margin="0,2,0,10" FontSize="13" FontWeight="SemiBold" Foreground="#526E87" Text="推荐版本" />
                    <ItemsControl x:Name="ManagedPythonReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,14" Background="#78FFFFFF" BorderBrush="#99D5E3EF" BorderThickness="1" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#E8F2FF" CornerRadius="11">
                                            <TextBlock FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="#4385D1" Text="Py" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
