<Window x:Class="ScreenshotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="X-Tool"
        Icon="Assets/XTool.ico"
        Width="1480" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">

    <!-- 保留自绘标题栏，同时让 HWND 拥有标准 Windows 非客户区能力，
         以恢复任务栏最小化与还原时的系统过渡动画。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 历史分类使用半透明圆角胶囊，融入主界面的毛玻璃层次。 -->
        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#8FFFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#56606C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#486177" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C9E0F8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置项统一使用轻玻璃开关，替代系统原生复选框的硬边框。 -->
        <Style x:Key="SettingToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Padding="3" Background="#82DCE4EE" BorderBrush="#9FC6D4E3" BorderThickness="1" CornerRadius="14">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" Fill="#F8FCFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.18" Color="#36506A" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#5E82C8FF" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#9C58A8FF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#68FFFFFF" />
            <Setter Property="BorderBrush" Value="#86FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#486177" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorageLocationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#43617E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="#74FFFFFF" BorderBrush="#A8D5E6F5" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BFE5F2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6EAFF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 转换器页面使用更明确的操作层级，不与屏幕工作台复用能力卡布局。 -->
        <Style x:Key="ConverterActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#75A0FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#3867C5" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConverterSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ConverterActionButtonStyle}">
            <Setter Property="Background" Value="#8CFFFFFF" />
            <Setter Property="BorderBrush" Value="#A8D8E8F7" />
            <Setter Property="Foreground" Value="#45637E" />
        </Style>

        <Style x:Key="StorageHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24D6EAFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#46C8E4FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 存储位置使用可展开的玻璃容器，平时保持设置页简洁。 -->
        <Style x:Key="StorageExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="#5EFFFFFF" BorderBrush="#7AFFFFFF" BorderThickness="1" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#486177" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" Padding="16,0" Height="64" Background="Transparent" BorderThickness="0" Style="{StaticResource StorageHeaderToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Header" />
                                        <TextBlock x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#64758A" Text="&#xE70D;" />
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="16,0,16,16" ContentSource="Content" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootVisual" Background="{StaticResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 在旧版 Windows 或关闭透明效果时，为界面保留柔和的玻璃景深。 -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-210,-290,0,0" Fill="#5C7BB8FF">
                <Ellipse.Effect>
                    <BlurEffect Radius="72" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-150,-250" Fill="#58A5F2DB">
                <Ellipse.Effect>
                    <BlurEffect Radius="78" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-190,0,0" Fill="#42FFFFFF">
                <Ellipse.Effect>
                    <BlurEffect Radius="64" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0">
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#8B9098" Text="X-Tool · 桌面工具箱" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,10,6">
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" Content="&#x2014;" />
                <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" Content="&#x25A1;" />
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_Click" Content="&#x00D7;">
                    <Button.Resources>
                        <Style TargetType="Border" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧主导航 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Left"
                            Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16"
                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#53708D" />
                        </Border.Effect>
                        <Grid>
                            <Border Width="38" Height="38" Background="#E8F1FF" CornerRadius="12" />
                            <TextBlock Style="{StaticResource IconTextStyle}" FontSize="25" Text="&#xE90F;" Foreground="#317CF5" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="2,12,0,0" FontSize="20" FontWeight="SemiBold" Text="X-Tool" />
                    <TextBlock Margin="2,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="桌面效率工具箱" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Margin="0,18,12,0" Background="{StaticResource GlassDividerBrush}" />

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Tag="Home" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE80F;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="首页" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScreenWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="ScreenWorkbench" Checked="NavButton_Checked" Click="NavigateToWorkbench_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE7F4;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="屏幕工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ConverterWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="ConverterWorkbench" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE8C8;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="转换器工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="Shortcuts" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE765;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="快捷键" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="3" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                             Tag="Settings" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                            <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE713;" Foreground="#626971" />
                        </Border>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="设置" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- 右侧毛玻璃工作区 -->
            <Border Grid.Column="1" Background="{StaticResource GlassSurfaceBrush}" CornerRadius="18"
                    BorderBrush="Transparent" BorderThickness="0">
                <Border.Effect>
                    <StaticResource ResourceKey="GlassShadowEffect" />
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <!-- 主内容区 -->
                    <Grid Background="Transparent">
                        <Grid>
                            <!-- X-Tool 工具箱首页 -->
                            <Grid x:Name="HomeView" Margin="52,48,52,38">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="206" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="166" />
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" HorizontalAlignment="Center"
                                            Background="#EEF5FF" CornerRadius="22" BorderBrush="#D5E6FF" BorderThickness="1">
                                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="30" Text="&#xE90F;" Foreground="#2D7DFF" />
                                    </Border>
                                    <TextBlock Margin="0,22,0,0" HorizontalAlignment="Center"
                                               FontSize="31" FontWeight="SemiBold" Text="一个工具箱，轻松完成更多事" />
                                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                               FontSize="15" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="X-Tool 将桌面常用能力整理成轻快、专注的工作台" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource ActionCardStyle}" Click="NavigateToWorkbench_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Width="34" Height="34" HorizontalAlignment="Left" Background="#E6F0FF" CornerRadius="8">
                                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Foreground="#2D7DFF" Text="&#xE7F4;" />
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="屏幕工作台" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="截图、长截图、提取、翻译与录像" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource ActionCardStyle}" Click="NavigateToConverterWorkbench_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Width="34" Height="34" HorizontalAlignment="Left" Background="#FFF2D9" CornerRadius="8">
                                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Foreground="#E6A326" Text="&#xE8A7;" />
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="转换器工作台" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="处理图片、文本与文件格式" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="4" Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="#5AFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#536C86" />
                                    </Border.Effect>
                                    <Grid Margin="24,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="最近使用" />
                                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="#6F7680" Content="打开剪贴板  →" Click="ShowHistory_Click" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#A5ABB3" Text="&#xE91B;" />
                                            <TextBlock Margin="10,0,0,0" FontSize="13" Foreground="#999FA8"
                                                       Text="完成一次屏幕工具操作后，会显示在这里" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 屏幕工具的专属工作台；剪贴板仅作为这里的子入口。 -->
                            <Grid x:Name="ScreenWorkbenchView" Visibility="Collapsed" Margin="52,46,52,38">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="屏幕工作台" />
                                    <TextBlock Margin="0,9,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="集中完成截图、长截图、文字提取、翻译和屏幕录制" />
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ActionCardStyle}" Tag="截图" Click="CaptureAction_Click">
                                        <StackPanel>
                                            <Border Width="36" Height="36" HorizontalAlignment="Left" Background="#E6F0FF" CornerRadius="10"><TextBlock Style="{StaticResource IconTextStyle}" FontSize="18" Foreground="#2D7DFF" Text="&#xE722;" /></Border>
                                            <TextBlock Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" Text="开始截图" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Ctrl + Shift + A" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ActionCardStyle}" Tag="长截图" Click="CaptureAction_Click">
                                        <StackPanel>
                                            <Border Width="36" Height="36" HorizontalAlignment="Left" Background="#EAF6E9" CornerRadius="10"><TextBlock Style="{StaticResource IconTextStyle}" FontSize="18" Foreground="#42A26A" Text="&#xE70D;" /></Border>
                                            <TextBlock Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" Text="长截图" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="框选后手动滚动采集" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource ActionCardStyle}" Click="ShowHistory_Click">
                                        <StackPanel>
                                            <Border Width="36" Height="36" HorizontalAlignment="Left" Background="#FFF2D9" CornerRadius="10"><TextBlock Style="{StaticResource IconTextStyle}" FontSize="18" Foreground="#D89623" Text="&#xE81C;" /></Border>
                                            <TextBlock Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" Text="剪贴板" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="查看和管理已完成的内容" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="4" Background="{StaticResource GlassCardBrush}" BorderBrush="#5AFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Grid Margin="26,22">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="当前能力" />
                                        <primitives:UniformGrid Grid.Row="2" Rows="3" Columns="3">
