<Window x:Class="ScreenshotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:ScreenshotApp.Converters"
        xmlns:collaboration="clr-namespace:ScreenshotApp.Collaboration"
        xmlns:fileWorkbench="clr-namespace:ScreenshotApp.FileWorkbench"
        xmlns:systemTools="clr-namespace:ScreenshotApp.SystemTools"
        xmlns:networkWorkbench="clr-namespace:ScreenshotApp.NetworkWorkbench"
        xmlns:developerTools="clr-namespace:ScreenshotApp.DeveloperTools"
        mc:Ignorable="d"
        Title="X-Tool"
        Icon="Assets/XTool.png"
        Width="1480" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">

    <!-- 保留自绘标题栏，同时让 HWND 拥有标准 Windows 非客户区能力，
         以恢复任务栏最小化与还原时的系统过渡动画。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 历史分类使用半透明圆角胶囊，融入主界面的毛玻璃层次。 -->
        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#8FFFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#56606C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#486177" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C9E0F8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置项统一使用轻玻璃开关，替代系统原生复选框的硬边框。 -->
        <Style x:Key="SettingToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Padding="3" Background="#82DCE4EE" BorderBrush="#9FC6D4E3" BorderThickness="1" CornerRadius="14">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" Fill="#F8FCFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.18" Color="#36506A" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#5E82C8FF" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#9C58A8FF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#68FFFFFF" />
            <Setter Property="BorderBrush" Value="#86FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#486177" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorageLocationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#43617E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="#74FFFFFF" BorderBrush="#A8D5E6F5" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BFE5F2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6EAFF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷键值使用紧凑的半透明圆角玻璃按钮，保持可点击语义。 -->
        <Style x:Key="ShortcutValueButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#3F5F7E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="#7EFFFFFF" BorderBrush="#A9D4EAF8" BorderThickness="1" CornerRadius="12">
                            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#466785" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C7EAF5FF" /><Setter TargetName="Root" Property="BorderBrush" Value="#6FAEF5" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#548FFF" /><Setter TargetName="Root" Property="BorderThickness" Value="1.5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.74" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 转换器页面使用更明确的操作层级，不与屏幕工作台复用能力卡布局。 -->
        <Style x:Key="ConverterActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#75A0FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#3867C5" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConverterSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ConverterActionButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#8CFFFFFF" />
            <Setter Property="BorderBrush" Value="#A8D8E8F7" />
            <Setter Property="Foreground" Value="#45637E" />
        </Style>

        <Style x:Key="ConverterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#BFFFFFFF" />
            <Setter Property="BorderBrush" Value="#ABCBE7F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#405D78" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="13,10" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#405D78" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CEE0FF" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="#ABCBE7F8" BorderThickness="1" CornerRadius="11"><Grid><ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><TextBlock HorizontalAlignment="Right" Margin="0,0,13,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#6082A7" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF3FF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F4FBFFFF" BorderBrush="#B5D1E9FA" BorderThickness="1" CornerRadius="11"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="190" CanContentScroll="True"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ConverterSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="#4D7CFE" />
            <Setter Property="Background" Value="#D9E5EFF8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Border Height="6" VerticalAlignment="Center" Background="#D9E5EFF8" BorderBrush="#B8D2E6F4" BorderThickness="1" CornerRadius="3" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton><RepeatButton IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F7FCFFFF" BorderBrush="#77A7D6FF" BorderThickness="2" CornerRadius="9"><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#416D9B" /></Border.Effect></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorageHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24D6EAFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#46C8E4FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 存储位置使用可展开的玻璃容器，平时保持设置页简洁。 -->
        <Style x:Key="StorageExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="#5EFFFFFF" BorderBrush="#7AFFFFFF" BorderThickness="1" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#486177" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" Padding="16,0" Height="64" Background="Transparent" BorderThickness="0" Style="{StaticResource StorageHeaderToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Header" />
                                        <TextBlock x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#64758A" Text="&#xE70D;" />
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="16,0,16,16" ContentSource="Content" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootVisual" Background="{StaticResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 在旧版 Windows 或关闭透明效果时，为界面保留柔和的玻璃景深。 -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-210,-290,0,0" Fill="#5C7BB8FF">
                <Ellipse.Effect>
                    <BlurEffect Radius="72" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-150,-250" Fill="#58A5F2DB">
                <Ellipse.Effect>
                    <BlurEffect Radius="78" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-190,0,0" Fill="#42FFFFFF">
                <Ellipse.Effect>
                    <BlurEffect Radius="64" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0">
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#8B9098" Text="X-Tool · 桌面工具箱" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,10,6">
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" Content="&#x2014;" />
                <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" Content="&#x25A1;" />
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_Click" Content="&#x00D7;">
                    <Button.Resources>
                        <Style TargetType="Border" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧主导航 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Grid Width="72" Height="72" HorizontalAlignment="Left" Margin="-3,0,0,0">
                        <Image Width="68" Height="68" Stretch="Uniform" SnapsToDevicePixels="True"
                               AutomationProperties.Name="X-Tool"
                               Source="/Assets/XToolMark.png" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="X-Tool" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="桌面效率工具箱" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Margin="0,18,12,0" Background="{StaticResource GlassDividerBrush}" />

                <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Tag="Home" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE80F;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="首页" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScreenWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="ScreenWorkbench" Checked="NavButton_Checked" Click="NavigateToWorkbench_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE7F4;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="屏幕工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ConverterWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="ConverterWorkbench" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE8C8;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="转换器工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FileWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="FileWorkbench" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE8B7;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="文件工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NetworkWorkbenchNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="NetworkWorkbench" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE774;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="网络工作台" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ResourceManagementNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="ResourceManagement" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE9D2;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="资源管理" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SystemToolsNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="SystemTools" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE950;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="系统工具" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DeveloperToolsNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="DeveloperTools" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE943;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="开发者工具" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CollaborationNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="Collaboration" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE753;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="协作中心" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <RadioButton x:Name="SettingsNav" Grid.Row="3" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                             Tag="Settings" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                            <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE713;" Foreground="#626971" />
                        </Border>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="设置" />
