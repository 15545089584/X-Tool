                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#6085B8" Text="&#xE8A5;" />
                                                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding KindText}" />
                                                                                <TextBlock Width="178" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="#738092" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding PreviewText}" />
