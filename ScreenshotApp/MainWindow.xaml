                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15" Text="网络流量自动获取" />
                                                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="一次授权后注册独立 ETW 辅助任务；主程序仍保持普通权限" TextWrapping="Wrap" />
                                                <TextBlock x:Name="NetworkEtwAuthorizationStatusText" Margin="0,4,0,0" FontSize="10" Foreground="#5E819F" Text="尚未授权网络流量自动获取" />
                                            </StackPanel>
                                            <Button x:Name="NetworkEtwAuthorizationButton" Width="152" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StorageLocationButtonStyle}" Content="授权并自动获取" Click="NetworkEtwAuthorizationButton_Click" />
                                        </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingCardStyle}">
                                        <Grid Height="84" Margin="20,0">
                                            <StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" Text="本地语音输入" /><TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="默认右 Alt 唤起；使用原始输入的全屏程序建议改用组合键" /><TextBlock x:Name="VoiceInputModelStatusText" Margin="0,4,0,0" FontSize="10" Foreground="#5E819F" /></StackPanel>
                                            <CheckBox x:Name="VoiceInputEnabledCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingToggleStyle}" Click="VoiceInputEnabledCheckBox_Click" />
                                        </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingCardStyle}">
                                        <Grid Height="76" Margin="20,0">
                                            <StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" Text="识别后自动粘贴" /><TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="关闭后仅复制识别结果到系统剪贴板" /></StackPanel>
                                            <CheckBox x:Name="VoiceInputPasteAutomaticallyCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingToggleStyle}" Click="VoiceInputPasteAutomaticallyCheckBox_Click" />
                                        </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingCardStyle}">
                                        <Grid Height="76" Margin="20,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15" Text="保存截图历史" />
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" Style="{StaticResource SettingToggleStyle}" />
                                        </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingCardStyle}">
                                        <Grid Height="76" Margin="20,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15" Text="贴图默认置顶" />
                                                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="创建贴图后始终显示在其他窗口上方" />
                                            </StackPanel>
                                            <CheckBox x:Name="StickerTopmostCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Style="{StaticResource SettingToggleStyle}" Click="StickerTopmostCheckBox_Click" />
                                        </Grid>
                                        </Border>
                                        <Border Cursor="Hand" MouseLeftButtonDown="OpenShortcutSettings_Click">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#AAFFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#B9E4F3FF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Height="76" Margin="20,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="15" Text="快捷键" />
                                                    <TextBlock x:Name="SettingsShortcutSummaryText" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" Foreground="#8AA0B4" Text="›" />
                                            </Grid>
                                        </Border>
                                        <Expander Margin="0" Style="{StaticResource StorageExpanderStyle}">
                                            <Expander.Header>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="15" Text="存储位置" />
                                                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="分别设置各类剪贴板内容的保存目录" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Grid Height="46" Margin="2,5,2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="截图" />
                                                    <TextBlock x:Name="ScreenshotStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="截图" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="长截图" />
                                                    <TextBlock x:Name="LongScreenshotStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="长截图" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="文字提取" />
                                                    <TextBlock x:Name="TextExtractionStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="文字提取" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="翻译" />
                                                    <TextBlock x:Name="TranslationStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="翻译" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="屏幕录制" />
                                                    <TextBlock x:Name="RecordingStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="屏幕录制" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0,2,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="外部复制" />
                                                    <TextBlock x:Name="ClipboardStoragePathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="外部复制" Click="StorageLocationButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                        <Expander x:Name="CollaborationSettingsExpander" Margin="0,12,0,0" Style="{StaticResource StorageExpanderStyle}">
                                            <Expander.Header>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="15" Text="协作中心" />
                                                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="设置手机互传剪贴板与文件时使用的目录" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Grid Height="46" Margin="2,5,2,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="手机接收" />
                                                    <TextBlock x:Name="CollaborationIncomingPathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="协作接收" Click="StorageLocationButton_Click" />
                                                </Grid>
                                                <Border Height="1" Background="#55FFFFFF" />
                                                <Grid Height="46" Margin="2,0,2,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" Text="电脑发送" />
                                                    <TextBlock x:Name="CollaborationOutgoingPathText" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" Foreground="#708095" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Height="30" Style="{StaticResource StorageLocationButtonStyle}" Content="选择文件夹" Tag="协作发送" Click="StorageLocationButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- 轻量状态提示 -->
                            <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,22" Padding="18,11" Background="#D9222933"
                                    BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#7FB0FF" Text="&#xE73E;" />
                                    <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="13" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
