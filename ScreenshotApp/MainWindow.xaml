                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="36" Height="36" Margin="0,0,12,0" Style="{StaticResource ConverterSecondaryButtonStyle}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="BackToConverterWorkbench_Click" />
                                        <StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="图片处理" /><TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="批量转换图片格式、压缩质量与像素尺寸" /></StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Background="#80E9F3FF" BorderBrush="#B8D2EFFF" BorderThickness="1" CornerRadius="10"><TextBlock FontSize="12" Foreground="#4D6E91" Text="原始文件保持不变" /></Border>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border Padding="22" Background="#72FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="16">
                                                <StackPanel>
                                                    <Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="1. 添加图片" /><Button HorizontalAlignment="Right" Style="{StaticResource ConverterSecondaryButtonStyle}" Content="选择文件" Click="SelectImageFiles_Click" /></Grid>
                                                    <TextBlock x:Name="ImageFilesSummaryText" Margin="0,9,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="支持 PNG、JPEG、BMP、TIFF，可一次选择多张" />
                                                    <Border Margin="0,16,0,0" MinHeight="164" Padding="12" Background="#42EEF5FF" BorderBrush="#86C7DFF3" BorderThickness="1" CornerRadius="12">
                                                        <ListBox x:Name="ImageFileList" Background="Transparent" BorderThickness="0" IsHitTestVisible="False" FontSize="12" Foreground="#4B6680" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,14,0,0" Padding="22" Background="#72FFFFFF" BorderBrush="#92FFFFFF" BorderThickness="1" CornerRadius="16">
                                                <StackPanel>
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="2. 输出位置" />
                                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Padding="12,10" Background="#56EAF1F8" BorderBrush="#8ACCE0EF" BorderThickness="1" CornerRadius="9"><TextBlock x:Name="ConverterOutputFolderText" TextTrimming="CharacterEllipsis" Foreground="#52708C" /></Border><Button Grid.Column="2" Style="{StaticResource ConverterSecondaryButtonStyle}" Content="选择文件夹" Click="SelectConverterOutputFolder_Click" /></Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="22" Background="#78F4F7FF" BorderBrush="#9ACEDCFA" BorderThickness="1" CornerRadius="16">
                                            <StackPanel>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="3. 处理参数" />
                                                <TextBlock Margin="0,15,0,6" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="输出格式" />
                                                <ComboBox x:Name="ImageFormatComboBox" Height="38" SelectedIndex="0" SelectionChanged="ImageFormatComboBox_SelectionChanged"><ComboBoxItem Tag="Png">PNG · 无损</ComboBoxItem><ComboBoxItem Tag="Jpeg">JPEG · 体积更小</ComboBoxItem><ComboBoxItem Tag="Bmp">BMP · 位图</ComboBoxItem><ComboBoxItem Tag="Tiff">TIFF · 高保真</ComboBoxItem></ComboBox>
                                                <Grid Margin="0,18,0,0"><TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="JPEG 质量" /><TextBlock x:Name="ImageQualityValueText" HorizontalAlignment="Right" FontSize="12" Foreground="#507AB3" /></Grid>
                                                <Slider x:Name="ImageQualitySlider" Minimum="20" Maximum="100" Value="88" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="ImageQualitySlider_ValueChanged" />
                                                <Grid Margin="0,14,0,0"><TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="输出尺寸" /><TextBlock x:Name="ImageScaleValueText" HorizontalAlignment="Right" FontSize="12" Foreground="#507AB3" /></Grid>
                                                <Slider x:Name="ImageScaleSlider" Minimum="10" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="ImageScaleSlider_ValueChanged" />
                                                <TextBlock Margin="0,22,0,0" FontSize="11" LineHeight="18" Foreground="#72869B" Text="JPEG 会以白色填充透明区域；其他格式保留透明通道。" TextWrapping="Wrap" />
                                                <Button x:Name="StartImageConversionButton" Margin="0,20,0,0" Style="{StaticResource ConverterActionButtonStyle}" Content="开始处理" Click="StartImageConversion_Click" />
                                                <TextBlock x:Name="ImageConversionStatusText" Margin="0,12,0,0" FontSize="12" Foreground="#5C7894" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
