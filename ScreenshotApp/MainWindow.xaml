                                                                <ContentPresenter Margin="22" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#6E9CFC" /></Trigger>
                                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.76" /></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Width="54" Height="54" VerticalAlignment="Center" Background="#D8E7FF" CornerRadius="16"><TextBlock Style="{StaticResource IconTextStyle}" FontSize="27" Foreground="#4D7CFE" Text="&#xEB9F;" /></Border>
                                                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#284976" Text="图片处理" />
                                                            <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="#5D7593" Text="格式转换、压缩与缩放" />
                                                            <TextBlock Margin="0,11,0,0" FontSize="11" Foreground="#7590AE" Text="PNG · JPEG · BMP · TIFF" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#4D7CFE" Text="&#xE76C;" />
                                                    </Grid>
                                                </Button>
                                                <Grid Grid.Row="2">
                                                    <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="12" /><RowDefinition Height="112" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Padding="16" Background="#44FFFFFF" BorderBrush="#76D8E2EF" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#8C70C9" Text="&#xE8A5;" /><TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Text="文本与数据" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="编码、结构化数据" /></StackPanel></Border>
                                                    <Border Grid.Column="2" Padding="16" Background="#44FFFFFF" BorderBrush="#76D8E2EF" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#D48A4B" Text="&#xE8A7;" /><TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Text="文档与 PDF" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="后续接入专用组件" /></StackPanel></Border>
                                                    <Border Grid.Row="2" Padding="16" Background="#44FFFFFF" BorderBrush="#76D8E2EF" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#54A878" Text="&#xE714;" /><TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Text="音视频" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="后续接入转码引擎" /></StackPanel></Border>
                                                    <Border Grid.Row="2" Grid.Column="2" Padding="16" Background="#32FFFFFF" BorderBrush="#52C8D4E1" BorderThickness="1" CornerRadius="14"><StackPanel VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#97A6B6" Text="&#xE710;" /><TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="#7D8B9A" Text="预留新工具" /></StackPanel></Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 图片处理专用页：参数区与文件队列分离，便于后续扩展预设、进度与批处理。 -->
                            <Grid x:Name="ImageConverterView" Visibility="Collapsed" Margin="52,36,52,34">
