<Window x:Class="ScreenshotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="截影"
        Icon="Assets/JieYing.ico"
        Width="1480" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">

    <!-- 保留自绘标题栏，同时让 HWND 拥有标准 Windows 非客户区能力，
         以恢复任务栏最小化与还原时的系统过渡动画。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 历史分类使用半透明圆角胶囊，融入主界面的毛玻璃层次。 -->
        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#8FFFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#56606C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#486177" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C9E0F8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootVisual" Background="{StaticResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 在旧版 Windows 或关闭透明效果时，为界面保留柔和的玻璃景深。 -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-210,-290,0,0" Fill="#5C7BB8FF">
                <Ellipse.Effect>
                    <BlurEffect Radius="72" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-150,-250" Fill="#58A5F2DB">
                <Ellipse.Effect>
                    <BlurEffect Radius="78" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-190,0,0" Fill="#42FFFFFF">
                <Ellipse.Effect>
                    <BlurEffect Radius="64" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0">
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#8B9098" Text="截影 · Screenshot" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,10,6">
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" Content="&#x2014;" />
                <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" Content="&#x25A1;" />
                <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_Click" Content="&#x00D7;">
                    <Button.Resources>
                        <Style TargetType="Border" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧主导航 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Left"
                            Background="{StaticResource GlassSurfaceBrush}" CornerRadius="16"
                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#53708D" />
                        </Border.Effect>
                        <Grid>
                            <Border Width="38" Height="38" Background="#E8F1FF" CornerRadius="12" />
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE722;" Foreground="#317CF5" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="2,12,0,0" FontSize="20" FontWeight="SemiBold" Text="截影" />
                    <TextBlock Margin="2,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="轻快截图工具" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Margin="0,18,12,0" Background="{StaticResource GlassDividerBrush}" />

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <!-- 截图是全局动作，直接放在一级导航，避免再维护一层固定的二级栏。 -->
                    <Button Height="48" Margin="0,0,12,10" Style="{StaticResource PrimaryButtonStyle}"
                            Tag="截图" Click="CaptureAction_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Background="#CFE4FF" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="16" Foreground="#2D7DFF" Text="&#xE722;" />
                            </Border>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="截图" />
                        </StackPanel>
                    </Button>
                    <RadioButton x:Name="HomeNav" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Tag="Home" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE80F;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="首页" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="History" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE81C;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="历史记录" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                                 Tag="Shortcuts" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE765;" Foreground="#626971" />
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="快捷键" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="3" GroupName="Navigation" Style="{StaticResource NavItemStyle}"
                             Tag="Settings" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="#F7F8FA" CornerRadius="9">
                            <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Text="&#xE713;" Foreground="#626971" />
                        </Border>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Text="设置" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- 右侧毛玻璃工作区 -->
            <Border Grid.Column="1" Background="{StaticResource GlassSurfaceBrush}" CornerRadius="18"
                    BorderBrush="Transparent" BorderThickness="0">
                <Border.Effect>
                    <StaticResource ResourceKey="GlassShadowEffect" />
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <!-- 主内容区 -->
                    <Grid Background="Transparent">
                        <Grid>
                            <!-- 首页 -->
                            <Grid x:Name="HomeView" Margin="52,48,52,38">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="220" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="166" />
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" HorizontalAlignment="Center"
                                            Background="#EEF5FF" CornerRadius="22" BorderBrush="#D5E6FF" BorderThickness="1">
                                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="31" Text="&#xE722;" Foreground="#2D7DFF" />
                                    </Border>
                                    <TextBlock Margin="0,22,0,0" HorizontalAlignment="Center"
                                               FontSize="31" FontWeight="SemiBold" Text="随手一截，马上可用" />
                                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                               FontSize="15" Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="框选后可复制、标注、提取文字、翻译或切换为滚动长截图" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource ActionCardStyle}" Tag="截图" Click="CaptureAction_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Width="34" Height="34" HorizontalAlignment="Left" Background="#E6F0FF" CornerRadius="8">
                                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Foreground="#2D7DFF" Text="&#xE722;" />
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="截图" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Ctrl + Shift + A" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource ActionCardStyle}" Tag="窗口截图" Click="CaptureAction_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Width="34" Height="34" HorizontalAlignment="Left" Background="#FFF2D9" CornerRadius="8">
                                                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="17" Foreground="#E6A326" Text="&#xE8A7;" />
                                            </Border>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="窗口截图" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Alt + Shift + A" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="4" Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="#5AFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#536C86" />
                                    </Border.Effect>
                                    <Grid Margin="24,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="最近记录" />
                                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="#6F7680" Content="查看全部  →" Click="ShowHistory_Click" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#A5ABB3" Text="&#xE91B;" />
                                            <TextBlock Margin="10,0,0,0" FontSize="13" Foreground="#999FA8"
                                                       Text="完成第一次截图后，会显示在这里" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 统一历史记录页 -->
                            <Grid x:Name="HistoryView" Visibility="Collapsed" Margin="58,32,48,38">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="历史记录" />
                                        <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="普通截图、长截图、文字提取、翻译与屏幕录制均在本机分类保存" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="16,9" Background="#AFFFFFFF"
                                            BorderBrush="#CFFFFFFF" BorderThickness="1"
                                            Cursor="Hand" Content="打开存储位置" Click="OpenStorageFolder_Click" />
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button x:Name="AllHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="All" Click="HistoryFilterButton_Click" Content="全部" />
                                    <Button x:Name="ScreenshotHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="Screenshot" Click="HistoryFilterButton_Click" Content="普通截图" />
                                    <Button x:Name="LongScreenshotHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="LongScreenshot" Click="HistoryFilterButton_Click" Content="长截图" />
                                    <Button x:Name="TextExtractionHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="TextExtraction" Click="HistoryFilterButton_Click" Content="文字提取" />
                                    <Button x:Name="TranslationHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="Translation" Click="HistoryFilterButton_Click" Content="翻译" />
                                    <Button x:Name="ScreenRecordingHistoryFilterButton" Style="{StaticResource HistoryFilterButtonStyle}" Tag="ScreenRecording" Click="HistoryFilterButton_Click" Content="屏幕录制" />
                                </StackPanel>

                                <Border Grid.Row="4" Background="#36FFFFFF"
                                        BorderBrush="#62FFFFFF" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <StackPanel x:Name="HistoryEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#A5ABB3" Text="&#xE81C;" />
                                            <TextBlock Margin="0,16,0,0" FontSize="17" FontWeight="SemiBold" Text="还没有历史记录" />
                                            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="完成截图、文字提取、翻译或录制后会按类别显示在这里" />
                                        </StackPanel>

                                        <ScrollViewer x:Name="HistoryScrollViewer" Visibility="Collapsed"
                                                      Margin="8" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                            <!-- 图片与录像继续使用缩略图网格。 -->
                                            <ItemsControl x:Name="HistoryItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemWidth="248" ItemHeight="214" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="232" Height="198" Margin="7"
                                                                Padding="0" Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" Tag="{Binding FilePath}" Click="OpenHistoryItem_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTextRecord}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Border Background="#A8FFFFFF" BorderBrush="#C8FFFFFF"
                                                                    BorderThickness="1" CornerRadius="13" Padding="10">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="132" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>
                                                                    <Border Background="#EEF1F5" CornerRadius="9" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#6085B8" Text="&#xE8A5;" />
                                                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding KindText}" />
                                                                                <TextBlock Width="178" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="#738092" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding PreviewText}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <Grid Grid.Row="1" Margin="2,9,2,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="{Binding KindText}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="#313842" TextTrimming="CharacterEllipsis" />
                                                                        <Grid Grid.Row="1" Margin="0,5,0,0">
                                                                            <TextBlock Text="{Binding CapturedAtText}" FontSize="10" Foreground="#858D98" />
                                                                            <TextBlock HorizontalAlignment="Right" Text="{Binding SizeText}" FontSize="10" Foreground="#858D98" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 文字提取与翻译以满宽横条显示，便于直接扫读内容摘要。 -->
                                            <ItemsControl x:Name="TextHistoryItemsControl" Margin="7,3,7,7">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Height="104" Margin="0,0,0,10" Padding="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" Tag="{Binding FilePath}" Click="OpenHistoryItem_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTextRecord}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Border Background="#92FFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,14">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#486177" />
                                                                </Border.Effect>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="54" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="185" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="42" Height="42" VerticalAlignment="Top" Background="#E5F0FF" CornerRadius="12">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#3D82E8" Text="&#xE8A5;" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Margin="4,0,16,0">
                                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding KindText}" />
                                                                        <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="#6F7D8E" Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#7F8B99" Text="{Binding CapturedAtText}" />
                                                                        <TextBlock Margin="0,7,0,0" HorizontalAlignment="Right" FontSize="12" Foreground="#3D82E8" Text="{Binding SizeText}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 快捷键页 -->
                            <Grid x:Name="ShortcutsView" Visibility="Collapsed" Margin="58,44">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="快捷键" />
                                    <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Text="为常用截图操作设置全局快捷键" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="#5AFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <Grid Height="72" Margin="22,0">
                                            <TextBlock VerticalAlignment="Center" FontSize="15" Text="截图" />
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8"
                                                    Background="#AFFFFFFF" BorderBrush="#CFFFFFFF" BorderThickness="1"
                                                    Content="Ctrl + Shift + A" Click="ShortcutButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 设置页 -->
                            <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="58,44">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
                                    <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Text="调整截影的常用行为" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="#5AFFFFFF" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <Grid Height="76" Margin="22,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15" Text="截图后自动复制" />
                                                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="完成截图后写入系统剪贴板" />
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" />
                                        </Grid>
                                        <Border Height="1" Margin="22,0" Background="{StaticResource GlassDividerBrush}" />
                                        <Grid Height="76" Margin="22,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15" Text="保存截图历史" />
                                                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="默认保存到 E:\截影\Screenshots" />
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 轻量状态提示 -->
                            <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,22" Padding="18,11" Background="#D9222933"
                                    BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#7FB0FF" Text="&#xE73E;" />
                                    <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="13" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
