n="1" VerticalAlignment="Center" FontSize="11" Foreground="#45617B" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="#537BAB" Text="{Binding Extension}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" Foreground="#7890A6" Text="{Binding FileSize}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
