<Window x:Class="ScreenshotApp.DesktopPet.PetAlarmPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-Tool 静默闹钟"
        Width="430" Height="620"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="AlarmButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#3D5871" />
            <Setter Property="Background" Value="#F7FAFE" />
            <Setter Property="BorderBrush" Value="#C8D9EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#EEF4FF" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#739CFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#DCE7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAlarmButtonStyle" TargetType="Button" BasedOn="{StaticResource AlarmButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#4D7CFE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="White" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#3F6FEA" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#3F6FEA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#315FD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlarmToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#587087" />
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="BorderBrush" Value="#CBDCEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#7EA3F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#E3ECFF" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#6F96F2" />
                                <Setter Property="Foreground" Value="#315BB4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlarmTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#35516A" />
            <Setter Property="Background" Value="#F9FBFE" />
            <Setter Property="BorderBrush" Value="#CBDCEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="Watermark" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="#9AAEC1" IsHitTestVisible="False"
                                           Text="{TemplateBinding Tag}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#6F96F2" />
                                <Setter TargetName="Body" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlarmComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#29465F" />
            <Setter Property="Background" Value="#F9FBFE" />
            <Setter Property="BorderBrush" Value="#C6D9EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <ContentPresenter Margin="12,0,25,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}" />
                                    <TextBlock Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#7890A7" Text="&#xE70D;" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Margin="0,4,0,0" Padding="4" MinWidth="72" MaxHeight="230"
                                        Background="#FCFDFF" BorderBrush="#B7CCE3" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#5065809C" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#739CFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Body" Margin="1" Padding="{TemplateBinding Padding}" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="#EDF3FF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="#DFE9FF" />
                                            <Setter Property="Foreground" Value="#315BB4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlarmScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Body" Margin="1" Background="#9DB3C9" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#6F91D8" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Body" Property="Background" Value="#4D7CFE" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlarmScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="5,2,1,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Margin="1" Background="#DFE8F2" CornerRadius="3" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource AlarmScrollThumbStyle}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot" Margin="12" Padding="18,16" BorderBrush="#AFC6DF" BorderThickness="1.4" CornerRadius="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FCFDFFFF" />
                <GradientStop Offset="0.58" Color="#F3F8FDFF" />
                <GradientStop Offset="1" Color="#EDF4FBFF" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect Color="#5065809C" BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.32" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" Margin="0,0,10,0" Background="#E6EEFF" BorderBrush="#B7CBF7" BorderThickness="1" CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#597ED8" Text="&#xE823;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="静默闹钟" FontSize="16" FontWeight="SemiBold" Foreground="#29465F" />
                        <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="10.5" Foreground="#7890A7" Text="仅消息提醒 · 无声音" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="NewAlarmButton" Grid.Column="1" Width="32" Height="32" Padding="0" Margin="0,0,7,0"
                        Style="{StaticResource PrimaryAlarmButtonStyle}" Click="NewAlarmButton_Click" ToolTip="新建闹钟">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="White" Text="&#xE710;" />
                </Button>
                <Button x:Name="BackToListButton" Grid.Column="1" Width="32" Height="32" Padding="0" Margin="0,0,7,0"
                        Visibility="Collapsed" Style="{StaticResource AlarmButtonStyle}" Click="BackToListButton_Click" ToolTip="返回闹钟列表">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE72B;" />
                </Button>
                <Button Grid.Column="2" Width="32" Height="32" Padding="0" Style="{StaticResource AlarmButtonStyle}" Click="CloseButton_Click" ToolTip="关闭闹钟面板">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE711;" />
                </Button>
            </Grid>

            <Grid x:Name="ListPage" Grid.Row="1" Margin="0,15,0,0">
                <Border Padding="10" Background="#86FFFFFF" BorderBrush="#D9E5F1" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" HorizontalAlignment="Center" Background="#EAF0FF" BorderBrush="#C7D7F8" BorderThickness="1" CornerRadius="18">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#6689DC" Text="&#xE823;" />
                            </Border>
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#526D85" Text="还没有闹钟" />
                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#8A9BAD" Text="点击右上角 + 创建第一条静默提醒" />
                        </StackPanel>
                        <ScrollViewer x:Name="AlarmScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AlarmScrollBarStyle}" /></ScrollViewer.Resources>
                            <ItemsControl x:Name="AlarmItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="11" Background="#F9FBFE" BorderBrush="#D4E2EF" BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#36526B" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#7890A7" Text="{Binding Detail}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1" Width="45" Margin="7,0" Style="{StaticResource AlarmToggleStyle}"
                                                              Tag="{Binding Id}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Click="EnabledToggle_Click" Content="启用" />
                                                <Button Grid.Column="2" Width="32" Padding="0" Style="{StaticResource AlarmButtonStyle}"
                                                        Tag="{Binding Id}" Click="DeleteAlarmButton_Click" ToolTip="删除闹钟">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="EditorPage" Grid.Row="1" Margin="0,13,0,0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AlarmScrollBarStyle}" /></ScrollViewer.Resources>
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Margin="1,0,0,7" FontSize="10.5" Foreground="#7890A7" Text="提醒时间" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="HourComboBox" Style="{StaticResource AlarmComboStyle}" />
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#617A91" Text=":" />
                        <ComboBox x:Name="MinuteComboBox" Grid.Column="2" HorizontalAlignment="Left" Style="{StaticResource AlarmComboStyle}" />
                    </Grid>

                    <TextBlock Margin="1,13,0,7" FontSize="10.5" Foreground="#7890A7" Text="闹钟名称" />
                    <TextBox x:Name="NameTextBox" MaxLength="30" Tag="例如：站起来活动一下" Style="{StaticResource AlarmTextBoxStyle}" Text="" />

                    <TextBlock Margin="1,13,0,7" FontSize="10.5" Foreground="#7890A7" Text="重复" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="OnceToggle" Style="{StaticResource AlarmToggleStyle}" IsChecked="True" Checked="RepeatToggle_Checked" Content="仅一次" />
                        <ToggleButton x:Name="DailyToggle" Style="{StaticResource AlarmToggleStyle}" Checked="RepeatToggle_Checked" Content="每天" />
                        <ToggleButton x:Name="CustomToggle" Style="{StaticResource AlarmToggleStyle}" Checked="RepeatToggle_Checked" Content="自定义" />
                    </StackPanel>
                    <StackPanel x:Name="WeekdayPanel" Margin="0,8,0,0" Orientation="Horizontal" Visibility="Collapsed">
                        <ToggleButton Tag="Monday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="一" />
                        <ToggleButton Tag="Tuesday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="二" />
                        <ToggleButton Tag="Wednesday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="三" />
                        <ToggleButton Tag="Thursday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="四" />
                        <ToggleButton Tag="Friday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="五" />
                        <ToggleButton Tag="Saturday" Width="42" Padding="0" Style="{StaticResource AlarmToggleStyle}" Content="六" />
                        <ToggleButton Tag="Sunday" Width="42" Padding="0" Margin="0" Style="{StaticResource AlarmToggleStyle}" Content="日" />
                    </StackPanel>

                    <TextBlock Margin="1,13,0,7" FontSize="10.5" Foreground="#7890A7" Text="提前提醒（可多选）" />
                    <StackPanel x:Name="AdvancePanel" Orientation="Horizontal">
                        <ToggleButton Tag="60" Style="{StaticResource AlarmToggleStyle}" Content="1 小时" />
                        <ToggleButton Tag="30" Style="{StaticResource AlarmToggleStyle}" Content="30 分钟" />
                        <ToggleButton Tag="15" Style="{StaticResource AlarmToggleStyle}" Content="15 分钟" />
                        <ToggleButton Tag="5" Margin="0" Style="{StaticResource AlarmToggleStyle}" Content="5 分钟" />
                    </StackPanel>

                    <Border Margin="0,13,0,0" Padding="10,8" Background="#F7FAFE" BorderBrush="#D5E3F1" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <ToggleButton x:Name="DeleteAfterToggle" Width="42" Height="24" HorizontalAlignment="Left" Style="{StaticResource AlarmToggleStyle}" Padding="0" Content="删" />
                            <TextBlock Margin="50,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#526D85" Text="到点提醒关闭后删除此闹钟" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#7890A7" Text="全程静默，只显示消息和彩光" />
                        <Button HorizontalAlignment="Right" Width="96" Height="34" Style="{StaticResource PrimaryAlarmButtonStyle}"
                                Click="SaveButton_Click">
                            <TextBlock Foreground="White" Text="保存闹钟" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,9,0,0" FontSize="10" Foreground="#557799" Text="闹钟仅在 X-Tool 运行时触发" />
        </Grid>
    </Border>
</Window>
