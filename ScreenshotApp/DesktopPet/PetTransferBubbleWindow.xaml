<Window x:Class="ScreenshotApp.DesktopPet.PetTransferBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-Tool 宠物传输气泡"
        Width="320" MinWidth="320" MaxWidth="320" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PetBubbleStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="RainbowProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource MailGradient}" />
            <Setter Property="Background" Value="#DDE5F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Height="8" Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>
        <Border x:Name="BubbleCard"
                Padding="17,14,17,13"
                Background="{StaticResource PetBubbleBackground}"
                BorderBrush="{StaticResource PetBubbleBorder}"
                BorderThickness="1"
                CornerRadius="18"
                MouseLeftButtonUp="BubbleCard_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="#52627B9A" BlurRadius="25" ShadowDepth="5" Direction="270" Opacity="0.34" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StatusIconColumn" Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusIconBorder" Width="30" Height="30" CornerRadius="15" Background="#B8FFFFFF" BorderBrush="#72A9C8F1" BorderThickness="1">
                        <Grid><Image x:Name="AvatarImage" Width="44" Height="44" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/></Image.Clip></Image>
                        <TextBlock x:Name="StatusIconText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#4D7CFE" Text="&#xE724;" /></Grid>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="#304A63" Text="正在传到手机" />
                    <TextBlock x:Name="PercentageText" Grid.Column="2" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="#4D7CFE" Text="0%" />
                </Grid>
                <TextBlock x:Name="FileNameText" Grid.Row="1" Margin="1,9,1,0" MaxWidth="270"
                           FontSize="11" Foreground="#5D7186" TextTrimming="CharacterEllipsis" Text="文件" />
                <ProgressBar x:Name="TransferProgressBar" Grid.Row="2" Margin="1,10,1,0" Height="8"
                             Minimum="0" Maximum="100" Value="0" Style="{StaticResource RainbowProgressBarStyle}" />
                <Button x:Name="CopyCodeButton" Grid.Row="4" Margin="1,12,1,0" Height="38"
                        Visibility="Collapsed" Cursor="Hand" Background="{StaticResource MailGradient}" Foreground="White"
                        BorderThickness="0" Click="CopyCodeButton_Click" ToolTip="只复制验证码">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CodeButtonBody" Background="{TemplateBinding Background}" CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CodeButtonBody" Property="Background" Value="#3D6DE8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CodeButtonBody" Property="Background" Value="#315ACB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="CopyCodeText" Text="复制验证码" FontSize="14" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <StackPanel x:Name="MailActions" Grid.Row="4" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="Background" Value="{StaticResource MailGradient}"/><Setter Property="Foreground" Value="White"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Click="MailOpen_Click"><TextBlock Text="查看邮件" Foreground="White"/></Button>
                    <Button x:Name="MailReadButton" Content="标为已读" Click="MailRead_Click" Background="#E8EFFB" Foreground="#34547D"/>
                </StackPanel>
                <Grid x:Name="DetailRow" Grid.Row="3" Margin="1,8,1,0">
                    <TextBlock x:Name="TransferredText" FontSize="9.5" Foreground="#7A8EA1" Text="0 B / 0 B" />
                    <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" FontSize="9.5" Foreground="#7A8EA1" Text="准备中" />
                </Grid>
            </Grid>
        </Border>
        <Polygon x:Name="TailArrow" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Points="0,0 18,0 9,11"
                 Fill="{StaticResource PetBubbleBackground}" Stroke="{StaticResource PetBubbleBorder}" StrokeThickness="1" />
    </Grid>
</Window>
