<Window x:Class="ScreenshotApp.GitHubCenter.GitHubCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="GitHub 仓库中心 · X-Tool" Width="1260" Height="800" MinWidth="1040" MinHeight="680"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#152C48" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/XTool;component/Mail/MailStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="icons:PackIconMaterial"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <ControlTemplate x:Key="GitHorizontalScroll" TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CAD5E5" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#233C59"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="#F8FAFE"/><Setter Property="BorderBrush" Value="#DDE5F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="GitButton" TargetType="Button" BasedOn="{StaticResource MailTranslationButton}"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style x:Key="GitPrimary" TargetType="Button" BasedOn="{StaticResource GitButton}"><Setter Property="Background" Value="{StaticResource MailGradient}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="GitCombo" TargetType="ComboBox"><Setter Property="Foreground" Value="#233C59"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#DDFFFFFF" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="8"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}"/><icons:PackIconMaterial Kind="ChevronDown" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#71829E" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="8" MinWidth="160" MaxWidth="480" MaxHeight="260"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#80FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFFFFFFF"/><Setter TargetName="Row" Property="BorderBrush" Value="#326AF5"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#326AF5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="14,10"/><Setter Property="Foreground" Value="#657D9E"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#326AF5"/><Setter Property="Foreground" Value="#245EE4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="Background" Value="#CCFFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="LabelTemplate"><TextBlock Text="{Binding Label}" Foreground="#233C59" TextWrapping="Wrap" FontSize="13" LineHeight="22"/></DataTemplate>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CAD5E5" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter Property="Template" Value="{StaticResource GitHorizontalScroll}"/></Trigger></Style.Triggers></Style>
 </ResourceDictionary></Window.Resources>
 <Border CornerRadius="16" BorderBrush="#DDE5F0" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAF6FF"/><GradientStop Color="#F1EDFF" Offset="0.55"/><GradientStop Color="#FFEDF6" Offset="0.85"/><GradientStop Color="#EFF3FF" Offset="1"/></LinearGradientBrush></Border.Background>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Grid Margin="18,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><icons:PackIconMaterial Kind="Github" Width="23" Height="23"/><TextBlock Text="X-Tool / GitHub 仓库中心" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化"><icons:PackIconMaterial Kind="Minus" Width="18" Height="18"/></Button><Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化 / 还原"><icons:PackIconMaterial Kind="WindowMaximize" Width="16" Height="16"/></Button><Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="关闭"><icons:PackIconMaterial Kind="Close" Width="18" Height="18"/></Button></StackPanel></Grid>
  <Grid x:Name="Workspace" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Margin="14,12,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button x:Name="AccountButton" Style="{StaticResource GitButton}" Click="Account_Click" HorizontalContentAlignment="Left" Content="连接 GitHub 账户"/>
    <Grid Grid.Row="1" Margin="0,14,0,10"><TextBox x:Name="RepositorySearch" Padding="30,8,10,8" ToolTip="搜索本地仓库" TextChanged="Search_Changed"/><icons:PackIconMaterial Kind="Magnify" Width="16" Height="16" Foreground="#8194AD" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索本地仓库" Margin="32,0,0,0" VerticalAlignment="Center" Foreground="#8194AD" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RepositorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <DockPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="本地仓库" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GitButton}" Click="Add_Click" ToolTip="添加本地仓库" Padding="8"><icons:PackIconMaterial Kind="Plus" Width="17" Height="17"/></Button><Button Style="{StaticResource GitButton}" Click="RefreshAll_Click" ToolTip="检查所有本地仓库" Padding="8"><icons:PackIconMaterial Kind="Refresh" Width="17" Height="17"/></Button></StackPanel></DockPanel>
    <ListBox x:Name="Repositories" Grid.Row="3" ItemTemplate="{StaticResource LabelTemplate}" SelectionChanged="Repository_Changed"/>
    <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button Style="{StaticResource GitButton}" Click="Clone_Click" Content="克隆仓库"/><Button Style="{StaticResource GitButton}" Click="Settings_Click" ToolTip="缓存与设置" Padding="9"><icons:PackIconMaterial Kind="CogOutline" Width="18" Height="18"/></Button></WrapPanel>
   </Grid>
   <Grid Grid.Column="1" Margin="0,12,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RepositoryTitle" Text="仓库工作台" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RepositoryPath" Text="尚未选择本地仓库" Foreground="#71829E" Margin="0,7,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource GitButton}" Click="Folder_Click" ToolTip="打开本地目录" Padding="9"><icons:PackIconMaterial Kind="FolderOpen" Width="18" Height="18"/></Button><Button Style="{StaticResource GitButton}" Click="Web_Click" ToolTip="打开 GitHub 仓库" Padding="9"><icons:PackIconMaterial Kind="OpenInNew" Width="18" Height="18"/></Button><Button Style="{StaticResource GitButton}" Click="Remove_Click" ToolTip="从列表移除，不删除文件" Padding="9"><icons:PackIconMaterial Kind="Close" Width="18" Height="18"/></Button></StackPanel></Grid>
    <WrapPanel x:Name="GitToolbar" Grid.Row="1" Margin="0,4,0,12">
     <ComboBox x:Name="BranchPicker" Style="{StaticResource GitCombo}" Width="150" Height="36" Margin="0,0,6,6" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
     <Button Style="{StaticResource GitButton}" Click="Switch_Click" Content="切换"/><Button Style="{StaticResource GitButton}" Click="NewBranch_Click" ToolTip="新建分支" Padding="9"><icons:PackIconMaterial Kind="SourceBranchPlus" Width="18" Height="18"/></Button>
     <ComboBox x:Name="RemotePicker" Style="{StaticResource GitCombo}" Width="110" Height="36" Margin="0,0,8,6" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" SelectionChanged="Remote_Changed"/>
     <Button Style="{StaticResource GitButton}" Click="Refresh_Click" ToolTip="刷新本地状态" Padding="9"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18"/></Button>
     <Button Style="{StaticResource GitButton}" Click="Fetch_Click"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CloudDownloadOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="获取"/></StackPanel></Button>
     <Button Style="{StaticResource GitButton}" Click="Pull_Click" Content="拉取"/>
     <Button Style="{StaticResource GitPrimary}" Click="Push_Click"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CloudUploadOutline" Width="16" Height="16" Margin="0,0,5,0" Foreground="White"/><TextBlock Text="推送" Foreground="White"/></StackPanel></Button>
     <Button Style="{StaticResource GitButton}" Click="Terminal_Click" ToolTip="在仓库目录打开终端" Padding="9"><icons:PackIconMaterial Kind="Console" Width="18" Height="18"/></Button>
     <Button Style="{StaticResource GitButton}" Click="Edit_Click" ToolTip="在记事本打开选中文件" Padding="9"><icons:PackIconMaterial Kind="PencilOutline" Width="18" Height="18"/></Button>
    </WrapPanel>
    <TabControl x:Name="Views" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="View_Changed">
     <TabItem Header="改动"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.36*" MinWidth="210"/><ColumnDefinition Width="5"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ChangesSummary" Text="未读取" Foreground="#657D9E" Margin="8,0,0,8"/><ListBox x:Name="Changes" Grid.Row="1" ItemTemplate="{StaticResource LabelTemplate}" SelectionChanged="Change_Changed"/><WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="StageButton" Style="{StaticResource GitButton}" Click="Stage_Click" Content="暂存文件"/><Button x:Name="UnstageButton" Style="{StaticResource GitButton}" Click="Unstage_Click" Content="取消暂存"/></WrapPanel></Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E3EAF5"/>
      <TextBox x:Name="Diff" Grid.Column="2" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="12" Background="#BFFFFFFF" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0" Text="选择文件查看差异"/>
     </Grid><Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommitMessage" Height="64" MaxLength="10000" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="本地提交说明"/><Button Grid.Column="1" x:Name="CommitButton" Style="{StaticResource GitPrimary}" Click="Commit_Click" Margin="10,0,0,0" Content="本地提交"/></Grid></Grid></TabItem>
     <TabItem Header="历史"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="0.4*"/><RowDefinition Height="0.6*"/></Grid.RowDefinitions><ListBox x:Name="History" ItemTemplate="{StaticResource LabelTemplate}" SelectionChanged="History_Changed"/><TextBox x:Name="CommitDiff" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
     <TabItem Header="PR 与构建"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Style="{StaticResource GitButton}" Click="Overview_Click" Content="刷新 GitHub 状态"/><TextBlock x:Name="OverviewTime" VerticalAlignment="Center" Foreground="#71829E" TextWrapping="Wrap"/></DockPanel><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DockPanel Margin="0,0,10,0"><TextBlock x:Name="PullStatus" DockPanel.Dock="Top" Text="开放的 PR" TextWrapping="Wrap" Margin="8"/><ListBox x:Name="PullRequests" ItemTemplate="{StaticResource LabelTemplate}" MouseDoubleClick="Activity_Open" KeyDown="Activity_KeyDown"/></DockPanel><DockPanel Grid.Column="1"><TextBlock x:Name="RunStatus" DockPanel.Dock="Top" Text="最近构建" TextWrapping="Wrap" Margin="8"/><ListBox x:Name="Runs" ItemTemplate="{StaticResource LabelTemplate}" MouseDoubleClick="Activity_Open" KeyDown="Activity_KeyDown"/></DockPanel></Grid></Grid></TabItem>
     <TabItem Header="GitHub 仓库"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button Style="{StaticResource GitButton}" Click="RemoteRefresh_Click" Content="读取我的仓库"/><TextBlock x:Name="RemoteStatus" Text="未连接账户" VerticalAlignment="Center" Foreground="#71829E" TextWrapping="Wrap"/></DockPanel><ListBox x:Name="RemoteRepositories" Grid.Row="1" Margin="0,12" ItemTemplate="{StaticResource LabelTemplate}"/><WrapPanel Grid.Row="2"><Button Style="{StaticResource GitButton}" Click="RemoteClone_Click" Content="克隆选中仓库"/><Button Style="{StaticResource GitButton}" Click="RemoteWeb_Click" Content="打开网页"/><Button x:Name="LoadMoreButton" Style="{StaticResource GitButton}" Click="RemoteMore_Click" Content="下一页" IsEnabled="False"/></WrapPanel></Grid></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="#657D9E" VerticalAlignment="Center" Text="本地 Git · 未连接 GitHub" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><ProgressBar x:Name="BusyProgress" Width="100" Height="4" Margin="10,0" IsIndeterminate="True" Visibility="Collapsed"/><Button x:Name="CancelButton" Style="{StaticResource GitButton}" Height="28" Padding="8,2" Click="Cancel_Click" Content="取消" Visibility="Collapsed"/></StackPanel></Grid>
 </Grid></Border>
</Window>
