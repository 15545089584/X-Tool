<UserControl x:Class="ScreenshotApp.Archives.ArchiveWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="720"
             AllowDrop="True"
             DragOver="ArchiveWorkspace_DragOver"
             Drop="ArchiveWorkspace_Drop">
    <UserControl.Resources>
        <Style x:Key="ArchiveModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#58718A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="#85FFFFFF" BorderBrush="#A9CEE1F0"
                                BorderThickness="1" CornerRadius="12"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8F3FAFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4D7CFE" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4D7CFE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchivePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#4D7CFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ArchivePrimaryButtonStyle}">
            <Setter Property="Background" Value="#A8FFFFFF" />
            <Setter Property="BorderBrush" Value="#B8CDE3F2" />
            <Setter Property="Foreground" Value="#526E89" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="ArchiveInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8CBE0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#3F5870" />
            <Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="SelectionBrush" Value="#8CB0FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#85ABC5D8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4D7CFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchivePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8CBE0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#3F5870" />
            <Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#85ABC5D8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4D7CFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="#3F5870" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Margin="4,2" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="8"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5EEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D7E5FF" />
                                <Setter Property="Foreground" Value="#315CB8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8CBE0EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#3F5870" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ArchiveComboBoxItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                <Grid>
                                    <ContentPresenter Margin="13,0,42,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Width="9" Height="5" Margin="0,0,15,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 0 0 L 4.5 4.5 L 9 0" Stretch="Fill"
                                          Stroke="#70879C" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                    <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="280" Padding="4" Background="#FAFFFFFF"
                                        BorderBrush="#A8CBE0EF" BorderThickness="1" CornerRadius="11">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.16" Color="#58718A" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#85ABC5D8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4D7CFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#526E89" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckRoot" Width="18" Height="18" Background="#B8FFFFFF"
                                    BorderBrush="#9FC6DCEB" BorderThickness="1" CornerRadius="5">
                                <Path x:Name="CheckMark" Width="10" Height="7" Visibility="Collapsed"
                                      Data="M 0 3 L 3.5 6.5 L 10 0" Stretch="Fill"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#4D7CFE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckRoot" Property="Background" Value="#4D7CFE" />
                                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#4D7CFE" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="压缩包工作台" />
                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#71869A"
                           Text="本地创建、预览和解压常见压缩包，任务不会上传到网络" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7"
                    Background="#DDF6EA" BorderBrush="#9DDBBFAE" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#3DB67A" />
                    <TextBlock FontSize="11" Foreground="#367A59" Text="纯本地处理" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="8" Background="#66FFFFFF" BorderBrush="#8FCFE2F1"
                BorderThickness="1" CornerRadius="15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CreateModeButton" GroupName="ArchiveMode"
                                 Style="{StaticResource ArchiveModeButtonStyle}" IsChecked="True"
                                 Checked="CreateModeButton_Checked" Content="创建压缩包" />
                    <RadioButton x:Name="ExtractModeButton" GroupName="ArchiveMode"
                                 Style="{StaticResource ArchiveModeButtonStyle}"
                                 Checked="ExtractModeButton_Checked" Content="解压缩" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="11" Foreground="#7B91A6" Text="可直接把文件、文件夹或压缩包拖入此页面" />
            </Grid>
        </Border>

        <Grid x:Name="CreatePanel" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18" Background="#78FFFFFF" BorderBrush="#9DCDE2F2"
                    BorderThickness="1" CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="待压缩内容" />
                            <TextBlock x:Name="CreateSourceSummaryText" Margin="0,4,0,0" FontSize="11"
                                       Foreground="#7B91A6" Text="尚未添加文件或文件夹" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="92" Height="36" Margin="0,0,8,0" Padding="12,0"
                                    Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="AddFiles_Click" Content="添加文件" />
                            <Button Width="104" Height="36" Margin="0,0,8,0" Padding="12,0"
                                    Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="AddFolder_Click" Content="添加文件夹" />
                            <Button Width="68" Height="36" Padding="10,0" Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="ClearSources_Click" Content="清空" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,9" Background="#45EAF3FF" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#6E849A" Text="名称与位置" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" Foreground="#6E849A" Text="类型" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontSize="11" Foreground="#6E849A" Text="大小" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#2FEAF3FF" BorderBrush="#72CFE3F2"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <ListBox x:Name="CreateSourceList" Margin="8" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ArchiveListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9" Background="#A9FFFFFF" CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="94" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Background="#E5EEFF" CornerRadius="8">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4D7CFE"
                                                               Text="&#xE8B7;" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#38536D"
                                                               Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#8195A8"
                                                               Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="#678199" Text="{Binding KindText}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="#567797" Text="{Binding SizeText}" />
                                                <Button Grid.Column="4" Width="30" Height="30" Padding="0" Background="Transparent"
                                                        BorderThickness="0" Foreground="#8A9BAC" FontFamily="Segoe UI"
                                                        FontSize="18" Cursor="Hand" Tag="{Binding FullPath}"
                                                        Click="RemoveSource_Click" Content="×" ToolTip="移除" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="CreateEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="62" Height="62" HorizontalAlignment="Center" Background="#E4EEFF" CornerRadius="18">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#6F95E8" Text="&#xE8B7;" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14"
                                           FontWeight="SemiBold" Text="拖入文件或文件夹" />
                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11"
                                           Foreground="#8397AA" Text="支持混合选择，原文件不会被修改" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="18" Background="#B8FFFFFF" BorderBrush="#C5D8E8F4"
                    BorderThickness="1" CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="压缩设置" />

                    <StackPanel Grid.Row="2">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="压缩格式" />
                        <ComboBox x:Name="ArchiveFormatComboBox" Margin="0,7,0,0"
                                  Style="{StaticResource ArchiveComboBoxStyle}" SelectedIndex="0"
                                  SelectionChanged="ArchiveFormatComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Zip" Content="ZIP · 兼容性最好" />
                            <ComboBoxItem Tag="SevenZip" Content="7z · 压缩率更高" />
                            <ComboBoxItem Tag="TarGZip" Content="TAR.GZ · 开发与服务器" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="压缩等级" />
                        <ComboBox x:Name="CompressionPresetComboBox" Margin="0,7,0,0"
                                  Style="{StaticResource ArchiveComboBoxStyle}" SelectedIndex="2">
                            <ComboBoxItem Tag="Store" Content="仅存储 · 不压缩" />
                            <ComboBoxItem Tag="Fast" Content="快速 · 更省时间" />
                            <ComboBoxItem Tag="Balanced" Content="均衡 · 推荐" />
                            <ComboBoxItem Tag="Smallest" Content="极限 · 体积优先" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="IncludeTopLevelCheckBox" Grid.Row="6" IsChecked="True"
                              Style="{StaticResource ArchiveCheckBoxStyle}" Content="保留顶层文件夹" />

                    <StackPanel Grid.Row="8">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="输出压缩包" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ArchiveOutputPathTextBox" Style="{StaticResource ArchiveInputStyle}"
                                     IsReadOnly="True" />
                            <Button Grid.Column="2" Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="ChooseArchiveOutput_Click" Content="浏览" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="StartCreateButton" Grid.Row="10" Style="{StaticResource ArchivePrimaryButtonStyle}"
                            Click="StartCreate_Click" Content="开始压缩" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ExtractPanel" Grid.Row="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18" Background="#78FFFFFF" BorderBrush="#9DCDE2F2"
                    BorderThickness="1" CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="压缩包内容" />
                            <TextBlock x:Name="ArchivePreviewSummaryText" Margin="0,4,0,0" FontSize="11"
                                       Foreground="#7B91A6" Text="选择压缩包后可在解压前预览内容" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="112" Height="36" Margin="0,0,8,0" Padding="12,0"
                                    Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="SelectArchive_Click" Content="选择压缩包" />
                            <Button x:Name="ReloadPreviewButton" Width="92" Height="36" Padding="12,0"
                                    Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="ReloadPreview_Click" Content="刷新预览" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,9" Background="#45EAF3FF" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" Foreground="#6E849A" Text="条目路径" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" Foreground="#6E849A" Text="类型" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="11" Foreground="#6E849A" Text="大小" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontSize="11" Foreground="#6E849A" Text="修改时间" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#2FEAF3FF" BorderBrush="#72CFE3F2"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <ListBox x:Name="ArchivePreviewList" Margin="8" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ArchiveListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Background="#A9FFFFFF" CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="128" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4D7CFE"
                                                               Text="&#xE8B7;" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#3F5870"
                                                               Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="10"
                                                               Foreground="#D9822B" Text="{Binding EncryptionText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="#678199" Text="{Binding KindText}" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="#567797" Text="{Binding SizeText}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" Foreground="#8195A8" Text="{Binding ModifiedText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="PreviewEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="62" Height="62" HorizontalAlignment="Center" Background="#E4EEFF" CornerRadius="18">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#6F95E8" Text="&#xE8B7;" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14"
                                           FontWeight="SemiBold" Text="拖入一个压缩包" />
                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11"
                                           Foreground="#8397AA" Text="先检查内容，再决定解压位置" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="18" Background="#B8FFFFFF" BorderBrush="#C5D8E8F4"
                    BorderThickness="1" CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="解压设置" />

                    <StackPanel Grid.Row="2">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="当前压缩包" />
                        <TextBox x:Name="SelectedArchivePathTextBox" Margin="0,7,0,0"
                                 Style="{StaticResource ArchiveInputStyle}" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="密码（如需要）" />
                        <PasswordBox x:Name="ArchivePasswordBox" Margin="0,7,0,0"
                                     Style="{StaticResource ArchivePasswordBoxStyle}" />
                        <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#8A9AAC"
                                   Text="密码仅用于本次任务，不保存、不写入日志" />
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="同名文件" />
                        <ComboBox x:Name="ConflictPolicyComboBox" Margin="0,7,0,0"
                                  Style="{StaticResource ArchiveComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Tag="Rename" Content="自动重命名 · 推荐" />
                            <ComboBoxItem Tag="Skip" Content="跳过已有文件" />
                            <ComboBoxItem Tag="Overwrite" Content="覆盖已有文件" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="8">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#607A93" Text="解压到" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtractDestinationTextBox" Style="{StaticResource ArchiveInputStyle}"
                                     IsReadOnly="True" />
                            <Button Grid.Column="2" Style="{StaticResource ArchiveSecondaryButtonStyle}"
                                    Click="ChooseExtractFolder_Click" Content="浏览" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="StartExtractButton" Grid.Row="10" Style="{StaticResource ArchivePrimaryButtonStyle}"
                            Click="StartExtract_Click" Content="开始解压" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="OperationPanel" Grid.Row="6" Padding="14,10" Background="#C8FFFFFF"
                BorderBrush="#BCD7E8F4" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OperationStatusText" FontSize="12" FontWeight="SemiBold" Foreground="#45627D" />
                    <TextBlock x:Name="OperationCurrentFileText" Margin="0,3,0,0" FontSize="10"
                               Foreground="#8195A8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="OperationProgressBar" Grid.Row="0" Height="8" Minimum="0" Maximum="100"
                                 Background="#DFEAF4" Foreground="#4D7CFE" BorderThickness="0" />
                    <TextBlock x:Name="OperationProgressText" Grid.Row="2" HorizontalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold" Foreground="#6D849A" />
                </Grid>
                <Button x:Name="CancelOperationButton" Grid.Column="4" Height="36" Padding="12,0"
                        Style="{StaticResource ArchiveSecondaryButtonStyle}"
                        Click="CancelOperation_Click" Content="取消" />
                <Button x:Name="OpenResultButton" Grid.Column="4" Height="36" Padding="12,0"
                        Style="{StaticResource ArchiveSecondaryButtonStyle}" Visibility="Collapsed"
                        Click="OpenResult_Click" Content="打开位置" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
