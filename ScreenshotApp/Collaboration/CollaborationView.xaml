<UserControl x:Class="ScreenshotApp.Collaboration.CollaborationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="Root_Drop"
             DragEnter="Root_DragEnter"
             DragLeave="Root_DragLeave">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#29445F" />
        <SolidColorBrush x:Key="SecondaryText" Color="#71879B" />
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#90FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9D6E8F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.10" Color="#587796" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#638BFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.86" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#405E78" />
            <Setter Property="Background" Value="#B9F7FBFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#A8D1E5F4" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E8FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransferProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#D8EAF3FA" />
            <Setter Property="Foreground" Value="#4D7CFE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="3" /><Border x:Name="PART_Track" Background="Transparent" CornerRadius="3"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" /></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="58,38,58,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="238" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="31" FontWeight="SemiBold" Foreground="#17283A" Text="协作中心" />
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryText}" Text="通过局域网或 Tailscale 连接已信任手机，双向传输并按授权远程读取文件。" />
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <Border MinHeight="42" Padding="16,0" Background="#AEEAFFF7" BorderBrush="#83CFE4D7" BorderThickness="1" CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="#7E94A8" /><TextBlock x:Name="HeaderStatusText" VerticalAlignment="Center" FontSize="12" Foreground="#557088" Text="正在启动" /></StackPanel>
                </Border>
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="手机通知" Click="OpenPhoneNotifications_Click" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="手机日程" Click="OpenPhoneCalendar_Click" />
                <Button Margin="10,0,0,0" MinWidth="118" Style="{StaticResource SecondaryButton}" Content="远程文件" Click="OpenRemoteFiles_Click" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="连接设置" Click="OpenConnectionSettings_Click" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Text="可信设备连接" />
                            <TextBlock x:Name="EndpointText" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" Text="正在读取本机地址…" />
                        </StackPanel>
                        <Button MinWidth="128" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Content="刷新配对码" Click="RefreshPairing_Click" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="18,0,12,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="178" /></Grid.ColumnDefinitions>
                        <Border Padding="12,10" Background="#A8F4F8FF" BorderBrush="#8BCDE2F3" BorderThickness="1" CornerRadius="16">
                            <StackPanel VerticalAlignment="Center"><Border Width="40" Height="40" HorizontalAlignment="Center" Background="#DCE9F0FF" CornerRadius="13"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#4D7CFE" Text="&#xE770;" /></Border><TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#35536E" Text="此电脑" /><TextBlock x:Name="LocalIpText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" Text="--" /><TextBlock x:Name="TailscaleIpText" HorizontalAlignment="Center" FontSize="9" Foreground="#20A883" Text="Tailscale 未连接" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Height="2" Margin="0,0,0,0" VerticalAlignment="Center" Background="#91A8C8E8" CornerRadius="1" />
                        <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="13,7" Background="#F4FFFFFF" BorderBrush="#A8CDE2F4" BorderThickness="1" CornerRadius="12">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#4D7CFE" Text="&#xE968;" /><TextBlock x:Name="ConnectionLineText" Margin="8,0,0,0" FontSize="11" Foreground="#55728C" Text="等待手机连接" /></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Height="2" VerticalAlignment="Center" Background="#91A8C8E8" CornerRadius="1" />
                        <Border Grid.Column="4" Padding="12,10" Background="#A8F2FFFA" BorderBrush="#83D7E7D9" BorderThickness="1" CornerRadius="16">
                            <StackPanel VerticalAlignment="Center"><Border Width="40" Height="40" HorizontalAlignment="Center" Background="#D7E9FFF7" CornerRadius="13"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#20AE8A" Text="&#xE8EA;" /></Border><TextBlock x:Name="DeviceNameText" Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#35536E" Text="Vivo X300 PRO" /><TextBlock x:Name="DeviceIpText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#20AE8A" Text="--" /><TextBlock x:Name="DeviceHintText" HorizontalAlignment="Center" FontSize="9" Foreground="#7890A6" Text="等待建立安全会话" /></StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" Padding="11" Background="#B8F9FCFF" BorderBrush="#9ED2E6F4" BorderThickness="1" CornerRadius="17">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="146" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Background="White" CornerRadius="11" Padding="4"><Image x:Name="PairingQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border><StackPanel Grid.Row="1" Margin="0,7,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#7A8FA2" Text="配对码" /><TextBlock x:Name="PairingPinText" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#4D7CFE" Text="------" /></StackPanel></Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
            <Grid x:Name="DropZone">
                <Rectangle x:Name="DropZoneOutline" Fill="#2AFFFFFF" Stroke="#C1679BD5" StrokeThickness="2.4" StrokeDashArray="6,4" RadiusX="20" RadiusY="20" />
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Text="发送到手机" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" Text="拖入文件或图片，也可以从本机选择；原文件不会被移动。" /></StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Foreground="White" Click="SelectFiles_Click"><TextBlock Foreground="White" FontWeight="SemiBold" Text="选择文件" /></Button><Button Margin="10,0,0,0" MinWidth="128" Style="{StaticResource SecondaryButton}" Content="打开接收目录" Click="OpenIncomingFolder_Click" /></StackPanel>
                            <TextBlock x:Name="QueueStatusText" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="#71879B" Text="发送队列为空" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="DropGlyph" Width="72" Height="72" HorizontalAlignment="Center" Background="#D9E9F1FF" BorderBrush="#9ABFDAF4" BorderThickness="1" CornerRadius="24"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="31" Foreground="#4D7CFE" Text="&#xE898;" /></Border>
                        <TextBlock x:Name="DropTitleText" Margin="0,15,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#405D78" Text="把内容交给 X-Tool" />
                        <TextBlock x:Name="DropHintText" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="#7890A6" Text="支持多选，单文件最大 5 GB" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="将文件拖到虚线范围内即可发送" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Text="传输动态" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" Text="双端会同步显示进行中的传输进度" /></StackPanel><Button MinWidth="120" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Content="清除已完成" Click="ClearCompleted_Click" /></Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="TransferList" ItemsSource="{Binding Transfers}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,9" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Border Padding="13,11" Background="#9CF7FBFF" BorderBrush="#8FCFE2F2" BorderThickness="1" CornerRadius="13" Cursor="Hand" MouseLeftButtonUp="TransferItem_MouseLeftButtonUp"><StackPanel HorizontalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Left"><TextBlock HorizontalAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="#36536E" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" HorizontalAlignment="Left" FontSize="9" Foreground="#7890A6" Text="{Binding DetailText}" /></StackPanel><Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3" Background="{Binding BadgeBackground}" CornerRadius="8"><TextBlock FontSize="9" Foreground="{Binding BadgeForeground}" Text="{Binding StateText}" /></Border></Grid><ProgressBar Margin="0,10,0,0" Style="{StaticResource TransferProgress}" Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}" /><Grid Margin="0,6,0,0"><TextBlock HorizontalAlignment="Left" FontSize="9" Foreground="#7890A6" Text="{Binding SizeText}" /><TextBlock HorizontalAlignment="Right" FontSize="9" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding PercentageText}" /></Grid></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="TransferEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#8AA2B6" Text="&#xE8B5;" /><TextBlock Margin="0,9,0,0" FontSize="12" Foreground="#7890A6" Text="传输任务会显示在这里" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
