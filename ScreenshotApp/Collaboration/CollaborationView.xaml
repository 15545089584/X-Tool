<UserControl x:Class="ScreenshotApp.Collaboration.CollaborationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#74FFFFFF" /><Setter Property="BorderBrush" Value="#A9D7EAF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#456581" /></Setter.Value></Setter></Style>
        <Style x:Key="Button" TargetType="Button"><Setter Property="Height" Value="44" /><Setter Property="Padding" Value="22,0" /><Setter Property="MinWidth" Value="112" /><Setter Property="Background" Value="#A8FFFFFF" /><Setter Property="BorderBrush" Value="#9FD0E7F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#42617D" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#4E7191" /></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFAFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.78" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#8AAEFF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#2E4B67" /></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#7B93A8" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style x:Key="QrGlassCheckBox" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="20" Height="20" Background="#BFFFFFFF" BorderBrush="#9FC6D4E3" BorderThickness="1" CornerRadius="6"><Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#36506A" /></Border.Effect><Path x:Name="Check" Margin="3" Data="M1.5,4.5 L5,8 L11.5,1.5" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" /></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4D7CFE" /><Setter TargetName="Box" Property="BorderBrush" Value="#7EA8F7" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部横贯大卡：标题、状态信息与二维码 -->
        <Border Padding="22,20" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#4D7CFE" Text="&#xE753;" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="#2E4B67" Text="协作中心" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Padding="12,6" CornerRadius="10" Background="#E8F1FA">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="StatusDot" Width="9" Height="9" CornerRadius="4.5" Background="#9AA9B8" VerticalAlignment="Center" />
                                <TextBlock x:Name="ServiceStateText" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#4A6B8C" Text="服务未启动" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#63809C" TextWrapping="Wrap" Text="同一局域网内与手机互传文件与剪贴板；配对过程与内容仅在本机局域网内处理。" />

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <Border Padding="12,10" Background="#B3DFF5F2" BorderBrush="#7CCEC2" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Foreground="#3E7D73" Text="配对 PIN" />
                                <TextBlock x:Name="PinText" FontSize="19" FontWeight="SemiBold" Foreground="#2E8A7E" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="12,10" Background="#B3EDE7FF" BorderBrush="#C0B2F5" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Foreground="#6A54C8" Text="手机连接" />
                                <TextBlock x:Name="SessionText" FontSize="13" FontWeight="SemiBold" Foreground="#9AA9B8" Text="等待配对" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Padding="12,10" Background="#B3DCEBFF" BorderBrush="#8FB5F7" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Foreground="#4A6B8C" Text="本机地址" />
                                <TextBlock x:Name="PairUrlText" FontSize="13" FontWeight="SemiBold" Foreground="#2F6BC4" Text="—" TextWrapping="Wrap" ToolTip="配对地址" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Padding="12,10" Background="#B3FFF0E4" BorderBrush="#F0C79F" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Foreground="#B5793F" Text="配对地址" />
                                <TextBlock x:Name="ManualUrlText" FontSize="12" FontWeight="SemiBold" Foreground="#C06A2D" Text="—" TextWrapping="Wrap" ToolTip="手机浏览器手动输入的地址" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button x:Name="StartServiceButton" Style="{StaticResource ActionButton}" Click="StartService_Click"><TextBlock Margin="2,0" Foreground="White" Text="启动服务" /></Button>
                        <Button x:Name="StopServiceButton" Margin="10,0,0,0" Style="{StaticResource Button}" Visibility="Collapsed" Click="StopService_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="停止服务" /></Button>
                        <Button x:Name="CopyUrlButton" Margin="10,0,0,0" Style="{StaticResource Button}" Click="CopyUrl_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="复制地址" /></Button>
                        <Button x:Name="RegeneratePinButton" Margin="10,0,0,0" Style="{StaticResource Button}" Click="RegeneratePin_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="更换 PIN" /></Button>
                        <Button x:Name="AllowFirewallButton" Margin="10,0,0,0" MinWidth="150" Padding="24,0" Style="{StaticResource Button}" Click="AllowFirewall_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="放行防火墙" /></Button>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Width="196" Height="196" VerticalAlignment="Center" Background="White" BorderBrush="#D8E7F4" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Image x:Name="PairQrImage" MaxWidth="176" MaxHeight="176" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock x:Name="QrEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#9AADBF" Text="启动服务后生成二维码" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 剪贴板桥：小条展示，单向同步说明 -->
        <Border Grid.Row="2" Padding="14,9" Style="{StaticResource Card}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#16B99B" Text="&#xE77F;" />
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="剪贴板桥" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#63809C" Text="电脑→手机自动同步；手机→电脑需回到 App 前台自动补推（系统剪贴板保护限制）" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClipboardStateText" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Foreground="#63809C" Text="等待服务启动" />
                    <CheckBox x:Name="ClipboardBridgeCheckBox" Style="{StaticResource QrGlassCheckBox}" IsChecked="True" Content="电脑→手机同步" FontSize="12" Foreground="#526F8B" Checked="ClipboardBridge_Changed" Unchecked="ClipboardBridge_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件传输：全宽大卡 -->
        <Border Grid.Row="4" Padding="18" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" Background="#FFE9DE" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#D8754E" Text="&#xE8A5;" /></Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="文件传输" />
                </StackPanel>
                <TextBlock Grid.Row="2" FontSize="12" Foreground="#63809C" TextWrapping="Wrap" Text="手机上传的文件自动存入接收目录；电脑发送的文件自动进入发送目录，手机端自动下载。收发目录可在左下角设置中修改。" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="12" Background="#46EAF3FF" BorderBrush="#A5CFE6F8" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="手机上传目录" />
                            <TextBlock x:Name="IncomingPathText" Grid.Row="2" FontSize="11" Foreground="#52708C" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button Grid.Row="4" Height="34" MinWidth="92" Padding="16,0" HorizontalAlignment="Left" Style="{StaticResource Button}" Click="OpenIncoming_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="打开目录" /></Button>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Background="#46EAF3FF" BorderBrush="#A5CFE6F8" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="电脑发送目录" />
                            <TextBlock x:Name="OutgoingPathText" Grid.Row="2" FontSize="11" Foreground="#52708C" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button Grid.Row="4" Height="34" MinWidth="92" Padding="16,0" HorizontalAlignment="Left" Style="{StaticResource Button}" Click="OpenOutgoing_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="打开目录" /></Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="13" Text="手机上传的文件" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CardTitle}" FontSize="13" Text="电脑发送的文件" />
                </Grid>
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170">
                        <StackPanel x:Name="IncomingFilesList" />
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170">
                        <StackPanel x:Name="OutgoingFilesList" />
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="FileDropZone" Height="54" AllowDrop="True" DragOver="FileDropZone_DragOver" Drop="FileDropZone_Drop" Background="#26FFFFFF" BorderBrush="#9FD0E7F8" BorderThickness="1.5" CornerRadius="11" Padding="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#D8754E" Text="&#xE898;" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#52708C" Text="将文件拖到这里，自动发送到手机（手机端自动下载）" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" MinWidth="170" Style="{StaticResource Button}" Click="SendFile_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="选择文件发送…" /></Button>
                    <TextBlock x:Name="TransferStateText" Grid.Row="12" Margin="0,6,0,0" FontSize="11" Foreground="#7B93A8" TextWrapping="Wrap" Text="收到手机文件会显示在上方列表并弹出系统通知。" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
