<Window x:Class="ScreenshotApp.Capture.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:ScreenshotApp.Capture"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="选择截图区域"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp">
    <Window.Resources>
        <SolidColorBrush x:Key="AnnotationRedBrush" Color="#FF4D5E" />
        <SolidColorBrush x:Key="AnnotationBlueBrush" Color="#3E8BFF" />
        <SolidColorBrush x:Key="AnnotationYellowBrush" Color="#FFC847" />
        <SolidColorBrush x:Key="AnnotationWhiteBrush" Color="#FFFFFF" />

        <Style x:Key="AnnotationToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Foreground" Value="#27313D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#E2EDFB" />
                                <Setter Property="Foreground" Value="#185FBF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#7C8897" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Border Width="14" Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Tag}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#DCEAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Swatch" Fill="{TemplateBinding Background}" Stroke="#B8FFFFFF" StrokeThickness="1.2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Stroke" Value="#2D7DFF" /><Setter TargetName="Swatch" Property="StrokeThickness" Value="2.5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 录像设置沿用截图工具栏的轻玻璃质感，避免系统右键菜单的割裂感。 -->
        <Style x:Key="RecordingOptionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#344255" />
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="BorderBrush" Value="#D7E1EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#E8F1FF" />
                                <Setter TargetName="Background" Property="BorderBrush" Value="#8CB8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionResizeHandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Width="14" Height="14" Background="Transparent">
                            <Border Width="8" Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F8FBFD"
                                    BorderBrush="#2D7DFF"
                                    BorderThickness="1.5"
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1C5FB8" BlurRadius="4" ShadowDepth="0" Opacity="0.45" />
                                </Border.Effect>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="CaptureSurface"
          ClipToBounds="True"
          Focusable="True"
          MouseLeftButtonDown="CaptureSurface_MouseLeftButtonDown"
          MouseMove="CaptureSurface_MouseMove"
          MouseLeftButtonUp="CaptureSurface_MouseLeftButtonUp">
        <Image x:Name="ScreenshotImage" Stretch="Fill" SnapsToDevicePixels="True" />

        <Canvas x:Name="AnnotationCanvas"
                Visibility="Collapsed"
                Background="Transparent"
                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                MouseMove="AnnotationCanvas_MouseMove"
                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp" />

        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="#8A0B1020" />
            <Rectangle x:Name="MaskLeft" Fill="#8A0B1020" />
            <Rectangle x:Name="MaskRight" Fill="#8A0B1020" />
            <Rectangle x:Name="MaskBottom" Fill="#8A0B1020" />

            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#4D95FF"
                    BorderThickness="2"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect Color="#2D7DFF" BlurRadius="8" ShadowDepth="0" Opacity="0.72" />
                </Border.Effect>
            </Border>

            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Padding="8,4"
                    Background="#E619202B"
                    CornerRadius="5">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>

        <Canvas x:Name="SelectionResizeLayer" Visibility="Collapsed">
            <primitives:Thumb x:Name="TopLeftResizeHandle" Tag="TopLeft" Cursor="SizeNWSE"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="TopResizeHandle" Tag="Top" Cursor="SizeNS"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="TopRightResizeHandle" Tag="TopRight" Cursor="SizeNESW"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="RightResizeHandle" Tag="Right" Cursor="SizeWE"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="BottomRightResizeHandle" Tag="BottomRight" Cursor="SizeNWSE"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="BottomResizeHandle" Tag="Bottom" Cursor="SizeNS"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="BottomLeftResizeHandle" Tag="BottomLeft" Cursor="SizeNESW"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
            <primitives:Thumb x:Name="LeftResizeHandle" Tag="Left" Cursor="SizeWE"
                              Style="{StaticResource SelectionResizeHandleStyle}"
                              DragStarted="SelectionResizeHandle_DragStarted"
                              DragDelta="SelectionResizeHandle_DragDelta"
                              DragCompleted="SelectionResizeHandle_DragCompleted" />
        </Canvas>

        <Border x:Name="HintPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="14,8"
                Background="#E819202B"
                CornerRadius="7"
                IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13"
                       Text="拖动框选截图区域  ·  Enter / 双击确认  ·  Esc / 右键取消" />
        </Border>

        <Border x:Name="ActionToolbar"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="5"
                Background="#F4F8FBFF"
                BorderBrush="#D8AFC4DD"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#263B56" BlurRadius="22" ShadowDepth="5" Opacity="0.34" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PenToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="PenToolButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontSize="14" Text="✎" />
                        <TextBlock VerticalAlignment="Center" Text="涂鸦" />
                        <TextBlock Margin="5,1,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#718096" Text="⌄" />
                    </StackPanel>
                </Button>
                <Button x:Name="ShapeToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="ShapeToolButton_Click"
                        ToolTip="选择形状">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" BorderBrush="#334255" BorderThickness="2" CornerRadius="1" />
                        <TextBlock VerticalAlignment="Center" Text="形状" />
                    </StackPanel>
                </Button>
                <Button x:Name="OcrToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="OcrToolButton_Click"
                        ToolTip="在本机识别框选区域内的文字">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontSize="14" FontWeight="SemiBold" Text="文" />
                        <TextBlock x:Name="OcrToolButtonText" VerticalAlignment="Center" Text="提取文字" />
                    </StackPanel>
                </Button>
                <Button x:Name="TranslationToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="TranslationToolButton_Click"
                        ToolTip="先在本机识别英文，再离线翻译为中文">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontSize="14" FontWeight="SemiBold" Text="译" />
                        <TextBlock x:Name="TranslationToolButtonText" VerticalAlignment="Center" Text="翻译" />
                    </StackPanel>
                </Button>
                <Button x:Name="LongCaptureButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="LongCaptureButton_Click"
                        ToolTip="使用当前框选区域开始手动滚动长截图">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE74A;" />
                        <TextBlock VerticalAlignment="Center" Text="长截图" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordingToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="RecordingToolButton_Click"
                        ToolTip="录制当前框选区域">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontSize="16" Foreground="#E04C5B" Text="●" />
                        <TextBlock VerticalAlignment="Center" Text="录像" />
                    </StackPanel>
                </Button>
                <Button x:Name="StickerToolButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Click="StickerToolButton_Click"
                        ToolTip="将当前框选区域作为可拖动贴图留在桌面上">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8A5;" />
                        <TextBlock VerticalAlignment="Center" Text="贴图" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Margin="4,0,7,0"
                        VerticalAlignment="Center" Background="#CCD5E0" />

                <Button x:Name="UndoButton" Width="38"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Padding="4,0" Margin="4,0,3,0"
                        Content="↶" FontSize="18" ToolTip="撤销"
                        IsEnabled="False" Click="UndoButton_Click" />

                <Border Width="1" Height="20" Margin="4,0,7,0"
                        VerticalAlignment="Center" Background="#CCD5E0" />

                <Button Width="56" Height="32" Margin="0,0,4,0" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background" Background="Transparent" CornerRadius="5">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3F4A58" Text="取消" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#E3EAF2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="ConfirmButton" Width="86" Height="32" Content="复制截图"
                        Click="CopyButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background" Background="#2D7DFF" CornerRadius="5">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="SemiBold"
                                           Text="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#438BFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#2469D9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="PenOptionsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="12" Background="#EEF8FBFF" BorderBrush="#C9DCEB" BorderThickness="1" CornerRadius="10">
            <Border.Effect><DropShadowEffect Color="#263B56" BlurRadius="16" ShadowDepth="4" Opacity="0.28" /></Border.Effect>
            <StackPanel Width="270">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334255" Text="颜色" />
                <WrapPanel Margin="0,8,0,8">
                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF4D5E" Tag="#FF4D5E" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF7A45" Tag="#FF7A45" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFC847" Tag="#FFC847" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#B8E94E" Tag="#B8E94E" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#35B779" Tag="#35B779" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#2ED3E6" Tag="#2ED3E6" Click="ColorButton_Click" />
                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#3E8BFF" Tag="#3E8BFF" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#5167E8" Tag="#5167E8" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#8A62F5" Tag="#8A62F5" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#C75CEA" Tag="#C75CEA" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EC70C8" Tag="#EC70C8" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFB4E6" Tag="#FFB4E6" Click="ColorButton_Click" />
                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#E0E7EF" Tag="#E0E7EF" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#9CA9B8" Tag="#9CA9B8" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#596779" Tag="#596779" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#202833" Tag="#202833" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#8B5E3C" Tag="#8B5E3C" Click="ColorButton_Click" />
                </WrapPanel>
                <Border Height="1" Margin="0,10,0,9" Background="#C9D8E7" />
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334255" Text="大小" />
                <Path x:Name="StrokePreviewPath" Margin="4,7,4,3" Stroke="#FF4D5E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,16 C 38,0 70,32 110,16 S 180,30 230,4" />
                <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="12" Value="4" ValueChanged="ThicknessSlider_ValueChanged" />
            </StackPanel>
        </Border>

        <Border x:Name="ShapeOptionsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="10" Background="#EAF7FCFF" BorderBrush="#B8D9EC" BorderThickness="1" CornerRadius="11">
            <Border.Effect><DropShadowEffect Color="#263B56" BlurRadius="20" ShadowDepth="5" Opacity="0.32" /></Border.Effect>
            <StackPanel Width="360">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Rectangle" Click="ShapeOptionButton_Click" ToolTip="矩形" Content="□" FontSize="26" />
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Ellipse" Click="ShapeOptionButton_Click" ToolTip="圆形" Content="○" FontSize="28" />
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Diamond" Click="ShapeOptionButton_Click" ToolTip="菱形" Content="◇" FontSize="28" />
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Triangle" Click="ShapeOptionButton_Click" ToolTip="三角形" Content="△" FontSize="27" />
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Arrow" Click="ShapeOptionButton_Click" ToolTip="箭头" Content="→" FontSize="25" />
                    <Button Style="{StaticResource AnnotationToolButtonStyle}" Width="52" Height="44" Tag="Line" Click="ShapeOptionButton_Click" ToolTip="横线" Content="—" FontSize="28" />
                </StackPanel>
                <Border Height="1" Margin="4,8" Background="#C9D8E7" />
                <TextBlock Margin="4,0,0,5" FontSize="13" FontWeight="SemiBold" Foreground="#334255" Text="颜色" />
                <WrapPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF4D5E" Tag="#FF4D5E" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FF7A45" Tag="#FF7A45" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFC847" Tag="#FFC847" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#B8E94E" Tag="#B8E94E" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#35B779" Tag="#35B779" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#3E8BFF" Tag="#3E8BFF" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#8A62F5" Tag="#8A62F5" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EC70C8" Tag="#EC70C8" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="ColorButton_Click" /><Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#596779" Tag="#596779" Click="ColorButton_Click" />
                </WrapPanel>
                <Border Height="1" Margin="4,8" Background="#C9D8E7" />
                <TextBlock Margin="4,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="#334255" Text="大小" />
                <Path x:Name="ShapeStrokePreviewPath" Margin="14,4,14,1" Stroke="#FF4D5E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,16 C 50,0 100,32 155,16 S 250,30 320,4" />
                <Slider x:Name="ShapeThicknessSlider" Margin="12,0,12,0" Minimum="2" Maximum="12" Value="4" ValueChanged="ShapeThicknessSlider_ValueChanged" />
            </StackPanel>
        </Border>

        <!-- 默认紧贴主工具栏下方横向展开；所有控制均在选区外完成。 -->
        <Border x:Name="RecordingOptionsPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="6"
                Background="#F4F8FBFF"
                BorderBrush="#D8AFC4DD"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#263B56" BlurRadius="18" ShadowDepth="4" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SystemAudioOptionButton"
                        Style="{StaticResource RecordingOptionButtonStyle}"
                        Click="SystemAudioOptionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontFamily="Segoe Fluent Icons" Text="&#xE767;" />
                        <TextBlock x:Name="SystemAudioOptionText" Text="电脑声音：关" />
                    </StackPanel>
                </Button>
                <Button x:Name="MicrophoneOptionButton"
                        Style="{StaticResource RecordingOptionButtonStyle}"
                        Click="MicrophoneOptionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" FontFamily="Segoe Fluent Icons" Text="&#xE720;" />
                        <TextBlock x:Name="MicrophoneOptionText" Text="麦克风：关" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="20" Margin="3,0,7,0" VerticalAlignment="Center" Background="#CCD5E0" />
                <Button Width="82" Height="30" Click="StartRecordingButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background" Background="#E94D5D" CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="开始录像" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#F15E6B" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#CC3D4C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <Canvas x:Name="ColorPickerLayer" IsHitTestVisible="False">
            <Grid x:Name="ColorPickerPanel"
                  Width="150"
                  Height="178"
                  Visibility="Collapsed">
                <Border Width="140"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#F8FBFDFF"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="4"
                        CornerRadius="70">
                    <Border.Effect>
                        <DropShadowEffect Color="#162233" BlurRadius="18" ShadowDepth="5" Opacity="0.45" />
                    </Border.Effect>
                    <capture:PixelMagnifier x:Name="ColorPixelMagnifier"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                </Border>

                <Border Width="132"
                        MinHeight="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Padding="9,6"
                        Background="#F8FBFDFF"
                        BorderBrush="#C8D8E9"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#263B56" BlurRadius="14" ShadowDepth="3" Opacity="0.28" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorPickerSwatch"
                                Width="20" Height="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="White"
                                BorderBrush="#8493A5"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ColorHexText"
                                       Foreground="#1F2935"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="#FFFFFF" />
                            <TextBlock x:Name="ColorRgbText"
                                       Margin="0,1,0,0"
                                       Foreground="#667486"
                                       FontSize="9.5"
                                       Text="RGB 255, 255, 255" />
                            <TextBlock x:Name="ColorPickerHintText"
                                       Margin="0,2,0,0"
                                       Foreground="#2F75D8"
                                       FontSize="9.5"
                                       Text="单击复制 HEX" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
