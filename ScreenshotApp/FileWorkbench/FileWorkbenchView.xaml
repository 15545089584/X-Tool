<UserControl x:Class="ScreenshotApp.FileWorkbench.FileWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FileCard" TargetType="Border">
            <Setter Property="Background" Value="#76FFFFFF" /><Setter Property="BorderBrush" Value="#A8D6E9F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="15" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#476581" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileButton" TargetType="Button">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="15,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileActionButton" TargetType="Button" BasedOn="{StaticResource FileButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="FileTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#3E5C78" /><Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /><Setter TargetName="Root" Property="BorderThickness" Value="1.5" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E4F1FFFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#C9DEFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="FontSize" Value="12" /><Setter Property="ItemContainerStyle" Value="{StaticResource FileComboBoxItem}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10"><Grid><ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="#405F7C" /><TextBlock HorizontalAlignment="Right" Margin="0,0,11,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E4F1FFFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F2FAFFFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="200" CanContentScroll="True"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#78FFFFFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#B8DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileColumnHeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="6,5" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#6683A0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#78DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.68" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileGlassProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" /><Setter Property="Background" Value="#7AFFFFFF" /><Setter Property="BorderBrush" Value="#85CDE6F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#4D7CFE" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" ClipToBounds="True" SnapsToDevicePixels="True"><Border x:Name="Indicator" Width="0" HorizontalAlignment="Left" CornerRadius="5" Opacity="0.95"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#638DB6FF" /><GradientStop Offset="0.46" Color="#FF4D7CFE" /><GradientStop Offset="1" Color="#8B58D9FF" /></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.28" Color="#4D7CFE" /></Border.Effect><Border.RenderTransform><TranslateTransform x:Name="IndicatorTransform" X="-180" /></Border.RenderTransform></Border></Border><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="Indicator" Property="Width" Value="158" /><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="X" From="-180" To="1600" Duration="0:0:2.25" /></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileGlassScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Margin" Value="3,7,3,7" /><Setter Property="Background" Value="#38D3E5F5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#89A9C7E5" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource FileGlassScrollBar}" />
    </UserControl.Resources>
    <Grid Margin="44,42,52,38">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="文件工作台" />
            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#728195" Text="批量整理、改名与本地文件搜索；执行前会先生成预览，不会直接修改文件。" />
        </StackPanel>
        <Border Grid.Row="2" Padding="14" Style="{StaticResource FileCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SourceFolderTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="选择一个文件夹开始" TextChanged="SourceFolderTextBox_TextChanged" />
                <Button Grid.Column="2" Style="{StaticResource FileButton}" Content="选择文件夹" Click="SelectSourceFolder_Click" />
                <Button Grid.Column="4" Style="{StaticResource FileButton}" Content="打开文件夹" Click="OpenSourceFolder_Click" />
                <Button Grid.Column="6" Style="{StaticResource FileActionButton}" Click="SearchFiles_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="开始搜索" /></Button>
            </Grid>
        </Border>
        <Border x:Name="SearchProgressPanel" Grid.Row="4" Padding="12,9" Background="#54FFFFFF" BorderBrush="#8ED6E9F8" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#4D7CFE" Text="&#xE9F5;" />
                <StackPanel Grid.Column="2">
                    <ProgressBar x:Name="SearchProgressBar" IsIndeterminate="True" Style="{StaticResource FileGlassProgressBar}" />
                    <TextBlock x:Name="SearchProgressSummaryText" Margin="0,7,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#45627E" Text="正在准备本地文件搜索…" />
                    <TextBlock x:Name="SearchProgressPathText" Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" PanningMode="VerticalOnly">
            <Grid MinHeight="620" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                <Border Padding="16" Style="{StaticResource FileCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="文件搜索" />
                            <TextBlock x:Name="SearchSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="请选择文件夹" />
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="118" /><ColumnDefinition Width="10" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
                            <Grid><TextBox x:Name="KeywordTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="" ToolTip="输入文件名关键词后按 Enter，或点击顶部的开始搜索" TextChanged="KeywordTextBox_TextChanged" KeyDown="KeywordTextBox_KeyDown" /><TextBlock x:Name="KeywordPlaceholderText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#8196AB" IsHitTestVisible="False" Text="输入文件名关键词" /></Grid>
                            <ComboBox x:Name="TypeFilterComboBox" Grid.Column="2" Height="38" Style="{StaticResource FileComboBox}" SelectedIndex="0" ToolTip="文件类型"><ComboBoxItem>全部</ComboBoxItem><ComboBoxItem>图片</ComboBoxItem><ComboBoxItem>视频</ComboBoxItem><ComboBoxItem>音频</ComboBoxItem><ComboBoxItem>文档</ComboBoxItem><ComboBoxItem>压缩包</ComboBoxItem><ComboBoxItem>其他</ComboBoxItem></ComboBox>
                            <ComboBox x:Name="ModifiedFilterComboBox" Grid.Column="4" Height="38" Style="{StaticResource FileComboBox}" SelectedIndex="0" ToolTip="修改时间"><ComboBoxItem Tag="">不限时间</ComboBoxItem><ComboBoxItem Tag="1">最近 24 小时</ComboBoxItem><ComboBoxItem Tag="7">最近 7 天</ComboBoxItem><ComboBoxItem Tag="30">最近 30 天</ComboBoxItem><ComboBoxItem Tag="365">最近一年</ComboBoxItem></ComboBox>
                        </Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="88" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                            <Button x:Name="NameColumnHeaderButton" Padding="6,5" Style="{StaticResource FileColumnHeaderButton}" Tag="Name" ToolTip="点击按文件名升序或降序排序" Click="SortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock FontSize="10" Text="文件名" /><TextBlock x:Name="NameSortIndicatorText" Margin="5,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" /></StackPanel></Button>
                            <Button x:Name="ExtensionColumnHeaderButton" Grid.Column="1" Style="{StaticResource FileColumnHeaderButton}" Tag="Extension" ToolTip="点击按文件类型升序或降序排序" Click="SortColumnHeader_Click"><StackPanel HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="10" Text="类型" /><TextBlock x:Name="ExtensionSortIndicatorText" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" /></StackPanel></Button>
                            <Button x:Name="SizeColumnHeaderButton" Grid.Column="2" Style="{StaticResource FileColumnHeaderButton}" Tag="Size" ToolTip="点击按文件大小升序或降序排序" HorizontalContentAlignment="Right" Click="SortColumnHeader_Click"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock FontSize="10" Text="大小" /><TextBlock x:Name="SizeSortIndicatorText" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" /></StackPanel></Button>
                            <Button x:Name="ModifiedColumnHeaderButton" Grid.Column="3" Style="{StaticResource FileColumnHeaderButton}" Tag="Modified" ToolTip="点击按修改时间升序或降序排序" HorizontalContentAlignment="Right" Click="SortColumnHeader_Click"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock FontSize="10" Text="修改时间" /><TextBlock x:Name="ModifiedSortIndicatorText" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" /></StackPanel></Button>
                        </Grid>
                        <Border Grid.Row="6" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11">
                            <ListBox x:Name="FileResultsListBox" Margin="8" Style="{StaticResource FileListBox}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="88" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#3F5E7C" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" /><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding ExtensionText}" /><TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding SizeText}" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ModifiedText}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="16" Style="{StaticResource FileCard}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="批处理" />
                        <StackPanel Grid.Row="2">
                            <ComboBox x:Name="BatchOperationComboBox" Height="38" Style="{StaticResource FileComboBox}" SelectedIndex="0" SelectionChanged="BatchOperationComboBox_SelectionChanged"><ComboBoxItem Tag="Rename">批量重命名</ComboBoxItem><ComboBoxItem Tag="ChangeExtension">修改后缀</ComboBoxItem><ComboBoxItem Tag="Classify">按类型分类</ComboBoxItem><ComboBoxItem Tag="Move">批量移动</ComboBoxItem></ComboBox>
                            <TextBox x:Name="RenamePrefixTextBox" Margin="0,8,0,0" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="旅行照片" ToolTip="命名前缀" />
                            <Grid x:Name="RenameNumberRow" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="15" /><RowDefinition Height="36" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Margin="2,0,0,0" FontSize="10" Foreground="#6683A0" Text="起始编号" /><TextBlock Grid.Column="2" Margin="2,0,0,0" FontSize="10" Foreground="#6683A0" Text="编号位数（1-6）" /><TextBox x:Name="StartNumberTextBox" Grid.Row="1" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="1" ToolTip="起始编号" /><TextBox x:Name="NumberDigitsTextBox" Grid.Row="1" Grid.Column="2" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="3" ToolTip="编号位数，范围 1-6" /></Grid>
                            <TextBox x:Name="NewExtensionTextBox" Margin="0,8,0,0" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="jpg" ToolTip="新后缀，如 jpg" />
                            <Grid x:Name="DestinationRow" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><TextBox x:Name="DestinationFolderTextBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource FileTextBox}" Text="选择分类或移动目标" /><Button Grid.Column="2" Style="{StaticResource FileButton}" Content="浏览" Click="SelectDestinationFolder_Click" /></Grid>
                            <Button Margin="0,10,0,0" Style="{StaticResource FileButton}" Content="生成操作预览" Click="GeneratePreview_Click" />
                        </StackPanel>
                        <Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="PreviewListBox" Margin="8" Style="{StaticResource FileListBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,5"><TextBlock FontSize="11" Foreground="#45627E" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#708AA2" Text="{Binding DestinationText}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions><TextBlock x:Name="BatchStatusText" VerticalAlignment="Center" FontSize="11" Foreground="#607E9A" TextWrapping="Wrap" /><Button Grid.Column="2" Style="{StaticResource FileActionButton}" Click="ExecuteBatch_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="确认执行" /></Button></Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
