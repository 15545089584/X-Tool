<UserControl x:Class="ScreenshotApp.FileWorkbench.FileWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FileCard" TargetType="Border">
            <Setter Property="Background" Value="#76FFFFFF" /><Setter Property="BorderBrush" Value="#A8D6E9F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="15" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#476581" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileButton" TargetType="Button">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="15,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileActionButton" TargetType="Button" BasedOn="{StaticResource FileButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
    </UserControl.Resources>
    <Grid Margin="44,42,52,38">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="文件工作台" />
            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#728195" Text="批量整理、改名与本地文件搜索；执行前会先生成预览，不会直接修改文件。" />
        </StackPanel>
        <Border Grid.Row="2" Padding="14" Style="{StaticResource FileCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="12" /><ColumnDefinition Width="130" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SourceFolderTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Background="#AFFFFFFF" BorderBrush="#B8D4E8F5" BorderThickness="1" Text="选择一个文件夹开始" TextChanged="SourceFolderTextBox_TextChanged" />
                <Button Grid.Column="2" Style="{StaticResource FileButton}" Content="选择文件夹" Click="SelectSourceFolder_Click" />
                <Button Grid.Column="4" Style="{StaticResource FileButton}" Content="打开文件夹" Click="OpenSourceFolder_Click" />
                <Button Grid.Column="6" Style="{StaticResource FileActionButton}" Content="开始搜索" Click="SearchFiles_Click" />
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="16" Style="{StaticResource FileCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="文件搜索" />
                        <TextBlock x:Name="SearchSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="请选择文件夹" />
                    </Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="88" /><ColumnDefinition Width="88" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="KeywordTextBox" Height="36" Margin="0,0,8,0" Padding="10,0" VerticalContentAlignment="Center" Background="#AFFFFFFF" BorderBrush="#B8D4E8F5" Text="" ToolTip="按文件名搜索" />
                        <ComboBox x:Name="TypeFilterComboBox" Grid.Column="1" Height="36" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem>全部</ComboBoxItem><ComboBoxItem>图片</ComboBoxItem><ComboBoxItem>视频</ComboBoxItem><ComboBoxItem>音频</ComboBoxItem><ComboBoxItem>文档</ComboBoxItem><ComboBoxItem>压缩包</ComboBoxItem><ComboBoxItem>其他</ComboBoxItem></ComboBox>
                        <TextBox x:Name="MinimumSizeTextBox" Grid.Column="2" Height="36" Margin="0,0,8,0" Padding="8,0" VerticalContentAlignment="Center" ToolTip="最小 MB" />
                        <TextBox x:Name="MaximumSizeTextBox" Grid.Column="3" Height="36" Margin="0,0,8,0" Padding="8,0" VerticalContentAlignment="Center" ToolTip="最大 MB" />
                        <ComboBox x:Name="ModifiedFilterComboBox" Grid.Column="4" Height="36" SelectedIndex="0"><ComboBoxItem Tag="">不限时间</ComboBoxItem><ComboBoxItem Tag="1">最近 24 小时</ComboBoxItem><ComboBoxItem Tag="7">最近 7 天</ComboBoxItem><ComboBoxItem Tag="30">最近 30 天</ComboBoxItem><ComboBoxItem Tag="365">最近一年</ComboBoxItem></ComboBox>
                    </Grid>
                    <Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11">
                        <ListBox x:Name="FileResultsListBox" Margin="8" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /><ColumnDefinition Width="76" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#3F5E7C" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" /><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding ExtensionText}" /><TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding SizeText}" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ModifiedText}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="16" Style="{StaticResource FileCard}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="批处理" />
                    <StackPanel Grid.Row="2">
                        <ComboBox x:Name="BatchOperationComboBox" Height="38" SelectedIndex="0" SelectionChanged="BatchOperationComboBox_SelectionChanged"><ComboBoxItem Tag="Rename">批量重命名</ComboBoxItem><ComboBoxItem Tag="ChangeExtension">修改后缀</ComboBoxItem><ComboBoxItem Tag="Classify">按类型分类</ComboBoxItem><ComboBoxItem Tag="Move">批量移动</ComboBoxItem></ComboBox>
                        <TextBox x:Name="RenamePrefixTextBox" Margin="0,8,0,0" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="旅行照片" ToolTip="命名前缀" />
                        <Grid x:Name="RenameNumberRow" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="StartNumberTextBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="1" ToolTip="起始编号" /><TextBox x:Name="NumberDigitsTextBox" Grid.Column="2" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="3" ToolTip="编号位数" /></Grid>
                        <TextBox x:Name="NewExtensionTextBox" Margin="0,8,0,0" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="jpg" ToolTip="新后缀，如 jpg" />
                        <Grid x:Name="DestinationRow" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><TextBox x:Name="DestinationFolderTextBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" Text="选择分类或移动目标" /><Button Grid.Column="2" Style="{StaticResource FileButton}" Content="浏览" Click="SelectDestinationFolder_Click" /></Grid>
                        <Button Margin="0,10,0,0" Style="{StaticResource FileButton}" Content="生成操作预览" Click="GeneratePreview_Click" />
                    </StackPanel>
                    <Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="PreviewListBox" Margin="8" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,5"><TextBlock FontSize="11" Foreground="#45627E" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#708AA2" Text="{Binding DestinationText}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions><TextBlock x:Name="BatchStatusText" VerticalAlignment="Center" FontSize="11" Foreground="#607E9A" TextWrapping="Wrap" /><Button Grid.Column="2" Style="{StaticResource FileActionButton}" Content="确认执行" Click="ExecuteBatch_Click" /></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
