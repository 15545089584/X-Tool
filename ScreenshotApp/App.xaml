<Application x:Class="ScreenshotApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="AppBackgroundColor">#EAF3FC</Color>
        <Color x:Key="PanelBackgroundColor">#E8F7FAFD</Color>
        <Color x:Key="SurfaceColor">#D9FFFFFF</Color>
        <Color x:Key="PrimaryColor">#2D7DFF</Color>
        <Color x:Key="PrimarySoftColor">#9FDDEAFF</Color>
        <Color x:Key="TextColor">#141A24</Color>
        <Color x:Key="SecondaryTextColor">#7A818D</Color>
        <Color x:Key="BorderColor">#A8FFFFFF</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <!-- 毛玻璃语义资源：系统背板可用时透出真实模糊，不可用时由渐变提供降级效果。 -->
        <LinearGradientBrush x:Key="WindowTintBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#CDEAF4FF" />
            <GradientStop Offset="0.52" Color="#BDF8FBFF" />
            <GradientStop Offset="1" Color="#D5F3F0FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#ADFFFFFF" />
            <GradientStop Offset="0.55" Color="#8DF8FBFF" />
            <GradientStop Offset="1" Color="#73ECF5FC" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#9EFFFFFF" />
            <GradientStop Offset="1" Color="#74E7F1FA" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#9CFFFFFF" />
            <GradientStop Offset="1" Color="#68EEF5FA" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#72FFFFFF" />
        <SolidColorBrush x:Key="GlassHoverBrush" Color="#E8FFFFFF" />
        <SolidColorBrush x:Key="GlassDividerBrush" Color="#6F9FAFC0" />
        <DropShadowEffect x:Key="GlassShadowEffect" BlurRadius="34" ShadowDepth="7"
                          Direction="270" Opacity="0.10" Color="#49657F" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#5E636B" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#78FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A8FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" />
                            <Border x:Name="Indicator" Width="3" Height="28" Margin="-10,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#9AA7DB" CornerRadius="2" Opacity="0" />
                            <ContentPresenter Margin="4,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#6FFFFFFF" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#86FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#CFFFFFFF" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#E6FFFFFF" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C5E0EDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D5D4E5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#8FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="ActionCardStyle" TargetType="Button">
            <Setter Property="Height" Value="138" />
            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#536C86" />
                            </Border.Effect>
                            <ContentPresenter Margin="26,20" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D2E7F4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#CFE4F0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
