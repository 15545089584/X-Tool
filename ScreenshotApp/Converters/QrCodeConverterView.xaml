<UserControl x:Class="ScreenshotApp.Converters.QrCodeConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#74FFFFFF" /><Setter Property="BorderBrush" Value="#A9D7EAF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#456581" /></Setter.Value></Setter></Style>
        <Style x:Key="QrGlassScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="9" /><Setter Property="Margin" Value="3,7,3,7" /><Setter Property="Background" Value="#38D3E5F5" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#89A9C7E5" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Background" Value="#BFFFFFFF" /><Setter Property="BorderBrush" Value="#A8CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="13" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources></ScrollViewer></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Button" TargetType="Button"><Setter Property="Height" Value="46" /><Setter Property="Padding" Value="24,0" /><Setter Property="Background" Value="#A8FFFFFF" /><Setter Property="BorderBrush" Value="#9FD0E7F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#42617D" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#4E7191" /></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFAFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#78A9E7FF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.78" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#8AAEFF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Background" Value="#FFF2F2" /><Setter Property="BorderBrush" Value="#F3B9B9" /><Setter Property="Foreground" Value="#B74444" /></Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Height" Value="48" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="MinWidth" Value="112" /></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#526F8B" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
        <Style x:Key="SwatchButton" TargetType="Button"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Width="26" Height="26" Background="{TemplateBinding Background}" BorderBrush="#5A8AA9C4" BorderThickness="2" CornerRadius="7" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.75" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CategoryBadge" TargetType="Border"><Setter Property="Padding" Value="10,4" /><Setter Property="CornerRadius" Value="9" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="14,0" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource SmallButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#8AAEFF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="SingleLineInput" TargetType="TextBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Padding" Value="14,0" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="QrGlassCheckBox" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="20" Height="20" Background="#BFFFFFFF" BorderBrush="#9FC6D4E3" BorderThickness="1" CornerRadius="6"><Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#36506A" /></Border.Effect><Path x:Name="Check" Margin="3" Data="M1.5,4.5 L5,8 L11.5,1.5" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" /></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4D7CFE" /><Setter TargetName="Box" Property="BorderBrush" Value="#7EA8F7" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ConverterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#BFFFFFFF" />
            <Setter Property="BorderBrush" Value="#ABCBE7F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#405D78" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="13,10" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#405D78" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CEE0FF" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="#ABCBE7F8" BorderThickness="1" CornerRadius="11"><Grid><ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><TextBlock HorizontalAlignment="Right" Margin="0,0,13,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#6082A7" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF3FF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F4FBFFFF" BorderBrush="#B5D1E9FA" BorderThickness="1" CornerRadius="11"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="190" CanContentScroll="True"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConverterSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="#4D7CFE" />
            <Setter Property="Background" Value="#D9E5EFF8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Border Height="6" VerticalAlignment="Center" Background="#D9E5EFF8" BorderBrush="#B8D2E6F4" BorderThickness="1" CornerRadius="3" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton><RepeatButton IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F7FCFFFF" BorderBrush="#77A7D6FF" BorderThickness="2" CornerRadius="9"><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#416D9B" /></Border.Effect></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="GenerateModeButton" Style="{StaticResource ModeButton}" Tag="Generate" Click="ModeButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="生成二维码" /></Button>
            <Button x:Name="DecodeModeButton" Style="{StaticResource ModeButton}" Tag="Decode" Click="ModeButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="识别二维码" /></Button>
            <Button x:Name="HistoryModeButton" Style="{StaticResource ModeButton}" Tag="History" Click="ModeButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="历史记录" /></Button>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- 生成面板 -->
            <Grid x:Name="GeneratePanel">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources>
                    <StackPanel>
                    <Border Padding="16" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="内容类型" />
                            <ComboBox x:Name="ContentTypeComboBox" Margin="0,10,0,0" Style="{StaticResource ConverterComboBoxStyle}" SelectionChanged="ContentTypeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="FreeText" IsSelected="True">自由文本 / 网址</ComboBoxItem>
                                <ComboBoxItem Tag="Wifi">WiFi 网络</ComboBoxItem>
                                <ComboBoxItem Tag="VCard">名片 vCard</ComboBoxItem>
                                <ComboBoxItem Tag="Email">邮件</ComboBoxItem>
                                <ComboBoxItem Tag="Sms">电话 / 短信</ComboBoxItem>
                                <ComboBoxItem Tag="Batch">批量生成</ComboBoxItem>
                            </ComboBox>

                            <Grid Margin="0,12,0,0">
                                <!-- 自由文本 -->
                                <Grid x:Name="FreeTextFields">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="输入文本或网址" />
                                    <TextBox x:Name="FreeTextInput" Grid.Row="2" MinHeight="110" MaxHeight="240" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ContentInput_TextChanged" />
                                </Grid>
                                <!-- WiFi -->
                                <Grid x:Name="WifiFields" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#6C849B" Text="可一键读取电脑当前连接的 WiFi" />
                                        <Button HorizontalAlignment="Right" Height="40" MinWidth="120" Padding="20,0" Style="{StaticResource SmallActionButton}" Click="ReadCurrentWifi_Click"><TextBlock Margin="2,0" Foreground="White" Text="读取当前 WiFi" /></Button>
                                    </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="网络名称 SSID" /><TextBox x:Name="WifiSsidInput" Style="{StaticResource Input}" Height="46" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="加密方式" /><ComboBox x:Name="WifiAuthComboBox" Style="{StaticResource ConverterComboBoxStyle}" Height="46" SelectionChanged="Parameter_Changed"><ComboBoxItem Tag="WPA" IsSelected="True">WPA / WPA2（推荐）</ComboBoxItem><ComboBoxItem Tag="WEP">WEP</ComboBoxItem><ComboBoxItem Tag="Open">无密码</ComboBoxItem></ComboBox></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="4"><TextBlock Style="{StaticResource FieldLabel}" Text="密码（无密码可留空）" /><TextBox x:Name="WifiPasswordInput" Style="{StaticResource Input}" Height="46" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                    <TextBlock Grid.Row="6" FontSize="11" Foreground="#6C849B" Text="手机扫码后可直接连接该网络" />
                                </Grid>
                                <!-- vCard -->
                                <Grid x:Name="VCardFields" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="姓名" /><TextBox x:Name="VCardNameInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="电话" /><TextBox x:Name="VCardPhoneInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="邮箱" /><TextBox x:Name="VCardEmailInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="公司" /><TextBox x:Name="VCardCompanyInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="职位" /><TextBox x:Name="VCardTitleInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="网址" /><TextBox x:Name="VCardUrlInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- 邮件 -->
                                <Grid x:Name="EmailFields" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="收件人" /><TextBox x:Name="EmailToInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource FieldLabel}" Text="主题" /><TextBox x:Name="EmailSubjectInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                    <StackPanel Grid.Row="4"><TextBlock Style="{StaticResource FieldLabel}" Text="正文" /><TextBox x:Name="EmailBodyInput" Style="{StaticResource Input}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                </Grid>
                                <!-- 电话/短信 -->
                                <Grid x:Name="SmsFields" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="电话号码" /><TextBox x:Name="SmsPhoneInput" Style="{StaticResource Input}" Height="42" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource FieldLabel}" Text="短信内容（可留空，仅拨打）" /><TextBox x:Name="SmsBodyInput" Style="{StaticResource Input}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ContentInput_TextChanged" /></StackPanel>
                                </Grid>
                                <!-- 批量 -->
                                <Grid x:Name="BatchFields" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="每行一条内容，支持「名称|内容」指定文件名" />
                                    <TextBox x:Name="BatchInput" Grid.Row="2" MinHeight="110" MaxHeight="240" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ContentInput_TextChanged" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="16" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="生成参数" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="纠错等级" />
                                    <ComboBox x:Name="ErrorLevelComboBox" Style="{StaticResource ConverterComboBoxStyle}" Height="42" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Tag="L">L · 约 7% 可恢复</ComboBoxItem>
                                        <ComboBoxItem Tag="M" IsSelected="True">M · 约 15% 可恢复</ComboBoxItem>
                                        <ComboBoxItem Tag="Q">Q · 约 25% 可恢复</ComboBoxItem>
                                        <ComboBoxItem Tag="H">H · 约 30% 可恢复</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="像素尺寸" /><TextBlock x:Name="SizeValueText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#507AB3" /></Grid>
                                    <Slider x:Name="SizeSlider" Style="{StaticResource ConverterSliderStyle}" Minimum="256" Maximum="1024" Value="512" TickFrequency="64" IsSnapToTickEnabled="False" ValueChanged="Parameter_Changed" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid><TextBlock Style="{StaticResource FieldLabel}" Text="留白（模块）" /><TextBlock x:Name="MarginValueText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#507AB3" /></Grid>
                                    <Slider x:Name="MarginSlider" Style="{StaticResource ConverterSliderStyle}" Minimum="0" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Parameter_Changed" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="前景色" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SwatchButton}" Tag="#000000" Background="#1A1A1A" Click="ForegroundSwatch_Click" ToolTip="黑色" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#1F3864" Background="#1F3864" Click="ForegroundSwatch_Click" ToolTip="深蓝" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#0F5E5E" Background="#0F5E5E" Click="ForegroundSwatch_Click" ToolTip="深青" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#4B2E83" Background="#4B2E83" Click="ForegroundSwatch_Click" ToolTip="深紫" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#1E6B3A" Background="#1E6B3A" Click="ForegroundSwatch_Click" ToolTip="深绿" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#7A2E2E" Background="#7A2E2E" Click="ForegroundSwatch_Click" ToolTip="深红" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#5C3A21" Background="#5C3A21" Click="ForegroundSwatch_Click" ToolTip="深棕" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#3A3A3A" Background="#3A3A3A" Click="ForegroundSwatch_Click" ToolTip="深灰" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#162B4D" Background="#162B4D" Click="ForegroundSwatch_Click" ToolTip="藏蓝" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#7A4A1F" Background="#7A4A1F" Click="ForegroundSwatch_Click" ToolTip="深橙" />
                                        <TextBox x:Name="ForegroundHexInput" Width="112" Height="34" Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource Input}" Text="#000000" LostFocus="ForegroundHexInput_LostFocus" ToolTip="HEX 颜色，如 #1F3864" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="背景色" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SwatchButton}" Tag="#FFFFFF" Background="White" Click="BackgroundSwatch_Click" ToolTip="白色" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#F2F4F7" Background="#F2F4F7" Click="BackgroundSwatch_Click" ToolTip="浅灰" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#FFF7E0" Background="#FFF7E0" Click="BackgroundSwatch_Click" ToolTip="浅黄" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#EAF3FF" Background="#EAF3FF" Click="BackgroundSwatch_Click" ToolTip="浅蓝" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#EAFBF0" Background="#EAFBF0" Click="BackgroundSwatch_Click" ToolTip="浅绿" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#FFF0F0" Background="#FFF0F0" Click="BackgroundSwatch_Click" ToolTip="浅粉" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#F3EFFF" Background="#F3EFFF" Click="BackgroundSwatch_Click" ToolTip="浅紫" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#EAF7F7" Background="#EAF7F7" Click="BackgroundSwatch_Click" ToolTip="浅青" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#FBF7EF" Background="#FBF7EF" Click="BackgroundSwatch_Click" ToolTip="浅米" />
                                        <Button Style="{StaticResource SwatchButton}" Tag="#FFF0F4" Background="#FFF0F4" Click="BackgroundSwatch_Click" ToolTip="浅玫红" />
                                        <TextBox x:Name="BackgroundHexInput" Width="112" Height="34" Padding="8,0" VerticalContentAlignment="Center" Style="{StaticResource Input}" Text="#FFFFFF" LostFocus="BackgroundHexInput_LostFocus" ToolTip="HEX 颜色，如 #EAF3FF" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Padding="18" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="实时预览" />
                        <Border Grid.Row="2" Background="White" BorderBrush="#D8E7F4" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <Image x:Name="QrPreviewImage" MaxWidth="420" MaxHeight="420" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock x:Name="QrPreviewEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#9AADBF" Text="输入内容后在此预览" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="PreviewInfoText" FontSize="12" Foreground="#63809C" Text="等待输入内容" TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewErrorText" Margin="0,6,0,0" FontSize="12" Foreground="#C0504D" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SaveQrButton" MinWidth="126" Padding="28,0" Style="{StaticResource ActionButton}" Click="SaveQr_Click"><TextBlock Margin="2,0" Foreground="White" Text="保存 PNG" /></Button>
                                <Button x:Name="CopyQrButton" Margin="10,0,0,0" MinWidth="126" Padding="28,0" Style="{StaticResource Button}" Click="CopyQr_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="复制图片" /></Button>
                                <Button x:Name="SaveBatchButton" Margin="10,0,0,0" MinWidth="144" Padding="32,0" Style="{StaticResource Button}" Visibility="Collapsed" Click="SaveBatch_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="批量保存…" /></Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 识别面板 -->
            <Grid x:Name="DecodePanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="16" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SelectImagesButton" MinWidth="120" Padding="26,0" Style="{StaticResource ActionButton}" Click="SelectImages_Click"><TextBlock Foreground="White" Text="选择图片" /></Button>
                            <Button Margin="12,0,0,0" MinWidth="128" Padding="26,0" Style="{StaticResource Button}" Click="DecodeClipboard_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="从剪贴板识别" /></Button>
                            <Button x:Name="CancelDecodeButton" Margin="12,0,0,0" MinWidth="110" Padding="26,0" Style="{StaticResource DangerButton}" Visibility="Collapsed" Click="CancelDecode_Click" Content="取消识别" />
                        </StackPanel>
                        <TextBlock x:Name="DecodeStatusText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#63809C" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Padding="16" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="识别结果" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources>
                            <ItemsControl x:Name="DecodeResultList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="14" Background="#BFFFFFFF" BorderBrush="#A9D7EAF8" BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border x:Name="CategoryBadgeHost" Style="{StaticResource CategoryBadge}">
                                                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock x:Name="ContentText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#405F7C" TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="CopyResultButton" Margin="8,0,0,0" Height="38" MinWidth="88" Padding="18,0" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="CopyDecoded_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="复制" /></Button>
                                                    <Button x:Name="OpenResultButton" Margin="8,0,0,0" Height="38" MinWidth="88" Padding="18,0" Style="{StaticResource SmallActionButton}" Tag="{Binding}" Click="OpenDecoded_Click"><TextBlock Margin="2,0" Foreground="White" Text="打开链接" /></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="DecodeEmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#9AADBF" Text="选择图片或从剪贴板识别二维码" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 历史面板 -->
            <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="16" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="HistoryTypeComboBox" Style="{StaticResource ConverterComboBoxStyle}" Height="42" SelectionChanged="HistoryFilter_Changed">
                            <ComboBoxItem Tag="All" IsSelected="True">全部类型</ComboBoxItem>
                            <ComboBoxItem Tag="Generated">仅生成</ComboBoxItem>
                            <ComboBoxItem Tag="Decoded">仅识别</ComboBoxItem>
                        </ComboBox>
                        <Border Grid.Column="2" Height="42" Background="#BFFFFFFF" BorderBrush="#A8CEE8F8" BorderThickness="1" CornerRadius="10">
                            <Grid><TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="12" Foreground="#8A9AAC" Text="搜索历史内容…" IsHitTestVisible="False" /><TextBox x:Name="HistorySearchInput" Style="{StaticResource SingleLineInput}" TextChanged="HistoryFilter_Changed" /></Grid>
                        </Border>
                        <StackPanel Grid.Column="3" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SaveHistoryCheckBox" Style="{StaticResource QrGlassCheckBox}" FontSize="12" Foreground="#526F8B" Content="保存历史" IsChecked="True" />
                            <Button Margin="14,0,0,0" MinWidth="104" Padding="20,0" Style="{StaticResource Button}" Click="ClearHistory_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="清空历史" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Padding="16" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="历史记录（最多保留 500 条）" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="14" Background="#BFFFFFFF" BorderBrush="#A9D7EAF8" BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border x:Name="HistoryBadgeHost" Style="{StaticResource CategoryBadge}">
                                                    <TextBlock x:Name="HistoryBadgeText" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="HistoryTimeText" FontSize="11" Foreground="#7A93AC" />
                                                    <TextBlock x:Name="HistoryKindText" Margin="0,3,0,0" FontSize="11" Foreground="#8A9AAC" />
                                                </StackPanel>
                                                <TextBlock x:Name="HistoryContentText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#405F7C" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="64" ToolTip="{Binding Content}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ViewHistoryButton" Margin="8,0,0,0" Height="38" MinWidth="88" Padding="18,0" Style="{StaticResource SmallActionButton}" Tag="{Binding}" Click="ViewHistoryQr_Click"><TextBlock Margin="2,0" Foreground="White" Text="查看" /></Button>
                                                    <Button x:Name="DeleteHistoryButton" Margin="8,0,0,0" Height="38" MinWidth="88" Padding="18,0" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="DeleteHistory_Click"><TextBlock Margin="2,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="删除" /></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#9AADBF" Text="暂无历史记录" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" FontSize="11" Foreground="#63809C" IsHitTestVisible="False" />
    </Grid>
</UserControl>
