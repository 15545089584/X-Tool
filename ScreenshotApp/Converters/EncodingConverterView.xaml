<UserControl x:Class="ScreenshotApp.Converters.EncodingConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#74FFFFFF" /><Setter Property="BorderBrush" Value="#A9D7EAF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#456581" /></Setter.Value></Setter></Style>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Background" Value="#BFFFFFFF" /><Setter Property="BorderBrush" Value="#A8CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Padding" Value="12,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Button" TargetType="Button"><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="15,0" /><Setter Property="Background" Value="#8EFFFFFF" /><Setter Property="BorderBrush" Value="#A9D4EAF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#42617D" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#75A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="MinWidth" Value="92" /></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="TextModeButton" Style="{StaticResource ModeButton}" Tag="Text" Click="ModeButton_Click" Content="文本编码" />
            <Button x:Name="JwtModeButton" Style="{StaticResource ModeButton}" Tag="Jwt" Click="ModeButton_Click" Content="JWT 解析" />
            <Button x:Name="TimestampModeButton" Style="{StaticResource ModeButton}" Tag="Timestamp" Click="ModeButton_Click" Content="时间戳" />
            <Button x:Name="UuidModeButton" Style="{StaticResource ModeButton}" Tag="Uuid" Click="ModeButton_Click" Content="UUID" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid x:Name="TextModePanel"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="56" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="14" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="15" FontWeight="SemiBold" Text="输入文本" /><TextBox x:Name="TextInputBox" Grid.Row="2" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></Grid></Border>
                <Border Grid.Column="2" Padding="14" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="15" FontWeight="SemiBold" Text="转换结果" /><TextBox x:Name="TextOutputBox" Grid.Row="2" Style="{StaticResource Input}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></Grid></Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><Button Style="{StaticResource Button}" Margin="0,0,8,0" Tag="Base64Encode" Click="TextOperation_Click" Content="Base64 编码" /><Button Style="{StaticResource Button}" Margin="0,0,8,0" Tag="Base64Decode" Click="TextOperation_Click" Content="Base64 解码" /><Button Style="{StaticResource Button}" Margin="0,0,8,0" Tag="UrlEncode" Click="TextOperation_Click" Content="URL 编码" /><Button Style="{StaticResource Button}" Margin="0,0,8,0" Tag="UrlDecode" Click="TextOperation_Click" Content="URL 解码" /><Button Style="{StaticResource Button}" Margin="0,0,8,0" Tag="UnicodeEncode" Click="TextOperation_Click" Content="Unicode 编码" /><Button Style="{StaticResource Button}" Tag="UnicodeDecode" Click="TextOperation_Click" Content="Unicode 解码" /><Button Style="{StaticResource ActionButton}" Margin="14,0,0,0" Click="CopyTextResult_Click"><TextBlock Foreground="White" Text="复制结果" /></Button></StackPanel>
            </Grid>
            <Grid x:Name="JwtModePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="0.85*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Padding="14" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions><TextBlock FontSize="15" FontWeight="SemiBold" Text="JWT Token" /><TextBox x:Name="JwtInputBox" Grid.Row="2" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><Grid Grid.Row="3" Margin="0,10,0,0"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#6C849B" Text="仅解析 Header/Payload；不上传内容，也不验证签名。" /><Button HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Click="ParseJwt_Click"><TextBlock Foreground="White" Text="解析 JWT" /></Button></Grid></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Padding="14" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="14" FontWeight="SemiBold" Text="Header" /><TextBox x:Name="JwtHeaderBox" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Input}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" /></Grid></Border><Border Grid.Column="2" Padding="14" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock FontSize="14" FontWeight="SemiBold" Text="Payload" /><TextBox x:Name="JwtPayloadBox" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Input}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" /><TextBlock x:Name="JwtStatusText" Grid.Row="2" Margin="0,8,0,0" FontSize="11" Foreground="#637E9B" /></Grid></Border></Grid></Grid>
            <Grid x:Name="TimestampModePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Padding="16" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBox x:Name="TimestampInputBox" Height="40" Style="{StaticResource Input}" VerticalContentAlignment="Center" ToolTip="输入 10/13 位时间戳或日期时间" /><Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="ConvertTimestamp_Click"><TextBlock Foreground="White" Text="转换" /></Button><Button Grid.Column="4" Style="{StaticResource Button}" Content="当前时间" Click="UseCurrentTime_Click" /></Grid></Border><Border Grid.Row="2" Padding="18" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="转换结果" /><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" Foreground="#6C849B" Text="Unix 秒" /><TextBox x:Name="TimestampSecondsBox" Margin="0,6,0,14" Height="42" Style="{StaticResource Input}" IsReadOnly="True" VerticalContentAlignment="Center" /><TextBlock FontSize="12" Foreground="#6C849B" Text="UTC" /><TextBox x:Name="TimestampUtcBox" Margin="0,6,0,0" Height="42" Style="{StaticResource Input}" IsReadOnly="True" VerticalContentAlignment="Center" /></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="12" Foreground="#6C849B" Text="Unix 毫秒" /><TextBox x:Name="TimestampMillisecondsBox" Margin="0,6,0,14" Height="42" Style="{StaticResource Input}" IsReadOnly="True" VerticalContentAlignment="Center" /><TextBlock FontSize="12" Foreground="#6C849B" Text="本地时间" /><TextBox x:Name="TimestampLocalBox" Margin="0,6,0,0" Height="42" Style="{StaticResource Input}" IsReadOnly="True" VerticalContentAlignment="Center" /></StackPanel></Grid></Grid></Border></Grid>
            <Grid x:Name="UuidModePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Padding="16" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="112" /><ColumnDefinition Width="12" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBox x:Name="UuidCountBox" Height="40" Style="{StaticResource Input}" VerticalContentAlignment="Center" Text="1" ToolTip="生成数量，1-100" /><Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="GenerateUuid_Click"><TextBlock Foreground="White" Text="生成 UUID" /></Button><Button Grid.Column="4" Style="{StaticResource Button}" Content="复制全部" Click="CopyUuid_Click" /></Grid></Border><Border Grid.Row="2" Padding="16" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="UUID v4" /><TextBox x:Name="UuidOutputBox" Grid.Row="2" Style="{StaticResource Input}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></Grid></Border></Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" FontSize="11" Foreground="#63809C" IsHitTestVisible="False" />
    </Grid>
</UserControl>
