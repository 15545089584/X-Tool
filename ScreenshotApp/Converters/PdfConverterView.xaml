<UserControl x:Class="ScreenshotApp.Converters.PdfConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="Root_Drop"
             DragOver="Root_DragOver">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#75879B" />
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="18,0" /><Setter Property="Background" Value="#AFFFFFFF" /><Setter Property="BorderBrush" Value="#C9DDEEF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#D8FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#6F99FF" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryRoot" Property="Background" Value="#3E6EF1" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryRoot" Property="Background" Value="#315FD7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryRoot" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Padding="12,9" Background="#88FFFFFF" BorderBrush="#C9DDEEF8" BorderThickness="1" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#DCE9FF" /><Setter TargetName="Card" Property="BorderBrush" Value="#7EA8F7" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.82" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassProgress" TargetType="ProgressBar"><Setter Property="Height" Value="7" /><Setter Property="Background" Value="#DCEAF4FB" /><Setter Property="Foreground" Value="#D8754E" /><Setter Property="BorderThickness" Value="0" /></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="22" Background="#66EEF5FF" BorderBrush="#8EBEDCF5" BorderThickness="1.5" CornerRadius="17">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Background="#FFE9DE" CornerRadius="19"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#D8754E" Text="&#xEA90;" /></Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Text="拖入文件或点击添加" /><TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="图片、PDF、Word、Excel、PowerPoint、WPS/LibreOffice 文档" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#8A9AAC" Text="图片与 PDF 全程本地处理，原文件不会被覆盖" /></StackPanel>
                    <Button Grid.Column="3" Width="128" Height="48" Style="{StaticResource PrimaryButton}" Click="SelectFiles_Click"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="选择文件" /></Button>
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="16" Background="#D8FFFFFF" BorderBrush="#E7FFFFFF" BorderThickness="1" CornerRadius="17">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions><TextBlock FontSize="15" FontWeight="SemiBold" Text="文件列表" /><TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource MutedBrush}" Text="文件名" /><TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" Text="类型" /><TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" Text="大小" /><TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" Text="状态" /></Grid>
                    <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="12,11" Background="#79F4F9FF" BorderBrush="#A6D6E7F6" BorderThickness="1" CornerRadius="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#FFE9DE" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#D8754E" Text="&#xEA90;" /></Border><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#304A63" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" FontSize="9" Foreground="#71869B" Text="{Binding Details}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="10" Foreground="#5279A4" Text="{Binding Extension}" /><TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="10" Foreground="#5279A4" Text="{Binding FileSize}" /><TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#D8754E" Text="{Binding Status}" /><ProgressBar Grid.Column="1" Grid.ColumnSpan="4" Margin="0,31,4,0" Style="{StaticResource GlassProgress}" Maximum="100" Value="{Binding Progress}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="2" Padding="22" Background="#CFFFFFFF" BorderBrush="#E8FFFFFF" BorderThickness="1" CornerRadius="17">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><TextBlock FontSize="18" FontWeight="SemiBold" Text="PDF 设置" /><TextBlock x:Name="EngineStatusText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#5B7690" /></Grid>
                <Border Grid.Row="2" Padding="14" Background="#6AF4F9FF" BorderBrush="#B8D8EAF8" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#4E6E8C" Text="输出方式" /><StackPanel Margin="0,10,0,0" Orientation="Horizontal"><RadioButton x:Name="MergeRadio" Style="{StaticResource ModeRadio}" GroupName="PdfOutput" IsChecked="True" Content="合并为一个 PDF" /><RadioButton x:Name="SeparateRadio" Style="{StaticResource ModeRadio}" GroupName="PdfOutput" Content="分别输出 PDF" /></StackPanel><TextBlock Margin="0,9,0,0" FontSize="10" Foreground="#6A8096" Text="合并时按列表顺序排列；已有 PDF 会保留全部页面" /></StackPanel></Border>
                <Border Grid.Row="4" Padding="14" Background="#6AF4F9FF" BorderBrush="#B8D8EAF8" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#4E6E8C" Text="转换引擎" /><TextBlock x:Name="EngineDetailText" Margin="0,8,0,0" FontSize="10" Foreground="#6A8096" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Grid.Row="6" Padding="14" Background="#6AF4F9FF" BorderBrush="#B8D8EAF8" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#4E6E8C" Text="输出位置" /><TextBlock x:Name="OutputFolderText" Margin="0,7,0,0" FontSize="10" Foreground="#6A8096" Text="请选择输出文件夹" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Width="62" Margin="0,0,7,0" Style="{StaticResource GlassButton}" Click="OpenOutput_Click" Content="打开" /><Button Width="68" Style="{StaticResource GlassButton}" Click="BrowseOutput_Click" Content="浏览" /></StackPanel></Grid></Border>
                <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,12,0,0" VerticalAlignment="Top" FontSize="11" Foreground="#5B7690" TextWrapping="Wrap" />
                <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource GlassButton}" Click="Clear_Click" Content="清空列表" /><Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource GlassButton}" Click="Cancel_Click" Content="取消转换" IsEnabled="False" /><Button x:Name="StartButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="Start_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="开始转换" /></Button></Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
