<UserControl x:Class="ScreenshotApp.Converters.VideoConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="Root_Drop"
             DragOver="Root_DragOver">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#75879B" />
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="18,0" /><Setter Property="Background" Value="#AFFFFFFF" /><Setter Property="BorderBrush" Value="#C9DDEEF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#D8FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#6F99FF" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="GlassCombo" TargetType="ComboBox"><Setter Property="Height" Value="39" /><Setter Property="Padding" Value="11,0" /><Setter Property="Background" Value="#A8FFFFFF" /><Setter Property="BorderBrush" Value="#B7D7EAF8" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="GlassTextBox" TargetType="TextBox"><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="#A8FFFFFF" /><Setter Property="BorderBrush" Value="#B7D7EAF8" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Padding="11,9" Background="#88FFFFFF" BorderBrush="#C9DDEEF8" BorderThickness="1" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#DCE9FF" /><Setter TargetName="Card" Property="BorderBrush" Value="#7EA8F7" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.82" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassProgress" TargetType="ProgressBar"><Setter Property="Height" Value="8" /><Setter Property="Background" Value="#DCEAF4FB" /><Setter Property="Foreground" Value="#5B86FF" /><Setter Property="BorderThickness" Value="0" /></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="22" Background="#62F0F3FF" BorderBrush="#9BBFE1F3" BorderThickness="1.5" CornerRadius="17">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Background="#E7E0FF" CornerRadius="19"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#7B61D8" Text="&#xE714;" /></Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="拖入视频或点击添加" />
                        <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="MP4、MOV、MKV、AVI、WebM、FLV、WMV" />
                        <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#8A9AAC" Text="格式转换、压缩、提取音频与 GIF 任务统一排队" />
                    </StackPanel>
                    <Button Grid.Column="3" Width="108" Style="{StaticResource PrimaryButton}" Click="SelectFiles_Click" Content="选择视频" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="16" Background="#D8FFFFFF" BorderBrush="#E7FFFFFF" BorderThickness="1" CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock FontSize="15" FontWeight="SemiBold" Text="文件列表" /><TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="分辨率 · FPS · 编码 · 时长 · 大小 · 状态" /></Grid>
                    <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Padding="12" Background="#79F4F9FF" BorderBrush="#A6D6E7F6" BorderThickness="1" CornerRadius="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#304A63" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#71869B" Text="{Binding Details}" TextTrimming="CharacterEllipsis" /><ProgressBar Margin="0,9,0,0" Style="{StaticResource GlassProgress}" Maximum="100" Value="{Binding Progress}" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#5279A4"><Run Text="{Binding Format}" /><Run Text="  ·  " /><Run Text="{Binding FileSize}" /></TextBlock><TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#7B61D8" Text="{Binding Status}" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Padding="20" Background="#D8FFFFFF" BorderBrush="#E9FFFFFF" BorderThickness="1" CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><TextBlock FontSize="17" FontWeight="SemiBold" Text="视频设置" /><TextBlock x:Name="EngineStatusText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#6D8094" /></Grid>
                    <Border Grid.Row="2" Padding="13" Background="#55EEF0FF" BorderBrush="#B7D5E9F7" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#526F8B" Text="处理方式" />
                            <UniformGrid Margin="0,9,0,0" Rows="1" Columns="4">
                                <RadioButton x:Name="ConvertModeRadio" GroupName="VideoMode" Style="{StaticResource ModeRadio}" Content="格式转换" IsChecked="True" Checked="Mode_Checked" />
                                <RadioButton x:Name="CompressModeRadio" GroupName="VideoMode" Style="{StaticResource ModeRadio}" Content="视频压缩" Checked="Mode_Checked" />
                                <RadioButton x:Name="ExtractModeRadio" GroupName="VideoMode" Style="{StaticResource ModeRadio}" Content="提取音频" Checked="Mode_Checked" />
                                <RadioButton x:Name="GifModeRadio" GroupName="VideoMode" Style="{StaticResource ModeRadio}" Content="转 GIF" Checked="Mode_Checked" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Padding="13" Background="#55EEF0FF" BorderBrush="#B7D5E9F7" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="输出格式" /><ComboBox x:Name="OutputFormatCombo" Margin="0,5,0,0" Style="{StaticResource GlassCombo}" SelectedIndex="0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="质量模式" /><ComboBox x:Name="QualityCombo" Margin="0,5,0,0" Style="{StaticResource GlassCombo}" SelectedIndex="1"><ComboBoxItem>高质量</ComboBoxItem><ComboBoxItem>标准</ComboBoxItem><ComboBoxItem>小文件</ComboBoxItem></ComboBox></StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="VideoAdvancedCard" Grid.Row="6" Padding="13" Background="#55EEF0FF" BorderBrush="#B7D5E9F7" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="输出宽度" /><ComboBox x:Name="WidthCombo" Margin="0,5,0,0" Style="{StaticResource GlassCombo}" SelectedIndex="0"><ComboBoxItem Tag="">保持原分辨率</ComboBoxItem><ComboBoxItem Tag="1920">1920</ComboBoxItem><ComboBoxItem Tag="1280">1280</ComboBoxItem><ComboBoxItem Tag="854">854</ComboBoxItem><ComboBoxItem Tag="640">640</ComboBoxItem></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="编码格式" /><ComboBox x:Name="CodecCombo" Margin="0,5,0,0" Style="{StaticResource GlassCombo}" SelectedIndex="0"><ComboBoxItem>H.264</ComboBoxItem><ComboBoxItem>H.265</ComboBoxItem><ComboBoxItem>AV1</ComboBoxItem></ComboBox></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="视频码率（kbps，可选）" /><TextBox x:Name="VideoBitRateText" Margin="0,5,0,0" Style="{StaticResource GlassTextBox}" /></StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,20,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#8495A7" Text="留空时按质量模式自动编码" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Border x:Name="GifSettingsCard" Grid.Row="8" Padding="13" Background="#55EEF0FF" BorderBrush="#B7D5E9F7" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="开始时间" /><TextBox x:Name="GifStartText" Margin="0,5,0,0" Style="{StaticResource GlassTextBox}" Text="00:00:00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="结束时间" /><TextBox x:Name="GifEndText" Margin="0,5,0,0" Style="{StaticResource GlassTextBox}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="FPS" /><ComboBox x:Name="GifFpsCombo" Margin="0,5,0,0" Style="{StaticResource GlassCombo}" SelectedIndex="1"><ComboBoxItem Tag="10">10</ComboBoxItem><ComboBoxItem Tag="15">15</ComboBoxItem><ComboBoxItem Tag="24">24</ComboBoxItem></ComboBox></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="10" Padding="13" Background="#55EEF0FF" BorderBrush="#B7D5E9F7" BorderThickness="1" CornerRadius="12"><Grid><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#526F8B" Text="输出位置" /><TextBlock x:Name="OutputFolderText" Margin="0,6,154,0" FontSize="10" Foreground="#6A8096" Text="请选择输出文件夹" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="64" Margin="0,0,7,0" Style="{StaticResource GlassButton}" Click="OpenOutput_Click" Content="打开" /><Button Width="72" Style="{StaticResource GlassButton}" Click="BrowseOutput_Click" Content="浏览" /></StackPanel></Grid></Border>
                    <TextBlock x:Name="StatusText" Grid.Row="11" FontSize="11" Foreground="#5B7690" TextWrapping="Wrap" />
                    <Grid Grid.Row="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource GlassButton}" Click="Clear_Click" Content="清空列表" /><Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource GlassButton}" Click="Cancel_Click" Content="取消转换" IsEnabled="False" /><Button x:Name="StartButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="Start_Click" Content="开始转换" /></Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
