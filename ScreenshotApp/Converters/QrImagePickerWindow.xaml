<Window x:Class="ScreenshotApp.Converters.QrImagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择剪贴板图片" Width="460" Height="560" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="QrGlassScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="9" /><Setter Property="Margin" Value="3,7,3,7" /><Setter Property="Background" Value="#38D3E5F5" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#89A9C7E5" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Border Margin="12" Padding="22" Background="#EFF7FC" BorderBrush="#CFE4F1" BorderThickness="1" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.25" Color="#253B56" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#263747" Text="选择剪贴板图片" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0"
                        Background="#66FFFFFF" BorderBrush="#A7CEE6F5" BorderThickness="1" Foreground="#607C96"
                        FontSize="16" Content="×" Cursor="Hand" Click="CloseButton_Click" ToolTip="关闭" />
            </Grid>
            <TextBlock Grid.Row="2" FontSize="12" Foreground="#6C849B" Text="选择一张图片，将自动识别其中的二维码" />
            <Border Grid.Row="4" Padding="10" Background="#BFFFFFFF" BorderBrush="#A9D7EAF8" BorderThickness="1" CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QrGlassScrollBar}" /></ScrollViewer.Resources>
                    <ItemsControl x:Name="ImageItemsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand" Tag="{Binding}" Click="ImageItem_Click" ToolTip="点击识别此图片">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Padding="10" Background="#F8FCFF" BorderBrush="#C6E1F1" BorderThickness="1" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E3F0FF" /><Setter TargetName="Root" Property="BorderBrush" Value="#7EA8F7" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.75" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="118" Height="78" Background="#E8F1FA" BorderBrush="#D3E4F1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#405F7C" Text="{Binding KindText}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#7A93AC" Text="{Binding CapturedAtText}" />
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#8A9AAC" TextTrimming="CharacterEllipsis" Text="{Binding PreviewText}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="LoadingText" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#8A9AAC" Text="正在加载图片…" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
