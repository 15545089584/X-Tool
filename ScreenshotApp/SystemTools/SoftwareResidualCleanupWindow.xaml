<Window x:Class="ScreenshotApp.SystemTools.SoftwareResidualCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="残留候选" Width="820" Height="620" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#EDF5FB" FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="18" Background="#CCFFFFFF" BorderBrush="#A8D6E9F8" BorderThickness="1" CornerRadius="15">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#294B69" Text="残留候选（默认不选中）" />
                <TextBlock x:Name="DescriptionText" Margin="0,7,0,0" FontSize="11" Foreground="#607D98" TextWrapping="Wrap" />
                <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#B45D55" Text="请确认软件已经卸载，并逐项核对路径。文件夹会移入回收站；注册表项删除后不能由 X-Tool 恢复。" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="10" Background="#9EFFFFFF" BorderBrush="#A8D6E9F8" BorderThickness="1" CornerRadius="15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="8,0,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#66819B" Text="类型" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#66819B" Text="位置与依据" /><TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#66819B" Text="估算大小" /></Grid>
                <ListBox x:Name="CandidatesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3,2" Padding="10" Background="#AAFFFFFF" BorderBrush="#86D0E5F5" BorderThickness="1" CornerRadius="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#4D6E8C" Text="{Binding KindText}" />
                                    <StackPanel Grid.Column="2"><TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#365774" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="{Binding Reason}" TextWrapping="Wrap" /></StackPanel>
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#587793" Text="{Binding SizeText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="#607D98" />
            <Button Grid.Column="1" Height="40" Content="取消" Click="Cancel_Click" />
            <Button Grid.Column="3" Height="40" Background="#4D7CFE" Foreground="White" FontWeight="SemiBold" Content="处理所选候选" Click="DeleteSelected_Click" />
        </Grid>
    </Grid>
</Window>
