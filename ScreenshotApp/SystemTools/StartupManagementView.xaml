<UserControl x:Class="ScreenshotApp.SystemTools.StartupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="StartupCard" TargetType="Border">
            <Setter Property="Background" Value="#72FFFFFF" />
            <Setter Property="BorderBrush" Value="#9ED4E8F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#476581" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupPrimaryButton" TargetType="Button" BasedOn="{StaticResource StartupButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="StartupTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#3E5C78" /><Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="FontSize" Value="11" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Background" Value="White" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#52708E" /><Setter Property="FontSize" Value="10.5" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="StartupList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" /><Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="Transparent" CornerRadius="13"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#45DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#8DDCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Padding="15" Style="{StaticResource StartupCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="132" /><ColumnDefinition Width="8" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#DDE8FF" BorderBrush="#8AB5D2FF" BorderThickness="1" CornerRadius="14"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#4D7CFE" Text="&#xE768;" /></Border><StackPanel Margin="12,1,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#2E4B67" Text="启动项总览" /><TextBlock x:Name="StartupSummaryText" Margin="0,4,0,0" FontSize="10.5" Foreground="#6D879F" Text="读取当前用户、系统和高级自动加载位置" /></StackPanel></StackPanel>
                    <TextBlock x:Name="StartupCoverageText" Margin="0,10,0,0" FontSize="9.5" Foreground="#7890A6" Text="结果不等同于恶意软件扫描；受保护位置和其他用户配置可能受权限限制。" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource StartupButton}" Content="Windows 启动设置" Click="OpenWindowsStartupSettings_Click" />
                <Button x:Name="StartupRefreshButton" Grid.Column="4" Style="{StaticResource StartupPrimaryButton}" Click="RefreshStartup_Click"><TextBlock x:Name="StartupRefreshButtonText" FontWeight="SemiBold" Foreground="White" Text="开始扫描" /></Button>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="5">
            <Border Margin="0,0,8,0" Padding="12" Background="#70E7EEFF" BorderBrush="#7CAFC8FF" BorderThickness="1" CornerRadius="13"><StackPanel><TextBlock FontSize="9.5" Foreground="#6D83A0" Text="登录应用" /><TextBlock x:Name="LoginApplicationCountText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#4D7CFE" Text="—" /></StackPanel></Border>
            <Border Margin="2,0,6,0" Padding="12" Background="#70F0E8FA" BorderBrush="#88C9A8E7" BorderThickness="1" CornerRadius="13"><StackPanel><TextBlock FontSize="9.5" Foreground="#796E8E" Text="后台任务" /><TextBlock x:Name="BackgroundTaskCountText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#9B63D2" Text="—" /></StackPanel></Border>
            <Border Margin="4,0" Padding="12" Background="#70E4F6F1" BorderBrush="#88A8DCCF" BorderThickness="1" CornerRadius="13"><StackPanel><TextBlock FontSize="9.5" Foreground="#66877F" Text="系统服务" /><TextBlock x:Name="ServiceCountText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#16A582" Text="—" /></StackPanel></Border>
            <Border Margin="6,0,2,0" Padding="12" Background="#70E4F1F5" BorderBrush="#88ADD2DE" BorderThickness="1" CornerRadius="13"><StackPanel><TextBlock FontSize="9.5" Foreground="#68838C" Text="启动驱动" /><TextBlock x:Name="DriverCountText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#4D9CB5" Text="—" /></StackPanel></Border>
            <Border Margin="8,0,0,0" Padding="12" Background="#70FFF1DD" BorderBrush="#88E6C18C" BorderThickness="1" CornerRadius="13"><StackPanel><TextBlock FontSize="9.5" Foreground="#8B795F" Text="高级加载点" /><TextBlock x:Name="AdvancedCountText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#E99A31" Text="—" /></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.22*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.78*" /></Grid.ColumnDefinitions>
            <Border Padding="14" Style="{StaticResource StartupCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="136" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="StartupFilterTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource StartupTextBox}" TextChanged="StartupFilter_Changed" ToolTip="搜索名称、命令、来源、发布者或账户" />
                        <ComboBox x:Name="StartupCategoryComboBox" Grid.Column="2" Height="38" Style="{StaticResource StartupComboBox}" SelectionChanged="StartupFilter_Changed"><ComboBoxItem Tag="All">全部类型</ComboBoxItem><ComboBoxItem Tag="LoginApplication">登录应用</ComboBoxItem><ComboBoxItem Tag="BackgroundTask">后台任务</ComboBoxItem><ComboBoxItem Tag="Service">系统服务</ComboBoxItem><ComboBoxItem Tag="Driver">启动驱动</ComboBoxItem><ComboBoxItem Tag="Advanced">高级加载点</ComboBoxItem></ComboBox>
                        <CheckBox x:Name="ThirdPartyOnlyCheckBox" Grid.Column="4" VerticalAlignment="Center" Content="仅第三方" Style="{StaticResource StartupCheckBox}" Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed" />
                        <CheckBox x:Name="AttentionOnlyCheckBox" Grid.Column="6" VerticalAlignment="Center" Content="仅需注意" Style="{StaticResource StartupCheckBox}" Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="StartupListBox" Style="{StaticResource StartupList}" SelectionChanged="StartupListBox_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Background="#58FFFFFF" BorderBrush="#76D4E8F7" BorderThickness="1" CornerRadius="13">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryAccent}" BorderThickness="1" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{Binding CategoryAccent}" Text="&#xE768;" /></Border>
                                            <StackPanel Grid.Column="2"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#365774" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#718AA2" Text="{Binding Source}" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#718AA2" Text="{Binding Trigger}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" /></StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right"><Border Padding="8,4" Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryAccent}" BorderThickness="1" CornerRadius="8"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{Binding CategoryAccent}" Text="{Binding CategoryText}" /></Border><Border Margin="0,6,0,0" Padding="8,4" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusAccent}" BorderThickness="1" CornerRadius="8"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusAccent}" Text="{Binding StatusText}" /></Border></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="StartupEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#8CA3B8" Text="&#xE8D2;" /><TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="尚未扫描启动项" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="点击右上角“开始扫描”读取当前配置。" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="16" Style="{StaticResource StartupCard}">
                <Grid>
                    <StackPanel x:Name="StartupDetailsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#8CA3B8" Text="&#xE946;" /><TextBlock Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="选择启动项查看详情" /><TextBlock Margin="0,4,0,0" MaxWidth="240" TextAlignment="Center" FontSize="10" Foreground="#7890A6" TextWrapping="Wrap" Text="X-Tool 会显示真实来源、触发方式、运行账户和可执行命令。" /></StackPanel>
                    <Grid x:Name="StartupDetailsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Border Width="48" Height="48" HorizontalAlignment="Left" Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryAccent}" BorderThickness="1" CornerRadius="15"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{Binding CategoryAccent}" Text="&#xE768;" /></Border><StackPanel Margin="60,1,0,0"><TextBlock FontSize="9.5" Foreground="#7890A6" Text="{Binding CategoryText}" /><TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#2E4B67" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="{Binding StatusAccent}" Text="{Binding StatusText}" /></StackPanel></Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Padding="11" Background="#42E8F2FF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="11"><StackPanel><TextBlock FontSize="9.5" Foreground="#7890A6" Text="触发与来源" /><TextBlock Margin="0,5,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Trigger}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding SourceLocation}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Margin="0,8,0,0" Padding="11" Background="#42FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="11"><StackPanel><TextBlock FontSize="9.5" Foreground="#7890A6" Text="运行命令" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="9.5" Foreground="#405F7C" Text="{Binding Command}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Margin="0,8,0,0" Padding="11" Background="#42FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="11"><StackPanel><TextBlock FontSize="9.5" Foreground="#7890A6" Text="文件与发布者" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#45627E" Text="{Binding ExecutablePathText}" TextWrapping="Wrap" /><TextBlock Margin="0,5,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding PublisherText}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding SignatureStatus}" /></StackPanel></Border>
                                <Border Margin="0,8,0,0" Padding="11" Background="#42FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="11"><StackPanel><TextBlock FontSize="9.5" Foreground="#7890A6" Text="范围与账户" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#45627E" Text="{Binding Scope}" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding Account}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Margin="0,8,0,0" Padding="11" Background="#FFF2DF" BorderBrush="#E6BE82" BorderThickness="1" CornerRadius="11" Visibility="{Binding RequiresAttention, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#B27622" Text="需要注意" /><TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#8B6C41" Text="{Binding AttentionText}" TextWrapping="Wrap" /></StackPanel></Border>
                                <TextBlock Margin="2,10,2,0" FontSize="9.5" Foreground="#7890A6" Text="{Binding ToggleHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource StartupButton}" Content="打开所在位置" Click="OpenStartupLocation_Click" /><Button Grid.Column="2" Style="{StaticResource StartupPrimaryButton}" Click="ToggleStartup_Click" IsEnabled="{Binding CanToggle}"><TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding ToggleActionText}" /></Button></Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
