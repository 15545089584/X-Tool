<UserControl x:Class="ScreenshotApp.SystemTools.StartupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="StartupCard" TargetType="Border">
            <Setter Property="Background" Value="#72FFFFFF" /><Setter Property="BorderBrush" Value="#9ED4E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="15" />
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#476581" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="White" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#3E70EE" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Background" Value="#AABBD0E5" /><Setter TargetName="Root" Property="BorderBrush" Value="#B9C8D9E6" /><Setter Property="Foreground" Value="#F3F7FB" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#3E5C78" /><Setter Property="CaretBrush" Value="#4D7CFE" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C9DEFF" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="StartupComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="FontSize" Value="11" /><Setter Property="ItemContainerStyle" Value="{StaticResource StartupComboBoxItem}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10"><Grid><ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="#405F7C" /><TextBlock Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E4F1FFFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F2FAFFFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="210" CanContentScroll="True"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#52708E" /><Setter Property="FontSize" Value="10.5" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="Box" Width="18" Height="18" Background="#A8FFFFFF" BorderBrush="#A6CDE5F6" BorderThickness="1" CornerRadius="5"><TextBlock x:Name="Tick" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0" Text="✓" /></Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#DCEBFF" /><Setter TargetName="Box" Property="BorderBrush" Value="#72A1FE" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4D7CFE" /><Setter TargetName="Box" Property="BorderBrush" Value="#4D7CFE" /><Setter TargetName="Tick" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" /><Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="Transparent" CornerRadius="13"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#45DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupToggleButton" TargetType="Button">
            <Setter Property="Width" Value="54" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Width="50" Height="28"><Border x:Name="Track" Background="#D8E2EC" BorderBrush="#AABBCDCE" BorderThickness="1" CornerRadius="14" /><Border x:Name="Thumb" Width="20" Height="20" Margin="4" HorizontalAlignment="Left" Background="#F7FFFFFF" BorderBrush="#9AB6C8D7" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.2" Color="#45627E" /></Border.Effect></Border></Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter TargetName="Track" Property="Background" Value="#8CB3FE" /><Setter TargetName="Track" Property="BorderBrush" Value="#6998F2" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="BorderBrush" Value="#80FFFFFF" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.86" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value="0.68" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.38" /><Setter TargetName="Thumb" Property="Opacity" Value="0.55" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="15" Style="{StaticResource StartupCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="132" /><ColumnDefinition Width="8" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#DDE8FF" BorderBrush="#8AB5D2FF" BorderThickness="1" CornerRadius="14"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#4D7CFE" Text="&#xE768;" /></Border><StackPanel Margin="12,1,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#2E4B67" Text="启动项总览" /><TextBlock x:Name="StartupSummaryText" Margin="0,4,0,0" FontSize="10.5" Foreground="#6D879F" Text="读取当前用户、系统和高级自动加载位置" /></StackPanel></StackPanel>
                    <TextBlock x:Name="StartupCoverageText" Margin="0,9,0,0" FontSize="9.5" Foreground="#7890A6" Text="结果不等同于恶意软件扫描；受保护位置和其他用户配置可能受权限限制。" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" Background="#72FFFFFF" BorderBrush="#9ACDE3F4" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#526E87" /></Border.Effect>
                    <UniformGrid Columns="5">
                        <Border Padding="8,7" Background="#B8D7E4FF" BorderBrush="#A078A2FF" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#536F96" Text="登录应用" /><TextBlock x:Name="LoginApplicationCountText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#4D7CFE" Text="—" /></StackPanel></Border>
                        <Border Padding="8,7" Background="#B8E8D9F6" BorderBrush="#A0B982DB" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#725A86" Text="后台任务" /><TextBlock x:Name="BackgroundTaskCountText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#9B63D2" Text="—" /></StackPanel></Border>
                        <Border Padding="8,7" Background="#B8D6F1E9" BorderBrush="#A079CBB7" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#4E796F" Text="系统服务" /><TextBlock x:Name="ServiceCountText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#16A582" Text="—" /></StackPanel></Border>
                        <Border Padding="8,7" Background="#B8D5EBF2" BorderBrush="#A07ABBCF" BorderThickness="0,0,1,0"><StackPanel HorizontalAlignment="Center"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#557681" Text="启动驱动" /><TextBlock x:Name="DriverCountText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#4D9CB5" Text="—" /></StackPanel></Border>
                        <Border Padding="8,7" Background="#B8F9E5C8"><StackPanel HorizontalAlignment="Center"><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#806B4B" Text="高级加载" /><TextBlock x:Name="AdvancedCountText" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#E89024" Text="—" /></StackPanel></Border>
                    </UniformGrid>
                </Border>
                <Button Grid.Column="4" Style="{StaticResource StartupButton}" Content="Windows 启动设置" Click="OpenWindowsStartupSettings_Click" />
                <Button x:Name="StartupRefreshButton" Grid.Column="6" Style="{StaticResource StartupPrimaryButton}" Click="RefreshStartup_Click"><TextBlock x:Name="StartupRefreshButtonText" FontWeight="SemiBold" Foreground="White" Text="开始扫描" /></Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="14" Style="{StaticResource StartupCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="156" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid><TextBox x:Name="StartupFilterTextBox" Height="38" Padding="38,0,12,0" VerticalContentAlignment="Center" Style="{StaticResource StartupTextBox}" TextChanged="StartupFilter_Changed" ToolTip="搜索名称、命令、来源、发布者或账户" /><TextBlock Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#6E8AA4" IsHitTestVisible="False" Text="&#xE721;" /></Grid>
                    <ComboBox x:Name="StartupCategoryComboBox" Grid.Column="2" Height="38" Style="{StaticResource StartupComboBox}" SelectionChanged="StartupFilter_Changed"><ComboBoxItem Tag="All">全部类型</ComboBoxItem><ComboBoxItem Tag="LoginApplication">登录应用</ComboBoxItem><ComboBoxItem Tag="BackgroundTask">后台任务</ComboBoxItem><ComboBoxItem Tag="Service">系统服务</ComboBoxItem><ComboBoxItem Tag="Driver">启动驱动</ComboBoxItem><ComboBoxItem Tag="Advanced">高级加载点</ComboBoxItem></ComboBox>
                    <CheckBox x:Name="ThirdPartyOnlyCheckBox" Grid.Column="4" VerticalAlignment="Center" Content="仅第三方" Style="{StaticResource StartupCheckBox}" Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed" />
                    <CheckBox x:Name="AttentionOnlyCheckBox" Grid.Column="6" VerticalAlignment="Center" Content="仅需注意" Style="{StaticResource StartupCheckBox}" Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed" />
                    <StackPanel Grid.Column="7" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" Background="#16B99B" CornerRadius="4" /><TextBlock Margin="5,0,12,0" FontSize="9.5" Foreground="#68839A" Text="运行中" /><Border Width="7" Height="7" Background="#E16670" CornerRadius="4" /><TextBlock Margin="5,0,0,0" FontSize="9.5" Foreground="#68839A" Text="未运行" /></StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox x:Name="StartupListBox" Style="{StaticResource StartupList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#58FFFFFF" BorderBrush="#76D4E8F7" BorderThickness="1" CornerRadius="13" ToolTipService.InitialShowDelay="260" ToolTipService.BetweenShowDelay="60" ToolTipService.ShowDuration="30000">
                                    <Border.ToolTip>
                                        <ToolTip Placement="Mouse" HorizontalOffset="14" VerticalOffset="10" HasDropShadow="False">
                                            <Border Width="570" Padding="16" Background="#F3FAFFFF" BorderBrush="#A6CDE5F6" BorderThickness="1" CornerRadius="16">
                                                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.2" Color="#3D5872" /></Border.Effect>
                                                <StackPanel>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryAccent}" BorderThickness="1" CornerRadius="14"><Grid><Image x:Name="TooltipIcon" Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform" /><TextBlock x:Name="TooltipFallbackIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{Binding CategoryAccent}" Text="&#xE768;" Visibility="Collapsed" /></Grid></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2E4B67" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#6F899F"><Run Text="{Binding CategoryText}" /><Run Text=" · " /><Run Text="{Binding Source}" /></TextBlock></StackPanel><Border Grid.Column="3" Padding="9,5" VerticalAlignment="Center" Background="{Binding RunningBackground}" BorderBrush="{Binding RunningAccent}" BorderThickness="1" CornerRadius="9"><TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding RunningAccent}" Text="{Binding RunningStateText}" /></Border></Grid>
                                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Padding="11" Background="#55E8F2FF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="9" Foreground="#7890A6" Text="触发与来源" /><TextBlock Margin="0,5,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Trigger}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding SourceLocation}" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="2" Padding="11" Background="#55FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="9" Foreground="#7890A6" Text="范围与账户" /><TextBlock Margin="0,5,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Scope}" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding Account}" TextWrapping="Wrap" /></StackPanel></Border></Grid>
                                                    <Border Margin="0,8,0,0" Padding="11" Background="#55FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="9" Foreground="#7890A6" Text="运行命令" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="10" Foreground="#405F7C" Text="{Binding Command}" TextWrapping="Wrap" MaxHeight="68" /></StackPanel></Border>
                                                    <Border Margin="0,8,0,0" Padding="11" Background="#55FFFFFF" BorderBrush="#72CFE5F6" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="9" Foreground="#7890A6" Text="程序文件" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#45627E" Text="{Binding ExecutablePathText}" TextWrapping="Wrap" MaxHeight="48" /></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="9" Foreground="#7890A6" Text="发布者与签名" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#45627E" Text="{Binding PublisherText}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="#6F899F" Text="{Binding SignatureStatus}" /></StackPanel></Grid></Border>
                                                    <Border Margin="0,8,0,0" Padding="10" Background="#FFF2DF" BorderBrush="#E6BE82" BorderThickness="1" CornerRadius="10" Visibility="{Binding RequiresAttention, Converter={StaticResource BoolToVisibility}}"><TextBlock FontSize="9.5" Foreground="#8B6C41" Text="{Binding AttentionText}" TextWrapping="Wrap" /></Border>
                                                    <TextBlock Margin="2,9,2,0" FontSize="9.5" Foreground="#7890A6" Text="{Binding ToggleHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <Grid>
                                        <Border Width="5" HorizontalAlignment="Left" Background="{Binding CategoryAccent}" CornerRadius="13,0,0,13" />
                                        <Grid Margin="15,11,12,11"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="28" /><ColumnDefinition Width="12" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="{Binding CategoryBackground}" BorderBrush="{Binding CategoryAccent}" BorderThickness="1" CornerRadius="12"><Grid><Image x:Name="ProgramIcon" Width="30" Height="30" Source="{Binding Icon}" Stretch="Uniform" /><TextBlock x:Name="FallbackIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding CategoryAccent}" Text="&#xE768;" Visibility="Collapsed" /></Grid></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#365774" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Margin="0,4,0,0" FontSize="9.8" Foreground="#718AA2"><Run Text="{Binding Source}" /><Run Text=" · " /><Run Text="{Binding Trigger}" /></TextBlock><TextBlock Margin="0,3,0,0" FontSize="9.2" Foreground="#879CB0" Text="{Binding Command}" TextTrimming="CharacterEllipsis" /></StackPanel><Grid Grid.Column="4" Width="24" Height="24" ToolTip="{Binding RunningStateText}"><Border Width="18" Height="18" Background="{Binding RunningBackground}" CornerRadius="9" /><Border Width="8" Height="8" Background="{Binding RunningAccent}" CornerRadius="4"><Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.55" Color="{Binding RunningAccent}" /></Border.Effect></Border></Grid><Button Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource StartupToggleButton}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleHint}" AutomationProperties.Name="{Binding ToggleActionText}" Click="ToggleStartup_Click" /></Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="ProgramIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" /><Setter TargetName="TooltipIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="TooltipFallbackIcon" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="StartupEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#8CA3B8" Text="&#xE8D2;" /><TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="尚未扫描启动项" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="点击右上角“开始扫描”读取当前配置。" /></StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
