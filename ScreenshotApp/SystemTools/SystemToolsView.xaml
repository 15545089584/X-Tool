        <Style x:Key="StorageUsageBar" TargetType="ProgressBar"><Setter Property="Height" Value="8" /><Setter Property="Background" Value="#D9EAF7" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" ClipToBounds="True" CornerRadius="4" SnapsToDevicePixels="True"><Border Background="{TemplateBinding Foreground}" CornerRadius="4" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding UsageRatio, Mode=OneWay}" /></Border.RenderTransform></Border></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="HardwareTemperatureBar" TargetType="ProgressBar"><Setter Property="Height" Value="6" /><Setter Property="Background" Value="#D7E8F4" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" ClipToBounds="True" CornerRadius="3"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" /></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DirectionButton" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Width" Value="42" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#65819D" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
