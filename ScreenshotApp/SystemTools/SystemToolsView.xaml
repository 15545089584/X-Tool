                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Margin="3,2,3,7" Padding="12" Background="#82FFFFFF" BorderBrush="{Binding SeverityColor}" BorderThickness="1.25" CornerRadius="12" ToolTip="{Binding ProgramIdentityToolTip}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" VerticalAlignment="Top" Background="#C8FFFFFF" BorderBrush="{Binding SeverityColor}" BorderThickness="1.25" CornerRadius="10"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding SeverityColor}" Text="{Binding IconGlyph}" /></Border><StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#365774" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding EventIdentityText}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#607E9A" Text="{Binding LastSeenText}" /></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SeverityTextColor}" Text="{Binding OccurrenceText}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="DiagnosticEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#8AA0B5" Text="&#xE9D9;" /><TextBlock x:Name="DiagnosticEmptyTitleText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="尚未生成诊断结果" /><TextBlock x:Name="DiagnosticEmptyDescriptionText" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="点击“开始诊断”读取最近的系统与应用事件" /></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="16" Style="{StaticResource SystemCard}">
                        <Grid>
                            <StackPanel x:Name="DiagnosticDetailEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#8AA0B5" Text="&#xE8A5;" /><TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="选择一项查看诊断依据" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="系统诊断只提供排查线索，不会自动修改系统" /></StackPanel>
                            <Grid x:Name="DiagnosticDetailContent" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="38" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="4" Height="36" VerticalAlignment="Top" Background="{Binding SeverityColor}" CornerRadius="2" />
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" ToolTip="{Binding ProgramIdentityToolTip}"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#2E4B67" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,6,0,0" FontSize="10.5" Foreground="#6F899F" Text="{Binding EventIdentityText}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="#587793" Text="{Binding TimeRangeText}" TextWrapping="Wrap" /></StackPanel>
                                    <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding SeverityColor}" BorderBrush="{Binding SeverityTextColor}" Style="{StaticResource DiagnosticSeverityBadge}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Text="{Binding SeverityText}" TextAlignment="Center" /></Border>
                                </Grid>
                                <Border Grid.Row="2" Padding="12,11" Background="#62FFFFFF" BorderBrush="#7CCDE2F4" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.65*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" Background="{Binding SeverityColor}" CornerRadius="15"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" FontWeight="SemiBold" Foreground="White" Text="{Binding SeverityDisplay.Glyph}" /></Border><StackPanel Margin="9,0,0,0"><TextBlock FontSize="10.5" Foreground="#6F899F" Text="影响判断" /><TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#365774" Text="需要关注" /></StackPanel></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock FontSize="10.5" Foreground="#6F899F" Text="严重性" /><TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{Binding SeverityTextColor}" Text="{Binding SeverityText}" /></StackPanel>
                                        <Border Grid.Column="1" Width="1" Margin="0,1" HorizontalAlignment="Left" Background="#88C9DCEC" />
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock FontSize="10.5" Foreground="#6F899F" Text="发生频率" /><TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#365774" Text="{Binding FrequencyValueText}" /></StackPanel>
                                        <Border Grid.Column="2" Width="1" Margin="0,1" HorizontalAlignment="Left" Background="#88C9DCEC" />
                                        <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock FontSize="10.5" Foreground="#6F899F" Text="最新发生" /><TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#526F8B" Text="{Binding LatestOccurredAtText}" TextWrapping="Wrap" /></StackPanel>
                                        <Border Grid.Column="3" Width="1" Margin="0,1" HorizontalAlignment="Left" Background="#88C9DCEC" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,4,0">
                                        <Border Padding="11" Background="#50FFFFFF" BorderBrush="#72D2E7F6" BorderThickness="1" CornerRadius="11">
                                            <StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#365774" Text="事件摘要" /><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Padding="10" BorderBrush="#54C9DCEC" BorderThickness="0,0,1,1"><StackPanel><TextBlock FontSize="10.5" Foreground="#6F899F" Text="事件来源" /><TextBlock Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#486986" Text="{Binding ProviderName}" TextTrimming="CharacterEllipsis" /></StackPanel></Border><Border Grid.Column="1" Padding="10" BorderBrush="#54C9DCEC" BorderThickness="0,0,0,1"><StackPanel><TextBlock FontSize="10.5" Foreground="#6F899F" Text="事件 ID" /><TextBlock Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#486986" Text="{Binding EventId}" /></StackPanel></Border><Border Grid.Row="1" Padding="10" BorderBrush="#54C9DCEC" BorderThickness="0,0,1,0"><StackPanel><TextBlock FontSize="10.5" Foreground="#6F899F" Text="故障模块" /><TextBlock Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#486986" Text="{Binding FaultingModuleText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Padding="10"><StackPanel><TextBlock FontSize="10.5" Foreground="#6F899F" Text="异常代码" /><TextBlock Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#486986" Text="{Binding ExceptionCodeText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></Grid></StackPanel>
                                        </Border>
                                        <Expander Margin="0,8,0,0">
                                            <Expander.Template><ControlTemplate TargetType="Expander"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ToggleButton x:Name="HeaderSite" MinHeight="42" Padding="22,10,16,10" Background="#58FFFFFF" BorderBrush="#72D2E7F6" BorderThickness="1" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter /></Border></ControlTemplate></ToggleButton.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions><TextBlock Margin="2,0,0,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#4D7CFE" Text="&#xE8A5;" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#45627E" Text="查看 Windows 原始事件" /><TextBlock Grid.Column="2" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#718AA2" Text="&#xE70D;" /></Grid></ToggleButton><Border x:Name="ExpandSite" Grid.Row="1" MinHeight="150" MaxHeight="240" Margin="0,7,0,0" Padding="14" Background="#46FFFFFF" BorderBrush="#64D2E7F6" BorderThickness="1" CornerRadius="10" Visibility="Collapsed"><ContentPresenter /></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
                                            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Margin="0,0,6,0" FontSize="10.5" Foreground="#587793" Text="{Binding SafeMessage}" TextWrapping="Wrap" LineHeight="17" /></ScrollViewer>
                                        </Expander>
                                        <Border Margin="0,8,0,0" Padding="11,9" Background="#46FFFFFF" BorderBrush="#64D2E7F6" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#718AA2" Text="&#xE823;" /><TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="#6F899F" Text="当前范围发生次数" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#526F8B" Text="{Binding FrequencyValueText}" /></Grid></Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="复制诊断详情" Click="CopyDiagnosticDetails_Click" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="OpenPrimaryDiagnosticAction_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding PrimaryActionText}" /></Button></Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EnvironmentPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="38" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="环境变量" /><TextBlock x:Name="EnvironmentSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" /></Grid><TextBox x:Name="EnvironmentFilterTextBox" Grid.Row="2" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="EnvironmentFilterTextBox_TextChanged" ToolTip="搜索变量名或值" /><Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="EnvironmentListBox" Margin="8" Style="{StaticResource SystemList}" SelectionChanged="EnvironmentListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,5"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#708AA2" Text="{Binding Value}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
                <Border Grid.Column="2" Padding="16" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="快速编辑" /><StackPanel Grid.Row="2"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量范围" /><ComboBox x:Name="EnvironmentScopeComboBox" Margin="0,5,0,0" Height="38" Style="{StaticResource SystemComboBox}" SelectionChanged="EnvironmentScopeComboBox_SelectionChanged"><ComboBoxItem Tag="User">当前用户</ComboBoxItem><ComboBoxItem Tag="Machine">系统变量（需要管理员权限）</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Row="4"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量名称" /><TextBox x:Name="EnvironmentNameTextBox" Margin="0,5,0,0" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="EnvironmentNameTextBox_TextChanged" /></StackPanel><StackPanel x:Name="StandardValueEditor" Grid.Row="6"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量值" /><TextBox x:Name="EnvironmentValueTextBox" Margin="0,5,0,0" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource SystemTextBox}" /></StackPanel><Grid x:Name="PathValueEditor" Grid.Row="6" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="34" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="11" Foreground="#6683A0" Text="Path 条目（单独编辑，保存时自动合并）" /><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="68" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="添加目录" Click="AddPathFolder_Click" /><Button Grid.Column="2" Style="{StaticResource SystemButton}" Padding="5,0" Content="新增" Click="AddPathEntry_Click" /><Button Grid.Column="4" Style="{StaticResource SystemButton}" Padding="5,0" Content="上移" Click="MovePathEntryUp_Click" /><Button Grid.Column="6" Style="{StaticResource SystemButton}" Padding="5,0" Content="下移" Click="MovePathEntryDown_Click" /><Button Grid.Column="8" Style="{StaticResource SystemButton}" Padding="5,0" Content="移除" Click="RemovePathEntry_Click" /></Grid><Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="10"><ListBox x:Name="PathEntriesListBox" Margin="6" Style="{StaticResource SystemList}" SelectionChanged="PathEntriesListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBox Margin="4,3" Height="32" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="可直接编辑路径条目" /></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid><Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="清空编辑" Click="ClearEnvironmentEditor_Click" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="SaveEnvironmentVariable_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="保存变量" /></Button></Grid></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
