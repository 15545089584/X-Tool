esource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortProcessHeader" Grid.Column="3" Style="{StaticResource SortableColumnHeader}" Tag="Process" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="占用进程" /><TextBlock x:Name="PortProcessSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortPidHeader" Grid.Column="4" Style="{StaticResource SortableColumnHeader}" Tag="ProcessId" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="PID" /><TextBlock x:Name="PortPidSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortStateHeader" Grid.Column="5" HorizontalContentAlignment="Right" Style="{StaticResource SortableColumnHeader}" Tag="State" Click="PortColumnHeader_Click"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="PortStateSortIndicator" Margin="0,0,4,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /><TextBlock Style="{StaticResource ColumnHeader}" Text="状态" /></StackPanel></Button></Grid><ListBox x:Name="PortsListBox" Grid.Row="1" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding Protocol}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding LocalAddress}" /><TextBlock Grid.Column="2" VerticalAlignment="C