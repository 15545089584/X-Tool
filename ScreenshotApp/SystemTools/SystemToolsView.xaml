<UserControl x:Class="ScreenshotApp.SystemTools.SystemToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SystemCard" TargetType="Border"><Setter Property="Background" Value="#76FFFFFF" /><Setter Property="BorderBrush" Value="#A8D6E9F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="15" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#476581" /></Setter.Value></Setter></Style>
        <Style x:Key="SystemButton" TargetType="Button"><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="16,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemPrimaryButton" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="SystemTextBox" TargetType="TextBox"><Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#3E5C78" /><Setter Property="CaretBrush" Value="#4D7CFE" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemComboBox" TargetType="ComboBox"><Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="FontSize" Value="12" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C9DEFF" /></Trigger></Style.Triggers></Style></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10"><Grid><ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><TextBlock HorizontalAlignment="Right" Margin="0,0,11,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E4F1FFFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F2FAFFFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="200" CanContentScroll="True"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemTab" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Height" Value="42" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#4A6987" /></Style>
        <Style x:Key="SystemList" TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#78FFFFFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#B8DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid Margin="44,42,52,38">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="42" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock FontSize="30" FontWeight="SemiBold" Text="系统工具" /><TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#728195" Text="查看本机端口、进程、服务与环境变量；系统级操作会在执行时明确提示权限要求。" /></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="12" /><ColumnDefinition Width="132" /><ColumnDefinition Width="12" /><ColumnDefinition Width="132" /><ColumnDefinition Width="12" /><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="PortsTabButton" Style="{StaticResource SystemTab}" Content="端口查看器" Tag="Ports" Click="TabButton_Click" />
            <Button x:Name="ProcessesTabButton" Grid.Column="2" Style="{StaticResource SystemTab}" Content="进程管理" Tag="Processes" Click="TabButton_Click" />
            <Button x:Name="ServicesTabButton" Grid.Column="4" Style="{StaticResource SystemTab}" Content="服务管理" Tag="Services" Click="TabButton_Click" />
            <Button x:Name="EnvironmentTabButton" Grid.Column="6" Style="{StaticResource SystemTab}" Content="环境变量" Tag="Environment" Click="TabButton_Click" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid x:Name="PortsPanel"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions><TextBox x:Name="PortFilterTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="PortFilterTextBox_TextChanged" ToolTip="按端口、进程或 PID 筛选" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="RefreshPorts_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="刷新端口" /></Button></Grid></Border>
                <Border Grid.Row="2" Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="端口与占用进程" /><TextBlock x:Name="PortsSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="正在读取…" /></Grid><Border Grid.Row="2" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="PortsListBox" Margin="8" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding Protocol}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding LocalAddress}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ProcessId}" /><TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding State}" /><Grid.ContextMenu><ContextMenu><MenuItem Header="打开进程目录" Click="OpenProcessDirectory_Click" /><MenuItem Header="结束进程" Click="EndProcess_Click" /></ContextMenu></Grid.ContextMenu></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
            </Grid>

            <Grid x:Name="ProcessesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions><TextBox x:Name="ProcessFilterTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="ProcessFilterTextBox_TextChanged" ToolTip="按程序、PID 或路径筛选" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="RefreshProcesses_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="刷新进程" /></Button></Grid></Border>
                <Border Grid.Row="2" Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="运行中的进程" /><TextBlock x:Name="ProcessesSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="按内存排序" /></Grid><Border Grid.Row="2" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="ProcessesListBox" Margin="8" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="80" /><ColumnDefinition Width="105" /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ProcessId}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding CpuText}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding MemoryText}" /><TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding StartedAtText}" /><Grid.ContextMenu><ContextMenu><MenuItem Header="打开进程目录" Click="OpenProcessDirectory_Click" /><MenuItem Header="结束进程" Click="EndProcess_Click" /></ContextMenu></Grid.ContextMenu></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
            </Grid>

            <Grid x:Name="ServicesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions><TextBox x:Name="ServiceFilterTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="ServiceFilterTextBox_TextChanged" ToolTip="搜索服务名称，例如 MySQL、Redis、Docker" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="RefreshServices_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="刷新服务" /></Button></Grid></Border>
                <Border Grid.Row="2" Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="Windows 服务" /><TextBlock x:Name="ServicesSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="启动或停止时可能需要管理员权限" /></Grid><Border Grid.Row="2" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="ServicesListBox" Margin="8" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" Foreground="#45627E" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#7890A6" Text="{Binding Name}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding Status}" /><Button Grid.Column="2" Margin="4,0" Style="{StaticResource SystemButton}" Content="启动" Click="StartService_Click" /><Button Grid.Column="3" Margin="4,0" Style="{StaticResource SystemButton}" Content="停止" Click="StopService_Click" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
            </Grid>

            <Grid x:Name="EnvironmentPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="38" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="环境变量" /><TextBlock x:Name="EnvironmentSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" /></Grid><TextBox x:Name="EnvironmentFilterTextBox" Grid.Row="2" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="EnvironmentFilterTextBox_TextChanged" ToolTip="搜索变量名或值" /><Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="EnvironmentListBox" Margin="8" Style="{StaticResource SystemList}" SelectionChanged="EnvironmentListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,5"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#708AA2" Text="{Binding Value}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
                <Border Grid.Column="2" Padding="16" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="快速编辑" /><StackPanel Grid.Row="2"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量范围" /><ComboBox x:Name="EnvironmentScopeComboBox" Margin="0,5,0,0" Height="38" Style="{StaticResource SystemComboBox}" SelectionChanged="EnvironmentScopeComboBox_SelectionChanged"><ComboBoxItem Tag="User">当前用户</ComboBoxItem><ComboBoxItem Tag="Machine">系统变量（需要管理员权限）</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Row="4"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量名称" /><TextBox x:Name="EnvironmentNameTextBox" Margin="0,5,0,0" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" /></StackPanel><StackPanel Grid.Row="6"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量值" /><TextBox x:Name="EnvironmentValueTextBox" Margin="0,5,0,0" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource SystemTextBox}" /></StackPanel><Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="清空编辑" Click="ClearEnvironmentEditor_Click" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="SaveEnvironmentVariable_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="保存变量" /></Button></Grid></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
