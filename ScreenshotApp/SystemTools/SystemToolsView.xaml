                                        </ComboBox>
                                        <Grid Grid.Column="2">
                                            <TextBox x:Name="DriverFilterTextBox" Height="38" Padding="34,0,12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="DriverFilterTextBox_TextChanged" ToolTip="按设备、类别、提供商、版本或 INF 文件筛选" />
                                            <TextBlock Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Foreground="#7690AA" IsHitTestVisible="False" Text="⌕" />
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid Margin="10,0,22,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ColumnHeader}" Text="设备与类别" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="提供商 / INF" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="驱动版本" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="驱动日期" />
                                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="状态" />
                                            </Grid>
                                            <ItemsControl x:Name="DriverInfoItems" Grid.Row="1">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2,0,2,6" Padding="10,9" Background="#78FFFFFF" BorderBrush="#54D5E8F7" BorderThickness="1" CornerRadius="10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="32" Height="32" VerticalAlignment="Center" Background="Transparent" BorderBrush="#35D4E8F8" BorderThickness="1" CornerRadius="10"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{Binding Accent}" Text="{Binding Icon}" /></Border>
                                                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
                                                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{Binding Accent}" Text="{Binding Category}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11" Foreground="#567EA9" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Provider}" />
                                                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#7890A6" Text="{Binding InfText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InfText}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding DriverDateText}" />
                                                                <Border Grid.Column="4" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#6FFFFFFF" BorderBrush="{Binding StatusAccent}" BorderThickness="1" CornerRadius="9"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusAccent}" Text="{Binding StatusText}" /></Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel x:Name="DriverEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="#7690AA" Text="&#xE9D2;" />
                                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="没有匹配的驱动信息" />
                                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#728195" Text="请调整筛选条件，或点击上方的刷新信息重新读取。" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid x:Name="StoragePanel" Visibility="Collapsed">
                <Border Padding="15" Style="{StaticResource SystemCard}">
                    <Grid>
                        <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#45627E">
                            <Border Width="72" Height="72" HorizontalAlignment="Center" Background="#54FFFFFF" BorderBrush="#8ED6E9F8" BorderThickness="1" CornerRadius="22"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#16B99B" Text="&#xEDA2;" /></Border>
                            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" Text="存储空间" />
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="#728195" Text="存储空间功能正在准备中" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="后续会在这里展示磁盘分区、可用空间与存储健康信息。" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="EnvironmentPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="38" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="环境变量" /><TextBlock x:Name="EnvironmentSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" /></Grid><TextBox x:Name="EnvironmentFilterTextBox" Grid.Row="2" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="EnvironmentFilterTextBox_TextChanged" ToolTip="搜索变量名或值" /><Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><ListBox x:Name="EnvironmentListBox" Margin="8" Style="{StaticResource SystemList}" SelectionChanged="EnvironmentListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,5"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#45627E" Text="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#708AA2" Text="{Binding Value}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></Border>
                <Border Grid.Column="2" Padding="16" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="快速编辑" /><StackPanel Grid.Row="2"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量范围" /><ComboBox x:Name="EnvironmentScopeComboBox" Margin="0,5,0,0" Height="38" Style="{StaticResource SystemComboBox}" SelectionChanged="EnvironmentScopeComboBox_SelectionChanged"><ComboBoxItem Tag="User">当前用户</ComboBoxItem><ComboBoxItem Tag="Machine">系统变量（需要管理员权限）</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Row="4"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量名称" /><TextBox x:Name="EnvironmentNameTextBox" Margin="0,5,0,0" Height="38" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="EnvironmentNameTextBox_TextChanged" /></StackPanel><StackPanel x:Name="StandardValueEditor" Grid.Row="6"><TextBlock FontSize="11" Foreground="#6683A0" Text="变量值" /><TextBox x:Name="EnvironmentValueTextBox" Margin="0,5,0,0" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource SystemTextBox}" /></StackPanel><Grid x:Name="PathValueEditor" Grid.Row="6" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="34" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="11" Foreground="#6683A0" Text="Path 条目（单独编辑，保存时自动合并）" /><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="68" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /><ColumnDefinition Width="8" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="添加目录" Click="AddPathFolder_Click" /><Button Grid.Column="2" Style="{StaticResource SystemButton}" Padding="5,0" Content="新增" Click="AddPathEntry_Click" /><Button Grid.Column="4" Style="{StaticResource SystemButton}" Padding="5,0" Content="上移" Click="MovePathEntryUp_Click" /><Button Grid.Column="6" Style="{StaticResource SystemButton}" Padding="5,0" Content="下移" Click="MovePathEntryDown_Click" /><Button Grid.Column="8" Style="{StaticResource SystemButton}" Padding="5,0" Content="移除" Click="RemovePathEntry_Click" /></Grid><Border Grid.Row="4" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="10"><ListBox x:Name="PathEntriesListBox" Margin="6" Style="{StaticResource SystemList}" SelectionChanged="PathEntriesListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBox Margin="4,3" Height="32" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="可直接编辑路径条目" /></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid><Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource SystemButton}" Content="清空编辑" Click="ClearEnvironmentEditor_Click" /><Button Grid.Column="2" Style="{StaticResource SystemPrimaryButton}" Click="SaveEnvironmentVariable_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="保存变量" /></Button></Grid></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
