            <Button x:Name="EnvironmentTabButton" Grid.Column="6" Style="{StaticResource SystemTab}" Tag="Environment" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="环境变量" /></Button>
