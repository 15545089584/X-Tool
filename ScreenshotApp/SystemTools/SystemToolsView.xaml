<UserControl x:Class="ScreenshotApp.SystemTools.SystemToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SystemCard" TargetType="Border"><Setter Property="Background" Value="#76FFFFFF" /><Setter Property="BorderBrush" Value="#A8D6E9F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="15" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#476581" /></Setter.Value></Setter></Style>
        <Style x:Key="SystemButton" TargetType="Button"><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="16,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A6D1E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemPrimaryButton" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style x:Key="SystemTextBox" TargetType="TextBox"><Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#3E5C78" /><Setter Property="CaretBrush" Value="#4D7CFE" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="Background" Value="#EAF4FFFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemComboBox" TargetType="ComboBox"><Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#A9CEE8F8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="FontSize" Value="12" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C9DEFF" /></Trigger></Style.Triggers></Style></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Root" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10"><Grid><ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><TextBlock HorizontalAlignment="Right" Margin="0,0,11,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E4F1FFFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEBFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F2FAFFFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#456886" /></Border.Effect><ScrollViewer MaxHeight="200" CanContentScroll="True"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemTab" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Height" Value="42" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#4A6987" /></Style>
        <Style x:Key="DirectionButton" TargetType="Button" BasedOn="{StaticResource SystemButton}"><Setter Property="Width" Value="42" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#65819D" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="SortableColumnHeader" TargetType="Button"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#6DFFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SystemCheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="#52708E" /><Setter Property="FontSize" Value="11" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="Box" Width="17" Height="17" Background="#88FFFFFF" BorderBrush="#A6CDE5F6" BorderThickness="1" CornerRadius="5"><TextBlock x:Name="Tick" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0" Text="✓" /></Border><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4D7CFE" /><Setter TargetName="Box" Property="BorderBrush" Value="#4D7CFE" /><Setter TargetName="Tick" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="AutoRefreshHost" TargetType="Border"><Setter Property="Height" Value="42" /><Setter Property="Background" Value="#8CFFFFFF" /><Setter Property="BorderBrush" Value="#B6D9EBF8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="13" /><Setter Property="Padding" Value="7,4" /><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#476581" /></Setter.Value></Setter></Style>
        <Style x:Key="GlassScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="9" /><Setter Property="Margin" Value="3,7,3,7" /><Setter Property="Background" Value="#38D3E5F5" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#89A9C7E5" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
        <Style x:Key="SystemList" TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" /><Setter Property="ScrollViewer.CanContentScroll" Value="True" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#78FFFFFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#B8DCEBFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
        <Style TargetType="MenuItem"><Style.Triggers><Trigger Property="Header" Value="定位到进程"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Grid Margin="44,42,52,38">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="42" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock FontSize="30" FontWeight="SemiBold" Text="系统工具" /><TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#728195" Text="查看设备信息、存储空间与环境变量；系统级操作会在执行时明确提示权限要求。" /></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="122" /><ColumnDefinition Width="10" /><ColumnDefinition Width="122" /><ColumnDefinition Width="10" /><ColumnDefinition Width="122" /><ColumnDefinition Width="10" /><ColumnDefinition Width="122" /><ColumnDefinition Width="10" /><ColumnDefinition Width="122" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="OverviewTabButton" Style="{StaticResource SystemTab}" Tag="Overview" Click="TabButton_Click" Visibility="Collapsed"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="设备信息" /></Button>
            <Button x:Name="PortsTabButton" Style="{StaticResource SystemTab}" Tag="Ports" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="端口查看器" /></Button>
            <Button x:Name="ProcessesTabButton" Grid.Column="2" Style="{StaticResource SystemTab}" Tag="Processes" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="进程管理" /></Button>
            <Button x:Name="ServicesTabButton" Grid.Column="4" Style="{StaticResource SystemTab}" Tag="Services" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="服务管理" /></Button>
            <Button x:Name="RelationsTabButton" Grid.Column="6" Style="{StaticResource SystemTab}" Tag="Relations" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="关联关系" /></Button>
            <Button x:Name="StorageTabButton" Grid.Column="2" Style="{StaticResource SystemTab}" Tag="Storage" Click="TabButton_Click" Visibility="Collapsed"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="存储" /></Button>
            <Button x:Name="EnvironmentTabButton" Grid.Column="4" Style="{StaticResource SystemTab}" Tag="Environment" Click="TabButton_Click"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="环境变量" /></Button>
            <Border x:Name="AutoRefreshHostPanel" Grid.Column="9" HorizontalAlignment="Right" Style="{StaticResource AutoRefreshHost}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="AutoRefreshCheckBox" VerticalAlignment="Center" Content="自动刷新" Style="{StaticResource SystemCheckBox}" Checked="AutoRefreshCheckBox_Changed" Unchecked="AutoRefreshCheckBox_Changed" />
                    <ComboBox x:Name="AutoRefreshIntervalComboBox" Grid.Column="2" Height="32" Style="{StaticResource SystemComboBox}" SelectionChanged="AutoRefreshIntervalComboBox_SelectionChanged"><ComboBoxItem Tag="3">3 秒</ComboBoxItem><ComboBoxItem Tag="5">5 秒</ComboBoxItem><ComboBoxItem Tag="10">10 秒</ComboBoxItem><ComboBoxItem Tag="30">30 秒</ComboBoxItem></ComboBox>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Grid x:Name="PortsPanel"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="214" /><ColumnDefinition Width="12" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions><Grid><TextBox x:Name="PortFilterTextBox" Height="38" Padding="36,0,12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="PortFilterTextBox_TextChanged" ToolTip="按端口、进程或 PID 筛选" /><TextBlock Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Foreground="#7690AA" IsHitTestVisible="False" Text="⌕" /></Grid><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox x:Name="ShowSystemProcessesCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" Content="显示系统进程" IsChecked="True" Style="{StaticResource SystemCheckBox}" Checked="PortDisplayOption_Changed" Unchecked="PortDisplayOption_Changed" /><CheckBox x:Name="ShowIPv6CheckBox" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="显示 IPv6" IsChecked="True" Style="{StaticResource SystemCheckBox}" Checked="PortDisplayOption_Changed" Unchecked="PortDisplayOption_Changed" /></Grid><Button Grid.Column="4" Style="{StaticResource SystemPrimaryButton}" Click="RefreshPorts_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="刷新端口" /></Button></Grid></Border>
                <Border Grid.Row="2" Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="端口与占用进程" /><TextBlock x:Name="PortsSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="正在读取…" /></Grid><Border Grid.Row="2" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="6,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><Button x:Name="PortProtocolHeader" Style="{StaticResource SortableColumnHeader}" Tag="Protocol" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="协议" /><TextBlock x:Name="PortProtocolSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortAddressHeader" Grid.Column="1" Style="{StaticResource SortableColumnHeader}" Tag="LocalAddress" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="本地地址" /><TextBlock x:Name="PortAddressSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortNumberHeader" Grid.Column="2" Style="{StaticResource SortableColumnHeader}" Tag="Port" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="端口" /><TextBlock x:Name="PortNumberSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortProcessHeader" Grid.Column="3" Style="{StaticResource SortableColumnHeader}" Tag="Process" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="占用进程" /><TextBlock x:Name="PortProcessSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortPidHeader" Grid.Column="4" Style="{StaticResource SortableColumnHeader}" Tag="ProcessId" Click="PortColumnHeader_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeader}" Text="PID" /><TextBlock x:Name="PortPidSortIndicator" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /></StackPanel></Button><Button x:Name="PortStateHeader" Grid.Column="5" HorizontalContentAlignment="Right" Style="{StaticResource SortableColumnHeader}" Tag="State" Click="PortColumnHeader_Click"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="PortStateSortIndicator" Margin="0,0,4,0" Style="{StaticResource ColumnHeader}" Foreground="#4D7CFE" /><TextBlock Style="{StaticResource ColumnHeader}" Text="状态" /></StackPanel></Button></Grid><ListBox x:Name="PortsListBox" Grid.Row="1" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding Protocol}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding LocalAddress}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding Port}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}" /><TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ProcessId}" /><TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding State}" /><Grid.ContextMenu><ContextMenu><MenuItem Header="定位到进程" Click="LocateProcessByPid_Click" /><Separator /><MenuItem Header="打开进程目录" Click="OpenProcessDirectory_Click" /><MenuItem Header="结束进程" Click="EndProcess_Click" /></ContextMenu></Grid.ContextMenu></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></Border>
            </Grid>
            <Grid x:Name="ProcessesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="214" /><ColumnDefinition Width="12" /><ColumnDefinition Width="114" /></Grid.ColumnDefinitions><Grid><TextBox x:Name="ProcessFilterTextBox" Height="38" Padding="36,0,12,0" VerticalContentAlignment="Center" Style="{StaticResource SystemTextBox}" TextChanged="ProcessFilterTextBox_TextChanged" ToolTip="按程序、PID 或路径筛选" /><TextBlock Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Foreground="#7690AA" IsHitTestVisible="False" Text="⌕" /></Grid><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox x:Name="ShowActiveProcessesCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" Content="仅显示活动进程" IsChecked="False" Style="{StaticResource SystemCheckBox}" Checked="ProcessDisplayOption_Changed" Unchecked="ProcessDisplayOption_Changed" /><CheckBox x:Name="ShowSystemProcessEntriesCheckBox" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="显示系统进程" IsChecked="True" Style="{StaticResource SystemCheckBox}" Checked="ProcessDisplayOption_Changed" Unchecked="ProcessDisplayOption_Changed" /></Grid><Button Grid.Column="4" Style="{StaticResource SystemPrimaryButton}" Click="RefreshProcesses_Click"><TextBlock FontWeight="SemiBold" Foreground="White" Text="刷新进程" /></Button></Grid></Border>
                <Border Grid.Row="2" Padding="14" Style="{StaticResource SystemCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="运行中的进程" /><TextBlock x:Name="ProcessesSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#637E9B" Text="正在读取…" /></Grid><Border Grid.Row="2" Background="#36E8F2FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="11"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="6,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /><ColumnDefinition Width="64" /><ColumnDefinition Width="94" /><ColumnDefinition Width="94" /><ColumnDefinition Width="98" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource ColumnHeader}" Text="应用 / 子进程（路径可右键打开）" /><TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="PID" /><TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="CPU" /><TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="内存" /><TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="磁盘(MB/s)" /><TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="网络(Mbps)" ToolTip="基于 Windows 进程其它 I/O 统计的近似网络速率" /><TextBlock Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="启动时间" /></Grid><ListBox x:Name="ProcessesListBox" Grid.Row="1" Style="{StaticResource SystemList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /><ColumnDefinition Width="64" /><ColumnDefinition Width="94" /><ColumnDefinition Width="94" /><ColumnDefinition Width="98" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Width="22" Height="24" Padding="0" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#4D7CFE" Content="{Binding ExpandGlyph}" ToolTip="展开或收起子进程" Click="ProcessRowToggle_Click" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#45627E" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal" /><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger><DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter Property="Margin" Value="12,0,0,0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding ProcessIdText}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding CpuText}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding MemoryText}" /><TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding DiskText}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding NetworkText}" /><TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#617D98" Text="{Binding StartedAtText}" /><Grid.ContextMenu><ContextMenu><MenuItem Header="打开进程目录" Click="OpenProcessDirectory_Click" /><MenuItem Header="结束进程" Click="EndProcess_Click" /></ContextMenu></Grid.ContextMenu></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></Border>
            </Grid>
            <Grid x:Name="ServicesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
