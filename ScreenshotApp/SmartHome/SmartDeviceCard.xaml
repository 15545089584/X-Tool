<UserControl x:Class="ScreenshotApp.SmartHome.SmartDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="Root"
             MinWidth="168" Height="252" Margin="7">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XTool;component/SmartHome/SmartHomeFrostedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardMenuButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SmartHomeTextMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#8AFFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="CardSurface" Padding="13" BorderThickness="1" CornerRadius="22" Cursor="Hand" Focusable="True"
            DataContext="{Binding Device, ElementName=Root}"
            MouseLeftButtonUp="CardSurface_MouseLeftButtonUp" KeyDown="CardSurface_KeyDown"
            AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="打开设备详情">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#D9FFFFFF" />
                <Setter Property="BorderBrush" Value="#94FFFFFF" />
                <Setter Property="Effect" Value="{StaticResource SmartHomeCardShadow}" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Background" Value="#EEFFFFFF" />
                        <Setter Property="BorderBrush" Value="#E8FFFFFF" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FAFFFFFF" />
                        <Setter Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderStrongBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource SmartHomePrimaryBrush}" /></Trigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter Property="Opacity" Value="0.56" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CardMenuButtonStyle}"
                    Click="OpenDetails_Click" Panel.ZIndex="8" AutomationProperties.Name="打开设备详情">
                <iconPacks:PackIconMaterial Width="18" Height="18" Kind="DotsHorizontal" />
            </Button>

            <Grid Margin="0,0,0,3">
                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                       Source="{Binding DeviceArtworkUri}" Opacity="{Binding ArtworkOpacity}"
                       RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="{Binding ArtworkScale}" ScaleY="{Binding ArtworkScale}" />
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="MaxWidth" Value="146" />
                            <Setter Property="MaxHeight" Value="118" />
                            <Setter Property="Margin" Value="0,2,0,4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsLightArtwork}" Value="True">
                                    <Setter Property="MaxWidth" Value="98" />
                                    <Setter Property="MaxHeight" Value="110" />
                                    <Setter Property="Margin" Value="0,-2,18,12" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Ellipse Width="88" Height="88" Fill="{Binding AccentBackground}" Opacity="0.72" />
                    <iconPacks:PackIconMaterial Width="49" Height="49" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{Binding AccentBrush}" Kind="{Binding IconKind}" />
                </Grid>

                <Grid Panel.ZIndex="4">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsLightArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Slider x:Name="ColorTemperatureSlider" Height="78" Margin="0,14,8,23" HorizontalAlignment="Right"
                            Style="{StaticResource SmartHomeCardVerticalSliderStyle}" Value="{Binding ColorTemperaturePercent, Mode=OneWay}"
                            IsEnabled="{Binding SupportsColorTemperature}" ToolTip="色温"
                            PreviewMouseLeftButtonUp="ColorTemperatureSlider_Commit" KeyUp="ColorTemperatureSlider_KeyUp"
                            AutomationProperties.Name="色温" />
                    <Slider x:Name="CardBrightnessSlider" Width="112" Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Style="{StaticResource SmartHomeCardHorizontalSliderStyle}" Value="{Binding BrightnessPercent, Mode=OneWay}"
                            IsEnabled="{Binding SupportsBrightness}" ToolTip="亮度"
                            PreviewMouseLeftButtonUp="CardBrightnessSlider_Commit" KeyUp="CardBrightnessSlider_KeyUp"
                            AutomationProperties.Name="亮度" />
                </Grid>

                <Border Width="64" Height="29" Margin="0,31,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="7,0" Background="#D9818A9A" CornerRadius="13" Panel.ZIndex="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsClimateArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="White" Text="{Binding TargetTemperatureText}" />
                </Border>

                <Border Width="66" Height="50" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F2D9E1E2" CornerRadius="5" Panel.ZIndex="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsThermoHygrometerArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#35424D" Text="{Binding LiveTemperatureText}" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#52616C" Text="{Binding LiveHumidityText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1" Margin="2,2,2,0" HorizontalAlignment="Center" MaxWidth="168"
                       FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}"
                       Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Grid.Row="2" Margin="2,4,2,0" HorizontalAlignment="Center" MaxWidth="168"
                       FontSize="10.5" Foreground="{StaticResource SmartHomeTextMutedBrush}"
                       Text="{Binding AreaName}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" Margin="2,4,2,0" HorizontalAlignment="Center" MaxWidth="168"
                       FontSize="9.5" Foreground="{StaticResource SmartHomeTextSecondaryBrush}"
                       Text="{Binding CompactState}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />

            <Border Grid.Row="4" Width="46" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    CornerRadius="3" IsHitTestVisible="False" AutomationProperties.Name="设备工作状态">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SmartHomeInactiveTrackBrush}" />
                        <Setter Property="Opacity" Value="0.55" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                <Setter Property="Background" Value="#526FAD" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Effect" Value="{StaticResource SmartHomeCardShadow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.26" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Border>
</UserControl>
