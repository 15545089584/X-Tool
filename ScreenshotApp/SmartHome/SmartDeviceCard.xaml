<UserControl x:Class="ScreenshotApp.SmartHome.SmartDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="304" MinHeight="272" Margin="8">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#ECF3FA" />
            <Setter Property="Foreground" Value="#405F7C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.66" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7FBFE" />
            <Setter Property="Foreground" Value="#344F67" />
            <Setter Property="BorderBrush" Value="#C7DAE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Border Padding="18,16" Background="#D9FFFFFF" BorderBrush="#B8E2ECF5" BorderThickness="1" CornerRadius="20"
            DataContext="{Binding Device, ElementName=Root}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.10" Color="#496A88" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="{Binding AccentBackground}" CornerRadius="13">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"
                               FontSize="20" Foreground="{Binding AccentBrush}" Text="{Binding IconGlyph}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#71869A" Text="{Binding AreaName}" />
                </StackPanel>
                <Border Grid.Column="3" Height="25" Padding="9,0" VerticalAlignment="Top" Background="#E8F5F0" CornerRadius="9">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#2BAE83" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Fill" Value="#B0BAC4" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#527267" Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#243E56" Text="{Binding MainState}" />
                <TextBlock Margin="0,4,0,0" Height="17" FontSize="10.5" Foreground="#7A8EA1"
                           Text="{Binding SupportingSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="4" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="亮度" />
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrightnessPercent, Mode=OneWay}"
                        IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="亮度"
                        PreviewMouseLeftButtonUp="BrightnessSlider_Commit" KeyUp="BrightnessSlider_KeyUp" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#607B93"
                           Text="{Binding BrightnessPercent, StringFormat={}{0:0}%}" />
            </Grid>

            <StackPanel Grid.Row="4" Visibility="{Binding IsClimate, Converter={StaticResource BoolToVisibility}}">
                <Grid Visibility="{Binding SupportsTargetTemperature, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="74" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="目标温度" />
                    <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Content="−" Click="DecreaseTemperature_Click" IsEnabled="{Binding IsAvailable}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Text="{Binding TargetTemperatureText}" />
                    <Button Grid.Column="3" Style="{StaticResource CardButtonStyle}" Content="+" Click="IncreaseTemperature_Click" IsEnabled="{Binding IsAvailable}" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding SupportsHvacMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="运行模式" />
                    <ComboBox x:Name="HvacModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                              Style="{StaticResource CardComboBoxStyle}" ItemsSource="{Binding HvacModeOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CurrentHvacMode, Mode=OneWay}"
                              IsEnabled="{Binding IsAvailable}" SelectionChanged="HvacModeComboBox_SelectionChanged" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding SupportsFanMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="空调风速" />
                    <ComboBox x:Name="ClimateFanModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                              Style="{StaticResource CardComboBoxStyle}" ItemsSource="{Binding FanModeOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CurrentFanMode, Mode=OneWay}"
                              IsEnabled="{Binding IsAvailable}" SelectionChanged="FanModeComboBox_SelectionChanged" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding SupportsSwingMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="摆风" />
                    <ComboBox x:Name="SwingModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                              Style="{StaticResource CardComboBoxStyle}" ItemsSource="{Binding SwingModeOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CurrentSwingMode, Mode=OneWay}"
                              IsEnabled="{Binding IsAvailable}" SelectionChanged="SwingModeComboBox_SelectionChanged" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding SupportsPreset, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="预设模式" />
                    <ComboBox x:Name="ClimatePresetComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                              Style="{StaticResource CardComboBoxStyle}" ItemsSource="{Binding PresetModeOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CurrentPresetMode, Mode=OneWay}"
                              IsEnabled="{Binding IsAvailable}" SelectionChanged="PresetComboBox_SelectionChanged" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="4" Visibility="{Binding SupportsCoverPosition, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="位置" />
                    <Slider x:Name="CoverSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CoverPosition, Mode=OneWay}"
                            IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="窗帘位置"
                            PreviewMouseLeftButtonUp="CoverSlider_Commit" KeyUp="CoverSlider_KeyUp" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#607B93"
                               Text="{Binding CoverPosition, StringFormat={}{0:0}%}" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource CardButtonStyle}" Content="打开" Tag="Open" Click="CoverAction_Click" IsEnabled="{Binding IsAvailable}" />
                    <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Content="停止" Tag="Stop" Click="CoverAction_Click" IsEnabled="{Binding IsAvailable}" />
                    <Button Grid.Column="4" Style="{StaticResource CardButtonStyle}" Content="关闭" Tag="Close" Click="CoverAction_Click" IsEnabled="{Binding IsAvailable}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="4" Visibility="{Binding IsFan, Converter={StaticResource BoolToVisibility}}">
                <Grid Visibility="{Binding SupportsFanPercentage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="风速" />
                    <Slider x:Name="FanSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FanPercentage, Mode=OneWay}"
                            IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="风速"
                            PreviewMouseLeftButtonUp="FanSlider_Commit" KeyUp="FanSlider_KeyUp" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#607B93"
                               Text="{Binding FanPercentage, StringFormat={}{0:0}%}" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding SupportsPreset, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#607B93" Text="风类模式" />
                    <ComboBox x:Name="FanPresetComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                              Style="{StaticResource CardComboBoxStyle}" ItemsSource="{Binding PresetModeOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CurrentPresetMode, Mode=OneWay}"
                              IsEnabled="{Binding IsAvailable}" SelectionChanged="PresetComboBox_SelectionChanged" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="6">
                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#B45D69" Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" />
                <Button Width="74" HorizontalAlignment="Right" Style="{StaticResource CardButtonStyle}" Background="{Binding AccentBrush}"
                        Foreground="White" Content="{Binding ToggleLabel}" Click="Toggle_Click" IsEnabled="{Binding IsAvailable}"
                        Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
