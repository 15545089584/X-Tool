<UserControl x:Class="ScreenshotApp.SmartHome.SmartDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="Root" Width="308" Height="126" Margin="7">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XTool;component/SmartHome/SmartHomeFrostedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="CardActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Background" Value="#B5EDF1F7" />
                <Setter Property="Foreground" Value="#65758E" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="21">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F4FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Background" Value="#526FAD" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="CardSurface" Padding="13" BorderThickness="1" CornerRadius="21" Cursor="Hand" Focusable="True"
            DataContext="{Binding Device, ElementName=Root}"
            MouseLeftButtonUp="CardSurface_MouseLeftButtonUp" KeyDown="CardSurface_KeyDown"
            AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="打开设备详情">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#DDF7F8FC" />
                <Setter Property="BorderBrush" Value="#AFFFFFFF" />
                <Setter Property="Effect" Value="{StaticResource SmartHomeCardShadow}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="#EEF9FAFE" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FAFFFFFF" /></Trigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.52" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="94" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <Border Width="88" Height="96" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="#56EAF0F8" BorderBrush="#86FFFFFF" BorderThickness="1" CornerRadius="19">
                <Grid ClipToBounds="True">
                    <Image Margin="4" Stretch="Uniform" Source="{Binding DeviceArtworkUri}" Opacity="{Binding ArtworkOpacity}"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                        </Grid.Style>
                        <Ellipse Width="72" Height="72" Fill="{Binding AccentBackground}" />
                        <iconPacks:PackIconMaterial Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{Binding AccentBrush}" Kind="{Binding IconKind}" />
                    </Grid>

                    <!-- 原创温湿度计的屏幕区域只替换数字，保留机身与液晶质感。 -->
                    <Border Width="36" Height="35" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#F2D2DCDD" BorderBrush="#425F6B72" BorderThickness="1" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsThermoHygrometerArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="#27353C" Text="{Binding LiveTemperatureText}" />
                            <Border Height="1" Margin="4,1.5" Background="#66707B7F" />
                            <TextBlock HorizontalAlignment="Center" FontSize="7.5" FontWeight="SemiBold" Foreground="#33454D" Text="{Binding LiveHumidityText}" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="11,8,7,8" VerticalAlignment="Center">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}"
                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource SmartHomeTextSecondaryBrush}"
                           Text="{Binding CompactState}" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#28B486" /><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Fill" Value="#B4BEC8" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="10" Foreground="{StaticResource SmartHomeTextMutedBrush}" Text="{Binding AreaName}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="2">
                <Button VerticalAlignment="Center" Style="{StaticResource CardActionButtonStyle}" Click="Toggle_Click"
                        IsEnabled="{Binding CanInteract}" Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding ToggleLabel}">
                    <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="Power" />
                </Button>
                <Button Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="OpenDetails_Click" AutomationProperties.Name="打开设备详情">
                    <Button.Style>
                        <Style TargetType="Button"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding CanToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                    </Button.Style>
                    <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="#71829A" Kind="ChevronRight" />
                </Button>
            </Grid>

            <Border Grid.ColumnSpan="3" Width="48" Height="4" Margin="0,0,0,-3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    CornerRadius="2" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border"><Setter Property="Background" Value="#D0D8E2" /><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Background" Value="#526FAD" /></DataTrigger></Style.Triggers></Style>
                </Border.Style>
            </Border>
        </Grid>
    </Border>
</UserControl>
