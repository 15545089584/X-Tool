<UserControl x:Class="ScreenshotApp.SmartHome.SmartDeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="Root" MinWidth="300" Height="158" Margin="9">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XTool;component/SmartHome/SmartHomeFrostedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- 卡片总开关：始终蓝底白图标；开合状态由状态文字与运行短条表达。 -->
            <Style x:Key="CardActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="50" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Background" Value="#4D7CFE" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="25">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#6F90FE" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="CardSurface" Padding="16" BorderThickness="1" CornerRadius="23" Cursor="Hand" Focusable="True"
            DataContext="{Binding Device, ElementName=Root}"
            MouseLeftButtonUp="CardSurface_MouseLeftButtonUp" KeyDown="CardSurface_KeyDown"
            AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="打开设备详情">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#DDF7F8FC" />
                <Setter Property="BorderBrush" Value="#AFFFFFFF" />
                <Setter Property="Effect" Value="{StaticResource SmartHomeCardShadow}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="#EEF9FAFE" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FAFFFFFF" /></Trigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.52" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>

            <Border Width="110" Height="122" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="#56EAF0F8" BorderBrush="#86FFFFFF" BorderThickness="1" CornerRadius="22">
                <Grid ClipToBounds="True">
                    <Image Margin="4" Stretch="Uniform" Source="{Binding DeviceArtworkUri}" Opacity="{Binding ArtworkOpacity}"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <!-- bulb.png 画布内容整体偏右约 9%，卡片显示时向左补偿。 -->
                                    <DataTrigger Binding="{Binding IsLightArtwork}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><TranslateTransform X="-10" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                        </Grid.Style>
                        <Ellipse Width="88" Height="88" Fill="{Binding AccentBackground}" />
                        <iconPacks:PackIconMaterial Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{Binding AccentBrush}" Kind="{Binding IconKind}" />
                    </Grid>

                    <!-- 原创温湿度计的屏幕区域只替换数字，保留机身与液晶质感。 -->
                    <Border Width="43" Height="41" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#F2D2DCDD" BorderBrush="#425F6B72" BorderThickness="1" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsThermoHygrometerArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="#27353C" Text="{Binding LiveTemperatureText}" />
                            <Border Height="1" Margin="4,1.5" Background="#66707B7F" />
                            <TextBlock HorizontalAlignment="Center" FontSize="8.5" FontWeight="SemiBold" Foreground="#33454D" Text="{Binding LiveHumidityText}" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,10,9,10" VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}"
                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Margin="0,7,0,0" FontSize="12.5" Foreground="{StaticResource SmartHomeTextSecondaryBrush}"
                           Text="{Binding CompactState}" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SmartHomeTextMutedBrush}" Text="{Binding AreaName}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="2">
                <Button VerticalAlignment="Center" Style="{StaticResource CardActionButtonStyle}" Click="Toggle_Click"
                        IsEnabled="{Binding CanInteract}" Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding ToggleLabel}">
                    <iconPacks:PackIconMaterial Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="Power" />
                </Button>
                <Button Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="OpenDetails_Click" AutomationProperties.Name="打开设备详情">
                    <Button.Style>
                        <Style TargetType="Button"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding CanToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                    </Button.Style>
                    <iconPacks:PackIconMaterial Width="24" Height="24" Foreground="#71829A" Kind="ChevronRight" />
                </Button>
            </Grid>

            <!-- 运行状态短条：设备运行中显示绿色，未运行显示灰色，居中对齐中间文字区；离线设备不显示短条。 -->
            <Border Grid.Column="1" Width="62" Height="5" Margin="0,0,0,-4" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    CornerRadius="2.5" IsHitTestVisible="False"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border"><Setter Property="Background" Value="#D0D8E2" /><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Background" Value="#28B486" /></DataTrigger></Style.Triggers></Style>
                </Border.Style>
            </Border>
        </Grid>
    </Border>
</UserControl>
