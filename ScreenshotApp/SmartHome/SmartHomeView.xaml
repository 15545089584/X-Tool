<UserControl x:Class="ScreenshotApp.SmartHome.SmartHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenshotApp.SmartHome"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XTool;component/SmartHome/SmartHomeFrostedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{StaticResource SmartHomePrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="#78FFFFFF" BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SmartHomePrimaryHoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SmartHomeGlassControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource SmartHomeGlassBorderBrush}" BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6FFFFFF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SmartHomePrimaryBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.80" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SmartHomeGlassControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource SmartHomePrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SmartHomePrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SmartHomeGlassControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource SmartHomePrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SmartHomePrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoomNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RoomSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="17">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RoomSurface" Property="Background" Value="#96FFFFFF" />
                                <Setter TargetName="RoomSurface" Property="BorderBrush" Value="#72FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RoomSurface" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="RoomSurface" Property="BorderBrush" Value="#CFFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{StaticResource SmartHomeGlassControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource SmartHomeGlassBorderBrush}" BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F4FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource SmartHomePrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Border Margin="8" Background="{StaticResource SmartHomeBackdropBrush}" CornerRadius="28" />
        <Border Margin="8" Background="{StaticResource SmartHomeBackdropVeilBrush}"
                BorderBrush="#72FFFFFF" BorderThickness="1" CornerRadius="28" />
    <Grid Margin="44,28,44,34">
        <Grid x:Name="SetupPanel">
            <Border Width="590" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SmartHomeGlassCardBrush}" BorderBrush="{StaticResource SmartHomeGlassBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="24" Effect="{StaticResource SmartHomePanelShadow}">
                <StackPanel>
                    <Border Width="62" Height="62" HorizontalAlignment="Left" Background="{StaticResource SmartHomePrimarySoftBrush}" CornerRadius="19">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource SmartHomePrimaryBrush}" Text="&#xE774;" />
                    </Border>
                    <TextBlock Margin="0,19,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}" Text="连接你的智能家居" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20" Foreground="{StaticResource SmartHomeTextSecondaryBrush}" TextWrapping="Wrap"
                               Text="X-Tool 通过 Home Assistant 控制已经接入米家或其他平台的设备。小米账号授权仍在 Home Assistant 中完成。" />
                    <TextBlock Margin="0,23,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="Home Assistant 地址" />
                    <TextBox x:Name="SetupAddressTextBox" Style="{StaticResource ConnectionTextBoxStyle}" Text="http://homeassistant.local:8123"
                             AutomationProperties.Name="Home Assistant 地址" />
                    <TextBlock Margin="0,15,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="长期 Access Token" />
                    <PasswordBox x:Name="SetupTokenPasswordBox" Style="{StaticResource ConnectionPasswordBoxStyle}"
                                 AutomationProperties.Name="Home Assistant 长期 Access Token" />
                    <TextBlock Margin="0,8,0,0" FontSize="10.5" Foreground="#7E91A3"
                               Text="Token 将保存在当前 Windows 用户的凭据管理器中，不会写入明文配置。" />
                    <TextBlock x:Name="SetupMessageText" Margin="0,13,0,0" MinHeight="18" FontSize="11" Foreground="#C05D69" TextWrapping="Wrap" />
                    <Button x:Name="SetupConnectButton" Margin="0,13,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="测试并连接" Click="SetupConnect_Click" />
                    <Border Margin="0,18,0,0" Padding="14,11" Background="#BCEAF8F2" BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="12">
                        <TextBlock FontSize="10.5" LineHeight="17" Foreground="#4F7667" TextWrapping="Wrap"
                                   Text="本机运行 Home Assistant 时无需开放公网端口。电脑带到外地后，只要电脑、家中网络与设备都在线，云端可用的设备仍可控制。" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DashboardPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}" Text="设备控制" />
                    <StackPanel Margin="1,7,0,0" Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#B0BAC4" />
                        <TextBlock x:Name="ConnectionStatusText" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource SmartHomeTextSecondaryBrush}" Text="正在准备连接…" />
                        <TextBlock x:Name="LastUpdatedText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10"
                                   Foreground="{StaticResource SmartHomeTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButtonStyle}" Click="Refresh_Click"
                            ToolTip="刷新设备" AutomationProperties.Name="刷新设备">
                        <iconPacks:PackIconMaterial Width="19" Height="19" Kind="Refresh" />
                    </Button>
                    <Button Margin="9,0,0,0" Style="{StaticResource HeaderIconButtonStyle}" Click="OpenConnectionSettings_Click"
                            ToolTip="连接设置" AutomationProperties.Name="连接设置">
                        <iconPacks:PackIconMaterial Width="19" Height="19" Kind="CogOutline" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SmartHomeGlassPanelBrush}"
                    BorderBrush="{StaticResource SmartHomeGlassBorderBrush}" BorderThickness="1" CornerRadius="25"
                    Effect="{StaticResource SmartHomePanelShadow}">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,20,20,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding VisibleDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:SmartDeviceCard Device="{Binding}" CommandRequested="DeviceCard_CommandRequested"
                                                               DetailRequested="DeviceCard_DetailRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border x:Name="EmptyState" Background="#48FFFFFF" CornerRadius="20" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Width="36" Height="36" HorizontalAlignment="Center"
                                                            Foreground="{StaticResource SmartHomePrimaryBrush}" Kind="HomeOffOutline" />
                                <TextBlock x:Name="EmptyStateTitle" Margin="0,14,0,0" HorizontalAlignment="Center"
                                           FontSize="17" FontWeight="SemiBold" Text="这个房间还没有设备" />
                                <TextBlock x:Name="EmptyStateHint" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource SmartHomeTextMutedBrush}" Text="切换到其他房间或刷新设备状态" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="20,8,20,18" HorizontalAlignment="Center" Padding="12,9"
                            Background="#D9E7EAF7" BorderBrush="#BFFFFFFF" BorderThickness="1"
                            CornerRadius="23" Effect="{StaticResource SmartHomeCardShadow}">
                        <ScrollViewer MaxWidth="980" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ListBox x:Name="AreaFilterList" ItemsSource="{Binding AreaFilters}" SelectedIndex="0"
                                     Background="Transparent" BorderThickness="0" SelectionChanged="AreaFilterList_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle><StaticResource ResourceKey="RoomNavigationItemStyle" /></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Width="21" Height="21"
                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                            Kind="{Binding IconKind}" />
                                                <Border MinWidth="19" Height="19" Margin="19,-8,-15,0" Padding="4,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="#78FFFFFF" CornerRadius="9.5">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                               Text="{Binding Count}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Name}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConnectionSettingsOverlay" Background="#66404767" Visibility="Collapsed">
            <Border Width="560" Padding="30,27" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SmartHomeGlassCardBrush}" BorderBrush="{StaticResource SmartHomeGlassBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="22" Effect="{StaticResource SmartHomeDialogShadow}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Home Assistant 连接" />
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#71869A" Text="修改地址或更新安全凭据" />
                        </StackPanel>
                        <Button Width="34" Height="34" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Content="×" Click="CloseConnectionSettings_Click" />
                    </Grid>
                    <TextBlock Margin="0,22,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="Home Assistant 地址" />
                    <TextBox x:Name="SettingsAddressTextBox" Style="{StaticResource ConnectionTextBoxStyle}"
                             AutomationProperties.Name="Home Assistant 地址" />
                    <TextBlock Margin="0,15,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="新 Access Token" />
                    <PasswordBox x:Name="SettingsTokenPasswordBox" Style="{StaticResource ConnectionPasswordBoxStyle}"
                                 AutomationProperties.Name="新的 Home Assistant Access Token" />
                    <TextBlock Margin="0,7,0,0" FontSize="10.5" Foreground="#7E91A3" Text="留空表示继续使用已经安全保存的 Token。" />
                    <TextBlock x:Name="SettingsMessageText" Margin="0,12,0,0" MinHeight="18" FontSize="11" Foreground="#C05D69" TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Button Width="118" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B35765"
                                Content="删除连接" Click="ForgetConnection_Click" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="82" Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="CloseConnectionSettings_Click" />
                            <Button x:Name="SettingsConnectButton" Width="126" Margin="9,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="测试并保存" Click="SettingsConnect_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DeviceDetailOverlay" Background="#74DDE4EF" Visibility="Collapsed" Focusable="True"
              PreviewMouseLeftButtonDown="DeviceDetailOverlay_PreviewMouseLeftButtonDown"
              PreviewKeyDown="DeviceDetailOverlay_PreviewKeyDown">
            <local:SmartDeviceDetailDialog x:Name="DeviceDetailDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           CommandRequested="DeviceDetailDialog_CommandRequested"
                                           LiveCommandRequested="DeviceDetailDialog_LiveCommandRequested"
                                           RenameRequested="DeviceDetailDialog_RenameRequested"
                                           CloseRequested="DeviceDetailDialog_CloseRequested" />
        </Grid>
    </Grid>
    </Grid>
</UserControl>
