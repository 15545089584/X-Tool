<UserControl x:Class="ScreenshotApp.SmartHome.SmartHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenshotApp.SmartHome"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#557DF4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#638BFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EAF1F8" />
            <Setter Property="Foreground" Value="#486984" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#BCD2E3" BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDEAF6" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.80" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7FBFE" />
            <Setter Property="BorderBrush" Value="#C7DAE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ConnectionPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7FBFE" />
            <Setter Property="BorderBrush" Value="#C7DAE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="AreaChipStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#5A748B" />
            <Setter Property="Background" Value="#A8F4F8FB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="#A8FFFFFF" BorderThickness="1" CornerRadius="15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#DCE9F7" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#456FE8" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#7F9BF3" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="44,28,44,34">
        <Grid x:Name="SetupPanel">
            <Border Width="590" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#E8FFFFFF" BorderBrush="#C9DFEDF7" BorderThickness="1" CornerRadius="24">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Direction="270" Opacity="0.12" Color="#496A88" /></Border.Effect>
                <StackPanel>
                    <Border Width="62" Height="62" HorizontalAlignment="Left" Background="#E7EEFF" CornerRadius="19">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#557DF4" Text="&#xE774;" />
                    </Border>
                    <TextBlock Margin="0,19,0,0" FontSize="27" FontWeight="SemiBold" Text="连接你的智能家居" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20" Foreground="#647E94" TextWrapping="Wrap"
                               Text="X-Tool 通过 Home Assistant 控制已经接入米家或其他平台的设备。小米账号授权仍在 Home Assistant 中完成。" />
                    <TextBlock Margin="0,23,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="Home Assistant 地址" />
                    <TextBox x:Name="SetupAddressTextBox" Style="{StaticResource ConnectionTextBoxStyle}" Text="http://homeassistant.local:8123"
                             AutomationProperties.Name="Home Assistant 地址" />
                    <TextBlock Margin="0,15,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="长期 Access Token" />
                    <PasswordBox x:Name="SetupTokenPasswordBox" Style="{StaticResource ConnectionPasswordBoxStyle}"
                                 AutomationProperties.Name="Home Assistant 长期 Access Token" />
                    <TextBlock Margin="0,8,0,0" FontSize="10.5" Foreground="#7E91A3"
                               Text="Token 将保存在当前 Windows 用户的凭据管理器中，不会写入明文配置。" />
                    <TextBlock x:Name="SetupMessageText" Margin="0,13,0,0" MinHeight="18" FontSize="11" Foreground="#C05D69" TextWrapping="Wrap" />
                    <Button x:Name="SetupConnectButton" Margin="0,13,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="测试并连接" Click="SetupConnect_Click" />
                    <Border Margin="0,18,0,0" Padding="14,11" Background="#EAF6F1" CornerRadius="11">
                        <TextBlock FontSize="10.5" LineHeight="17" Foreground="#4F7667" TextWrapping="Wrap"
                                   Text="本机运行 Home Assistant 时无需开放公网端口。电脑带到外地后，只要电脑、家中网络与设备都在线，云端可用的设备仍可控制。" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DashboardPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#172B3C" Text="智能家居" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#B0BAC4" />
                        <TextBlock x:Name="ConnectionStatusText" VerticalAlignment="Center" FontSize="12" Foreground="#607A91" Text="正在准备连接…" />
                        <TextBlock x:Name="LastUpdatedText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="#8A9AAA" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Width="82" Style="{StaticResource SecondaryButtonStyle}" Content="刷新" Click="Refresh_Click" />
                    <Button Width="102" Margin="9,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="连接设置" Click="OpenConnectionSettings_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="18" Background="#62FFFFFF" BorderBrush="#8FFFFFFF" BorderThickness="1" CornerRadius="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.10" Color="#4A6B82" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ScrollViewer Margin="0,0,318,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ListBox x:Name="AreaFilterList" ItemsSource="{Binding AreaFilters}" SelectedIndex="0"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="AreaFilterList_SelectionChanged">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle><StaticResource ResourceKey="AreaChipStyle" /></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="6,0,0,0" FontSize="10" Opacity="0.74" Text="{Binding Count}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <Border Width="294" Height="38" HorizontalAlignment="Right" Background="#C7FFFFFF"
                                BorderBrush="#B9D6E5F0" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <TextBlock Margin="13,0,0,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"
                                           FontSize="14" Foreground="#7A91A6" Text="&#xE721;" />
                                <TextBox x:Name="DeviceSearchTextBox" Margin="39,0,11,0" VerticalContentAlignment="Center"
                                         Background="Transparent" BorderThickness="0" FontSize="12"
                                         TextChanged="DeviceSearchTextBox_TextChanged" />
                                <TextBlock x:Name="SearchPlaceholder" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           FontSize="12" Foreground="#9AA9B7" Text="搜索设备" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:SmartDeviceCard Device="{Binding}" CommandRequested="DeviceCard_CommandRequested"
                                                               DetailRequested="DeviceCard_DetailRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border x:Name="EmptyState" Background="#70FFFFFF" CornerRadius="18" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="62" Height="62" HorizontalAlignment="Center" Background="#E7EEFF" CornerRadius="19">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"
                                               FontSize="27" Foreground="#557DF4" Text="&#xE772;" />
                                </Border>
                                <TextBlock x:Name="EmptyStateTitle" Margin="0,15,0,0" HorizontalAlignment="Center"
                                           FontSize="17" FontWeight="SemiBold" Text="没有匹配的设备" />
                                <TextBlock x:Name="EmptyStateHint" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           FontSize="11" Foreground="#768A9D" Text="调整分类或搜索关键词" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConnectionSettingsOverlay" Background="#4A40546A" Visibility="Collapsed">
            <Border Width="560" Padding="30,27" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FAFCFE" BorderBrush="#C7DAE9" BorderThickness="1" CornerRadius="22">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.25" Color="#30465B" /></Border.Effect>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Home Assistant 连接" />
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#71869A" Text="修改地址或更新安全凭据" />
                        </StackPanel>
                        <Button Width="34" Height="34" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Content="×" Click="CloseConnectionSettings_Click" />
                    </Grid>
                    <TextBlock Margin="0,22,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="Home Assistant 地址" />
                    <TextBox x:Name="SettingsAddressTextBox" Style="{StaticResource ConnectionTextBoxStyle}"
                             AutomationProperties.Name="Home Assistant 地址" />
                    <TextBlock Margin="0,15,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#4D6982" Text="新 Access Token" />
                    <PasswordBox x:Name="SettingsTokenPasswordBox" Style="{StaticResource ConnectionPasswordBoxStyle}"
                                 AutomationProperties.Name="新的 Home Assistant Access Token" />
                    <TextBlock Margin="0,7,0,0" FontSize="10.5" Foreground="#7E91A3" Text="留空表示继续使用已经安全保存的 Token。" />
                    <TextBlock x:Name="SettingsMessageText" Margin="0,12,0,0" MinHeight="18" FontSize="11" Foreground="#C05D69" TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Button Width="118" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B35765"
                                Content="删除连接" Click="ForgetConnection_Click" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="82" Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="CloseConnectionSettings_Click" />
                            <Button x:Name="SettingsConnectButton" Width="126" Margin="9,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="测试并保存" Click="SettingsConnect_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DeviceDetailOverlay" Background="#56344759" Visibility="Collapsed" Focusable="True"
              PreviewMouseLeftButtonDown="DeviceDetailOverlay_PreviewMouseLeftButtonDown"
              PreviewKeyDown="DeviceDetailOverlay_PreviewKeyDown">
            <local:SmartDeviceDetailDialog x:Name="DeviceDetailDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           CommandRequested="DeviceDetailDialog_CommandRequested"
                                           CloseRequested="DeviceDetailDialog_CloseRequested" />
        </Grid>
    </Grid>
</UserControl>
