<UserControl x:Class="ScreenshotApp.SmartHome.SmartDeviceDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenshotApp.SmartHome"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="Root" Width="900" MaxHeight="790">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XTool;component/SmartHome/SmartHomeFrostedTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:SmartComboSelectionConverter x:Key="SmartComboSelectionConverter" />

            <Style x:Key="SoftButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="#C6EFF3F8" />
                <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#AFFFFFFF"
                                    BorderThickness="1" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F4FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                <Setter Property="Width" Value="58" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}" BorderBrush="#B7FFFFFF"
                                    BorderThickness="1" CornerRadius="29">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F8FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DetailComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Background" Value="#CDEEF3F8" />
                <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#B0FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="13,9" />
                            <Setter Property="Foreground" Value="{StaticResource SmartHomeTextPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemSurface" Margin="4,2" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E5EAF6" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SmartHomePrimarySoftBrush}" /><Setter Property="Foreground" Value="{StaticResource SmartHomePrimaryBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <TextBlock Margin="13,0,40,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                                   Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SmartComboSelectionConverter}}" TextTrimming="CharacterEllipsis" />
                                        <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6E8098" Kind="ChevronDown" />
                                    </Grid>
                                </Border>
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Margin="0,6,0,0" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="250" Padding="2"
                                            Background="#F8FFFFFF" BorderBrush="#D3DCE9" BorderThickness="1" CornerRadius="14" Effect="{StaticResource SmartHomeCardShadow}">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource SmartHomeGlassBorderStrongBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource SmartHomePrimaryBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 空调离散档位条：用于摆风与风感方向，保持和风速条一致的胶囊式交互。 -->
            <Style x:Key="ClimateSegmentItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Foreground" Value="#5E7188" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SegmentSurface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SegmentSurface" Property="Background" Value="#B8FFFFFF" />
                                    <Setter Property="Foreground" Value="#36516A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SegmentSurface" Property="Background" Value="#4D7CFE" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SegmentSurface" Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 详情页总开关：与卡片电源键一致的蓝底白色电源圆形按钮。 -->
            <Style x:Key="PowerButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Background" Value="#4D7CFE" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="28">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#6F90FE" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModeButtonStyle" TargetType="ListBoxItem">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="84" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Foreground" Value="#64758C" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <StackPanel HorizontalAlignment="Center">
                                <Border x:Name="ModeCircle" Width="58" Height="58" Background="#C7EEF2F7" BorderBrush="#B0FFFFFF" BorderThickness="1" CornerRadius="29">
                                    <iconPacks:PackIconMaterial Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Foreground="{TemplateBinding Foreground}" Kind="WeatherSnowy" />
                                </Border>
                                <ContentPresenter Margin="0,7,0,0" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeCircle" Property="Background" Value="#F4FFFFFF" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ModeCircle" Property="Background" Value="#4D7CFE" /><Setter Property="Foreground" Value="White" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="Background" Value="#BDF6F8FC" />
                <Setter Property="BorderBrush" Value="#AFFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="22,16" Background="#F4F7F9FD" BorderBrush="#E2FFFFFF" BorderThickness="1"
            CornerRadius="28" DataContext="{Binding Device, ElementName=Root}" Effect="{StaticResource SmartHomeDialogShadow}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <StackPanel x:Name="TitleRow" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock MaxWidth="720" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SmartHomeTextPrimaryBrush}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Button Width="30" Height="30" Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                                Style="{StaticResource SoftButtonStyle}" Click="Rename_Click"
                                AutomationProperties.Name="重命名设备"
                                Visibility="{Binding CanRename, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconMaterial Width="14" Height="14" Kind="Pencil" Foreground="#71829A" />
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="RenameRow" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="RenameBox" Width="430" Height="36" FontSize="16" MaxLength="128"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Background="#F2FFFFFF" BorderBrush="#9ACBD8E8" BorderThickness="1"
                                 KeyDown="RenameBox_KeyDown" />
                        <Button Width="64" Height="36" Margin="8,0,0,0" Content="保存" Style="{StaticResource SoftButtonStyle}"
                                Background="#4D7CFE" Foreground="White" TextElement.Foreground="White" Click="ConfirmRename_Click" />
                        <Button Width="64" Height="36" Margin="8,0,0,0" Content="取消" Style="{StaticResource SoftButtonStyle}" Background="#4D7CFE" Foreground="White" TextElement.Foreground="White" Click="CancelRename_Click" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#28B486" /><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Fill" Value="#A8B3BC" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="11" Foreground="{StaticResource SmartHomeTextSecondaryBrush}"><Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AreaName, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </StackPanel>
                <Button Width="40" Height="40" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SoftButtonStyle}" Click="Close_Click" AutomationProperties.Name="关闭设备详情">
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Close" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <Border Height="232" Style="{StaticResource SectionCardStyle}" Background="#B8EEF3FA">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44*" /><ColumnDefinition Width="56*" /></Grid.ColumnDefinitions>
                            <Grid Margin="4,0,20,0">
                                <Image MaxWidth="320" MaxHeight="205" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="Uniform" Source="{Binding DeviceArtworkUri}" RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value><TranslateTransform X="0" /></Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                <!-- bulb.png 画布内容整体偏右约 9%，详情大图按高度缩放后向左补偿。 -->
                                                <DataTrigger Binding="{Binding IsLightArtwork}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value><TranslateTransform X="-17" /></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <!-- 风扇改用下方“只显示机头”的旋转视图，不再展示含底座的整张素材。 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFan}" Value="True" />
                                                        <Condition Binding="{Binding HasDeviceArtwork}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- 风扇机头视图：叶片是独立转子，外环、护网和中心盖始终静止。 -->
                                <Border Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="90" ClipToBounds="True"
                                        Visibility="{Binding IsFan, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Width="180" Height="180">
                                        <!-- 从原素材截取五片叶片并作为一个转子旋转，保留原图的渐变和立体质感。 -->
                                        <Image Width="236" Height="236" Stretch="Uniform" Source="{Binding DeviceArtworkUri}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-27,-24.4,0,0"
                                               IsHitTestVisible="False">
                                            <Image.Clip>
                                                <GeometryGroup>
                                                    <PathGeometry Figures="M111,109.4 C99,96.4 82,69.4 86,48.4 C100,40.4 122,42.4 135,51.4 C134,73.4 127,94.4 121,107.4 C118,111.4 115,113.4 111,109.4 Z" />
                                                    <PathGeometry Figures="M111,109.4 C99,96.4 82,69.4 86,48.4 C100,40.4 122,42.4 135,51.4 C134,73.4 127,94.4 121,107.4 C118,111.4 115,113.4 111,109.4 Z"><PathGeometry.Transform><RotateTransform Angle="72" CenterX="117" CenterY="114.4" /></PathGeometry.Transform></PathGeometry>
                                                    <PathGeometry Figures="M111,109.4 C99,96.4 82,69.4 86,48.4 C100,40.4 122,42.4 135,51.4 C134,73.4 127,94.4 121,107.4 C118,111.4 115,113.4 111,109.4 Z"><PathGeometry.Transform><RotateTransform Angle="144" CenterX="117" CenterY="114.4" /></PathGeometry.Transform></PathGeometry>
                                                    <PathGeometry Figures="M111,109.4 C99,96.4 82,69.4 86,48.4 C100,40.4 122,42.4 135,51.4 C134,73.4 127,94.4 121,107.4 C118,111.4 115,113.4 111,109.4 Z"><PathGeometry.Transform><RotateTransform Angle="216" CenterX="117" CenterY="114.4" /></PathGeometry.Transform></PathGeometry>
                                                    <PathGeometry Figures="M111,109.4 C99,96.4 82,69.4 86,48.4 C100,40.4 122,42.4 135,51.4 C134,73.4 127,94.4 121,107.4 C118,111.4 115,113.4 111,109.4 Z"><PathGeometry.Transform><RotateTransform Angle="288" CenterX="117" CenterY="114.4" /></PathGeometry.Transform></PathGeometry>
                                                </GeometryGroup>
                                            </Image.Clip>
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="FanBladeRotate" CenterX="117" CenterY="114.4" Angle="0" />
                                            </Image.RenderTransform>
                                        </Image>

                                        <!-- 原素材只保留外圈环带，延续设备图标的材质和高光。 -->
                                        <Image Width="236" Height="236" Stretch="Uniform" Source="{Binding DeviceArtworkUri}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-27,-24.4,0,0"
                                               IsHitTestVisible="False">
                                            <Image.Clip>
                                                <CombinedGeometry GeometryCombineMode="Exclude">
                                                    <CombinedGeometry.Geometry1>
                                                        <EllipseGeometry Center="117,114.4" RadiusX="90" RadiusY="90" />
                                                    </CombinedGeometry.Geometry1>
                                                    <CombinedGeometry.Geometry2>
                                                        <EllipseGeometry Center="117,114.4" RadiusX="76" RadiusY="76" />
                                                    </CombinedGeometry.Geometry2>
                                                </CombinedGeometry>
                                            </Image.Clip>
                                        </Image>

                                        <!-- 静态护网辐条：运动层不再包含护网，因此不会跟随叶片转动。 -->
                                        <Canvas Width="180" Height="180" IsHitTestVisible="False" Opacity="0.72">
                                            <Path Data="M90,90 L90,15 M90,90 L127.5,25.05 M90,90 L154.95,52.5 M90,90 L165,90 M90,90 L154.95,127.5 M90,90 L127.5,154.95 M90,90 L90,165 M90,90 L52.5,154.95 M90,90 L25.05,127.5 M90,90 L15,90 M90,90 L25.05,52.5 M90,90 L52.5,25.05"
                                                  Stroke="#C8B9C9D8" StrokeThickness="1.4" />
                                            <Ellipse Width="146" Height="146" Canvas.Left="17" Canvas.Top="17" Stroke="#D8B9C9D8" StrokeThickness="2" />
                                        </Canvas>
                                        <!-- 中心盖沿用原素材，遮住叶片根部并保持静止。 -->
                                        <Image Width="236" Height="236" Stretch="Uniform" Source="{Binding DeviceArtworkUri}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-27,-24.4,0,0"
                                               IsHitTestVisible="False">
                                            <Image.Clip><EllipseGeometry Center="117,114.4" RadiusX="25" RadiusY="25" /></Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                                <Grid>
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasDeviceArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Ellipse Width="138" Height="138" Fill="{Binding AccentBackground}" />
                                    <iconPacks:PackIconMaterial Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding AccentBrush}" Kind="{Binding IconKind}" />
                                </Grid>
                                <Border Width="82" Height="78" Margin="0,-5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F5D2DCDD" BorderBrush="#51616B70" BorderThickness="1" CornerRadius="7">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsThermoHygrometerArtwork}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#26343B" Text="{Binding LiveTemperatureText}" />
                                        <Border Height="1" Margin="9,4" Background="#727A8185" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#32434B" Text="{Binding LiveHumidityText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,6,4,6" VerticalAlignment="Center">
                                <!-- 非空调设备：状态三行 -->
                                <StackPanel Visibility="{Binding IsNotClimate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11" Foreground="#71849A" Text="当前状态" HorizontalAlignment="Left" TextAlignment="Left" />
                                    <TextBlock Margin="0,5,0,0" FontSize="26" FontWeight="SemiBold" Foreground="#20354A" Text="{Binding MainState}" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" TextAlignment="Left" />
                                    <TextBlock Margin="0,7,0,0" MaxWidth="400" FontSize="10.5" Foreground="#7A8DA0" Text="{Binding SupportingSummary}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left" TextAlignment="Left" />
                                </StackPanel>
                                <!-- 空调：放大的室内温湿度（替代原“当前状态”区，避免重复） -->
                                <StackPanel Visibility="{Binding IsClimate, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,44,0">
                                            <TextBlock FontSize="14" Foreground="#8293A4" Text="室内温度" />
                                            <TextBlock Margin="0,6,0,0" FontSize="36" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding IndoorTemperatureText}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="14" Foreground="#8293A4" Text="室内湿度" />
                                            <TextBlock Margin="0,6,0,0" FontSize="36" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding IndoorHumidityText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotClimate, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Margin="0,0,30,0" Visibility="{Binding HasIndoorTemperature, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10" Foreground="#8293A4" Text="室内温度" />
                                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding IndoorTemperatureText}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding HasIndoorHumidity, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10" Foreground="#8293A4" Text="室内湿度" />
                                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding IndoorHumidityText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Width="56" Height="56" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource PowerButtonStyle}" Click="Toggle_Click" IsEnabled="{Binding CanInteract}"
                                            AutomationProperties.Name="{Binding ToggleLabel, Mode=OneWay}"
                                            Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconMaterial Width="24" Height="24" Foreground="White" Kind="Power" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsClimate, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="空调控制" />
                            <Grid Margin="0,14,0,0" Visibility="{Binding SupportsTargetTemperature, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Width="58" Height="58" HorizontalAlignment="Right" Style="{StaticResource RoundButtonStyle}" FontSize="24" Content="−" Click="DecreaseTemperature_Click" IsEnabled="{Binding CanInteract}" />
                                <StackPanel Grid.Column="1" Width="150" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="10.5" Foreground="#7A8DA0" Text="目标温度" />
                                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="34" FontWeight="SemiBold" Foreground="#20354A" Text="{Binding TargetTemperatureText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Width="58" Height="58" HorizontalAlignment="Left" Style="{StaticResource RoundButtonStyle}" FontSize="21" Content="+" Click="IncreaseTemperature_Click" IsEnabled="{Binding CanInteract}" />
                            </Grid>

                            <ListBox x:Name="HvacModeList" Margin="0,16,0,0" ItemsSource="{Binding HvacModeOptions}"
                                     SelectedValuePath="Value" SelectedValue="{Binding CurrentHvacMode, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="HvacModeComboBox_SelectionChanged" Visibility="{Binding SupportsHvacMode, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="66" Height="66" CornerRadius="33" BorderBrush="#B0FFFFFF" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#C7EEF2F7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="#4D7CFE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <iconPacks:PackIconMaterial Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Kind="{Binding IconKind}">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Foreground" Value="#64758C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </Border>
                                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="{Binding DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64758C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#294359" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,18,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupportsFanMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SupportsSwingMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasAuxiliarySelects}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 与风速条相同的填充式控件，仅将方向改为自上而下。 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                                            Visibility="{Binding HasAirflowDirectionLevels, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Margin="0,0,0,7" HorizontalAlignment="Center" FontSize="10.5" Foreground="#71849A" Text="风感方向" />
                                    <Grid x:Name="AirflowDirectionBar" Width="104" Height="184" ClipToBounds="True" Cursor="Hand"
                                          Background="Transparent" IsEnabled="{Binding AirflowDirectionControl.IsAvailable}"
                                          MouseLeftButtonDown="AirflowDirectionBar_MouseLeftButtonDown"
                                          MouseMove="AirflowDirectionBar_MouseMove"
                                          MouseLeftButtonUp="AirflowDirectionBar_MouseLeftButtonUp"
                                          SizeChanged="AirflowDirectionBar_SizeChanged"
                                          ToolTip="上、偏上、中间、偏下、下">
                                        <Border Background="#E4E9F0F8" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="26" />
                                        <Border x:Name="AirflowDirectionFill" Height="0" VerticalAlignment="Top"
                                                Background="#4D7CFE" CornerRadius="26" ClipToBounds="True">
                                            <TextBlock x:Name="AirflowDirectionFillLabel" Margin="0,0,0,10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                       FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                                       Text="{Binding CurrentAirflowDirectionText, Mode=OneWay}" />
                                        </Border>
                                        <ItemsControl Margin="10,5" IsHitTestVisible="False" ItemsSource="{Binding AirflowDirectionLevels}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="13,0" BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>

                                <!-- 右侧将风速与摆风两条控制堆叠，便于同一区域连续调整。 -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Visibility="{Binding SupportsFanMode, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="2,0,0,7" FontSize="10.5" Foreground="#71849A" Text="空调风速" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid x:Name="FanModeBar" Height="42" ClipToBounds="True" Cursor="Hand" Background="Transparent"
                                                  MouseLeftButtonDown="FanModeBar_MouseLeftButtonDown" MouseMove="FanModeBar_MouseMove"
                                                  MouseLeftButtonUp="FanModeBar_MouseLeftButtonUp" SizeChanged="FanModeBar_SizeChanged"
                                                  Visibility="{Binding HasFanModeLevels, Converter={StaticResource BoolToVisibility}}">
                                                <Border Background="#E4E9F0F8" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="21" />
                                                <Border x:Name="FanModeFill" Background="#4D7CFE" CornerRadius="21" HorizontalAlignment="Left" Width="0" />
                                                <TextBlock x:Name="FanModeFillLabel" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                           FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                                           Text="{Binding CurrentFanModeText, Mode=OneWay}" />
                                            </Grid>
                                            <Button Grid.Column="2" Width="84" Height="42" Content="自动" Style="{StaticResource SoftButtonStyle}"
                                                    Click="FanAutoMode_Click"
                                                    Visibility="{Binding HasFanAutoMode, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SupportsSwingMode, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="2,0,0,7" FontSize="10.5" Foreground="#71849A" Text="摆风方式" />
                                        <Border Height="42" Padding="3" Background="#E4E9F0F8" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="21">
                                            <ListBox ItemsSource="{Binding SwingModeOptions}" SelectedValuePath="Value"
                                                     SelectedValue="{Binding CurrentSwingMode, Mode=OneWay}" IsEnabled="{Binding CanInteract}"
                                                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                     ItemContainerStyle="{StaticResource ClimateSegmentItemStyle}"
                                                     SelectionChanged="SwingModeComboBox_SelectionChanged">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                   Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="灯光控制" />
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" Foreground="#71849A" Text="亮度" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#4D7CFE"
                                               Text="{Binding BrightnessPercent, StringFormat={}{0:0}%}" />
                                </StackPanel>
                                <Grid x:Name="BrightnessBar" Height="42" Margin="0,8,0,0" ClipToBounds="True" Cursor="Hand"
                                      Background="Transparent"
                                      MouseLeftButtonDown="BrightnessBar_MouseLeftButtonDown"
                                      MouseMove="BrightnessBar_MouseMove"
                                      MouseLeftButtonUp="BrightnessBar_MouseLeftButtonUp"
                                      SizeChanged="BrightnessBar_SizeChanged"
                                      AutomationProperties.Name="亮度调节">
                                    <Border Background="#E4E9F0F8" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="23" />
                                    <Border x:Name="BrightnessFill" Background="#F7B733" CornerRadius="23" HorizontalAlignment="Left" Width="0" />
                                    <iconPacks:PackIconMaterial Width="20" Height="20" Kind="LightbulbOutline" Foreground="#C8FFFFFF"
                                                                HorizontalAlignment="Left" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <iconPacks:PackIconMaterial Width="20" Height="20" Kind="Brightness5" Foreground="#8B9AAB"
                                                                HorizontalAlignment="Right" Margin="0,0,18,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SupportsColorTemperature, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" Foreground="#71849A" Text="色温" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#4D7CFE"
                                               Text="{Binding ColorTemperatureKelvinText, Mode=OneWay}" />
                                </StackPanel>
                                <Grid x:Name="ColorTempPalette" Height="146" Margin="0,8,0,0" ClipToBounds="True" Cursor="Cross"
                                      MouseLeftButtonDown="ColorTempPalette_MouseLeftButtonDown"
                                      MouseMove="ColorTempPalette_MouseMove"
                                      MouseLeftButtonUp="ColorTempPalette_MouseLeftButtonUp"
                                      SizeChanged="ColorTempPalette_SizeChanged"
                                      AutomationProperties.Name="色温调节板">
                                    <Border CornerRadius="18" BorderBrush="#AFFFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#F2A93B" Offset="0" />
                                                <GradientStop Color="#F9CE7A" Offset="0.38" />
                                                <GradientStop Color="#FDF3DC" Offset="0.7" />
                                                <GradientStop Color="#E9F2FE" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse x:Name="ColorTempIndicator" Width="26" Height="26" Fill="#26FFFFFF"
                                             Stroke="White" StrokeThickness="3" VerticalAlignment="Top"
                                             HorizontalAlignment="Left" Margin="-13,-13,0,0" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsFan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="风扇控制" />
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SupportsPreset, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" Foreground="#71849A" Text="模式" />
                            </StackPanel>
                            <ListBox x:Name="FanPresetList" Margin="0,8,0,0" ItemsSource="{Binding PresetModeOptions}" SelectedValuePath="Value"
                                     SelectedValue="{Binding CurrentPresetMode, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="FanPresetList_SelectionChanged"
                                     Visibility="{Binding SupportsPreset, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#B0FFFFFF" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#C7EEF2F7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="#4D7CFE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <iconPacks:PackIconMaterial Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Kind="{Binding IconKind}">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Foreground" Value="#64758C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </Border>
                                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Text="{Binding DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64758C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#294359" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SupportsFanPercentage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" Foreground="#71849A" Text="风机档位" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#4D7CFE"
                                               Text="{Binding CurrentFanLevel, StringFormat={}{0} 挡}" />
                                </StackPanel>
                                <ListBox x:Name="FanLevelList" Margin="0,8,0,0" ItemsSource="{Binding FanLevels}" SelectedValuePath="Percent"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="FanLevelList_SelectionChanged"
                                         Visibility="{Binding SupportsFanPercentage, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#B0FFFFFF" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#C7EEF2F7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="#4D7CFE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Level}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64758C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Text="{Binding Label}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64758C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="#294359" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SupportsSwingMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" Foreground="#71849A" Text="摆风" />
                            </StackPanel>
                            <ListBox x:Name="FanSwingList" Margin="0,8,0,0" ItemsSource="{Binding SwingModeOptions}" SelectedValuePath="Value"
                                     SelectedValue="{Binding CurrentSwingMode, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="FanSwingList_SelectionChanged"
                                     Visibility="{Binding SupportsSwingMode, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#B0FFFFFF" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#C7EEF2F7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="#4D7CFE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <iconPacks:PackIconMaterial Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Kind="{Binding IconKind}">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                            <Setter Property="Foreground" Value="#64758C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                            </Border>
                                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Text="{Binding DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64758C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#294359" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding SupportsCoverPosition, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="窗帘控制" />
                            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                <Slider x:Name="CoverSlider" Minimum="0" Maximum="100" Value="{Binding CoverPosition, Mode=OneWay}" Style="{StaticResource SmartHomeSliderStyle}"
                                        IsEnabled="{Binding CanInteract}" PreviewMouseLeftButtonUp="CoverSlider_Commit" KeyUp="CoverSlider_KeyUp" AutomationProperties.Name="窗帘位置" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#5D768C" Text="{Binding CoverPosition, StringFormat={}{0:0}%}" />
                            </Grid>
                            <UniformGrid Margin="0,14,0,0" Columns="3">
                                <Button Margin="0,0,6,0" Style="{StaticResource SoftButtonStyle}" Content="打开" Tag="Open" Click="CoverAction_Click" IsEnabled="{Binding CanInteract}" />
                                <Button Margin="3,0" Style="{StaticResource SoftButtonStyle}" Content="停止" Tag="Stop" Click="CoverAction_Click" IsEnabled="{Binding CanInteract}" />
                                <Button Margin="6,0,0,0" Style="{StaticResource SoftButtonStyle}" Content="关闭" Tag="Close" Click="CoverAction_Click" IsEnabled="{Binding CanInteract}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsClimate, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid><StackPanel><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="室内温度趋势" /><TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="#8396A7" Text="最近 24 小时 · 来自 Home Assistant 历史记录" /></StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding IndoorTemperatureText}" />
                            </Grid>
                            <local:SmartTemperatureChart Height="200" Margin="0,12,0,0" Points="{Binding TemperaturePoints}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsClimate, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#294359" Text="用电统计" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,44,0">
                                    <TextBlock FontSize="11" Foreground="#8396A7" Text="今日用电" />
                                    <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Foreground="#20394E" Text="{Binding TodayEnergyText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#8396A7" Text="本月总用电" />
                                    <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Foreground="#20394E" Text="{Binding MonthEnergyText}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Margin="0,14,0,0" HorizontalAlignment="Left" Background="#E2E9F0F8" CornerRadius="16" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="EnergyDayTab" Width="120" Height="34" Content="日" Style="{StaticResource SoftButtonStyle}"
                                            Background="#FFFFFF" Foreground="#20394E" Click="EnergyDayTab_Click" />
                                    <Button x:Name="EnergyMonthTab" Width="120" Height="34" Content="月" Style="{StaticResource SoftButtonStyle}"
                                            Foreground="#64758C" Click="EnergyMonthTab_Click" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="EnergyDailyPanel" Margin="0,12,0,0"
                                        Visibility="{Binding HasDailyEnergy, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="7" Margin="0,0,0,4">
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="日" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="一" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="二" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="三" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="四" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="五" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9AA9B8" Text="六" />
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding EnergyCalendarCells}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="1,7" HorizontalAlignment="Center" MinHeight="48">
                                                <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#53667D" Text="{Binding DayNumber}" />
                                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="#4D7CFE" Text="{Binding UsageText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="EnergyMonthlyPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                <ItemsControl ItemsSource="{Binding EnergyMonthCells}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,14" HorizontalAlignment="Center" MinHeight="48">
                                                <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#53667D" Text="{Binding Label}" />
                                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="#4D7CFE" Text="{Binding UsageText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Button Width="40" Height="36" HorizontalAlignment="Left" Content="‹" Style="{StaticResource SoftButtonStyle}" Click="PreviousEnergyPeriod_Click" />
                                <TextBlock x:Name="EnergyMonthNavLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#20394E" Text="{Binding EnergyMonthLabel}" />
                                <TextBlock x:Name="EnergyYearNavLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#20394E" Text="{Binding EnergyYearLabel}" Visibility="Collapsed" />
                                <Button Width="40" Height="36" HorizontalAlignment="Right" Content="›" Style="{StaticResource SoftButtonStyle}" Click="NextEnergyPeriod_Click" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" FontSize="10" Foreground="#8497A8" Text="{Binding InsightsMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="4,0,4,3" FontSize="10.5" Foreground="#B45D69" Text="{Binding OperationMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
