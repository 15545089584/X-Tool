<UserControl x:Class="ScreenshotApp.InformationVault.InformationVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7B8999" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="44,38,52,38">
        <Grid x:Name="LockedView">
            <Border Width="510" Padding="42,38" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#EFFFFFFF" BorderBrush="#D6E6F3" BorderThickness="1" CornerRadius="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.10" Color="#536C86" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Center" Background="#E8F0FF" CornerRadius="17">
                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="25" Foreground="#4C7CD8" Text="&#xE72E;" />
                    </Border>
                    <TextBlock x:Name="LockedTitleText" Margin="0,20,0,0" HorizontalAlignment="Center"
                               FontSize="24" FontWeight="SemiBold" Text="解锁信息库" />
                    <TextBlock x:Name="LockedDescriptionText" Margin="0,9,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextAlignment="Center"
                               Text="输入本次启动所需的主密码" />

                    <TextBlock Margin="0,26,0,7" FontSize="12" FontWeight="SemiBold" Text="主密码" />
                    <PasswordBox x:Name="MasterPasswordBox" Height="46" Padding="13,9" FontSize="14"
                                 Background="#F7FAFE" BorderBrush="#D5E2EF" BorderThickness="1"
                                 KeyDown="PasswordBox_KeyDown" />

                    <StackPanel x:Name="ConfirmPasswordPanel" Margin="0,16,0,0">
                        <TextBlock Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Text="再次输入主密码" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="46" Padding="13,9" FontSize="14"
                                     Background="#F7FAFE" BorderBrush="#D5E2EF" BorderThickness="1"
                                     KeyDown="PasswordBox_KeyDown" />
                    </StackPanel>

                    <TextBlock x:Name="PasswordMessageText" Margin="0,13,0,0" MinHeight="18"
                               Foreground="#C44747" FontSize="12" TextWrapping="Wrap" />
                    <Button x:Name="UnlockButton" Height="46" Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="解锁信息库" Click="UnlockButton_Click" />
                    <Button x:Name="ResetVaultButton" Height="36" Margin="0,12,0,0" Background="Transparent"
                            BorderThickness="0" Foreground="#8C6870" Cursor="Hand" Content="忘记主密码，清空并重置信息库"
                            Click="ResetVaultButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UnlockedView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="信息库" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="本地加密保存账号、密码、API 密钥与恢复信息" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontSize="11" Foreground="#64806F"
                               Text="● 本次启动已解锁" />
                    <Button Height="38" Padding="15,0" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="立即锁定" Click="LockVault_Click" />
                    <Button Height="38" Padding="17,0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="＋ 添加信息" Click="AddEntry_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" Background="#A8FFFFFF" BorderBrush="#B8DDE7F1" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Height="40" Padding="12,8" Background="#F7FAFE"
                                     BorderBrush="#D6E2ED" BorderThickness="1" FontSize="13"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholderText" Margin="13,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontSize="12" Foreground="#93A0AE"
                                       Text="搜索名称、账号、主机或备注" />
                        </Grid>
                        <ComboBox x:Name="TypeFilterComboBox" Grid.Row="2" Height="38" Padding="9,6"
                                  SelectionChanged="TypeFilterComboBox_SelectionChanged" />
                        <ListBox x:Name="EntriesList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="EntriesList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Padding="14,12" Background="#8AFFFFFF"
                                                        BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="#D6F4F9FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="#E7EEF7FF" />
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#93B7E7FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#758496" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center"
                                                Background="#EEF3FA" CornerRadius="8">
                                            <TextBlock FontSize="10" Foreground="#56708D" Text="{Binding TypeDisplayName}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="26,22" Background="#A8FFFFFF" BorderBrush="#B8DDE7F1"
                        BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <StackPanel x:Name="EmptyDetailView" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource IconTextStyle}" FontSize="32" Foreground="#96A9BB" Text="&#xE8D5;" />
                            <TextBlock Margin="0,13,0,0" FontSize="16" FontWeight="SemiBold" Text="选择一条信息查看详情" />
                            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="秘密内容默认隐藏" />
                        </StackPanel>

                        <Grid x:Name="EntryDetailView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="DetailTitleText" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailTypeText" Margin="0,6,0,0" FontSize="12" Foreground="#5B7898" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Height="34" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="编辑" Click="EditEntry_Click" />
                                    <Button Height="34" Padding="12,0" Background="#FFF1F1" BorderBrush="#F0CECE"
                                            BorderThickness="1" Foreground="#B44A4A" Cursor="Hand" Content="删除"
                                            Click="DeleteEntry_Click" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DetailFieldsPanel">
                                    <Border x:Name="AccountField" Margin="0,0,0,10" Padding="16,13" Background="#85F8FBFE" CornerRadius="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="账号或用户名" />
                                                <TextBlock x:Name="AccountValueText" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CompactActionButtonStyle}"
                                                    Content="复制" Tag="Account" Click="CopyField_Click" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SecretField" Margin="0,0,0,10" Padding="16,13" Background="#85F8FBFE" CornerRadius="12">
                                        <Grid>
                                            <StackPanel Margin="0,0,150,0">
                                                <TextBlock x:Name="SecretFieldLabel" Style="{StaticResource DetailLabelStyle}" Text="密码或密钥" />
                                                <TextBlock x:Name="SecretValueText" Style="{StaticResource DetailValueStyle}" Text="••••••••••••" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Width="62" Margin="0,0,7,0" Style="{StaticResource CompactActionButtonStyle}"
                                                        Content="显示" Click="ToggleSecret_Click" />
                                                <Button Width="62" Style="{StaticResource CompactActionButtonStyle}"
                                                        Content="复制" Tag="Secret" Click="CopyField_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="ConnectionFields" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="14,12" Background="#85F8FBFE" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="主机或 IP" />
                                                <TextBlock x:Name="HostValueText" Style="{StaticResource DetailValueStyle}" />
                                                <Button Margin="0,9,0,0" Style="{StaticResource CompactActionButtonStyle}" Content="复制" Tag="Host" Click="CopyField_Click" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="14,12" Background="#85F8FBFE" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="端口" />
                                                <TextBlock x:Name="PortValueText" Style="{StaticResource DetailValueStyle}" />
                                                <Button Margin="0,9,0,0" Style="{StaticResource CompactActionButtonStyle}" Content="复制" Tag="Port" Click="CopyField_Click" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Padding="14,12" Background="#85F8FBFE" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock x:Name="DatabaseFieldLabel" Style="{StaticResource DetailLabelStyle}" Text="数据库" />
                                                <TextBlock x:Name="DatabaseValueText" Style="{StaticResource DetailValueStyle}" />
                                                <Button Margin="0,9,0,0" Style="{StaticResource CompactActionButtonStyle}" Content="复制" Tag="Database" Click="CopyField_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="RecoveryCodesField" Margin="0,0,0,10" Padding="16,13" Background="#85F8FBFE" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="恢复码" />
                                            <ItemsControl x:Name="RecoveryCodesItems" Margin="0,9,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="76" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Text="{Binding DisplayValue}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#7A8795" Text="{Binding StatusText}" />
                                                            <Button Grid.Column="2" Height="30" Style="{StaticResource CompactActionButtonStyle}"
                                                                    Content="复制" Tag="{Binding}" Click="CopyRecoveryCode_Click" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="NotesField" Padding="16,13" Background="#85F8FBFE" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="备注" />
                                            <TextBlock x:Name="NotesValueText" Style="{StaticResource DetailValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="4">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7C8A99"
                                           Text="复制的秘密不会进入 X-Tool 或 Windows 剪贴板历史，并将在 30 秒后清除。" />
                                <Button x:Name="AutoFillButton" Width="150" Height="42" HorizontalAlignment="Right"
                                        Style="{StaticResource PrimaryButtonStyle}" Content="一键填入客户端"
                                        Click="AutoFill_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
