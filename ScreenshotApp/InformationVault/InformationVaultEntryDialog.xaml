<Window x:Class="ScreenshotApp.InformationVault.InformationVaultEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="信息库记录"
        Width="720" Height="680"
        MinWidth="660" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334D65" />
        </Style>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9CEE8F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#2D4258" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /><Setter TargetName="Root" Property="Background" Value="#E8F3FFFF" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#82B4E8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9CEE8F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#609BFE" /><Setter TargetName="Root" Property="Background" Value="#E8F3FFFF" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#82B4E8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9CEE8F8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#405F7C" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Foreground" Value="#405F7C" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemRoot" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#DCEBFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#C9DEFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboRoot" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="10">
                                            <Grid><ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}" /><TextBlock Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#6285A8" Text="&#xE70D;" /></Grid>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboRoot" Property="Background" Value="#E4F1FFFF" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboRoot" Property="Background" Value="#DCEBFF" /><Setter TargetName="ComboRoot" Property="BorderBrush" Value="#609BFE" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,5,0,0" Padding="5" Background="#F8FAFDFF" BorderBrush="#B4D2E9FA" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#456886" /></Border.Effect>
                                    <ScrollViewer MaxHeight="290" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="96" /><Setter Property="Padding" Value="16,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A9D4E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#46627D" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEEFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#74A9E8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"><Setter Property="MinWidth" Value="112" /><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#739BFF" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="DialogIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"><Setter Property="Width" Value="38" /><Setter Property="MinWidth" Value="38" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="20" /></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" /><Setter Property="Margin" Value="3,7,3,7" /><Setter Property="Background" Value="#38D3E5F5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#89A9C7E5" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#C14D7CFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#E54D7CFE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="#FFF7FBFF" BorderBrush="#D8E7F4" BorderThickness="1" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#50677E" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
            <Grid Margin="26,0,18,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DialogTitleText" FontSize="21" FontWeight="SemiBold" Text="添加信息" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#71869A" Text="记录将写入本地加密信息库" /></StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DialogIconButtonStyle}" Content="×" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="26,4,26,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="18,16" Background="#78FFFFFF" BorderBrush="#B9DCE8F2" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="类型" /><ComboBox x:Name="TypeComboBox" Style="{StaticResource DialogComboBoxStyle}" SelectionChanged="TypeComboBox_SelectionChanged" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="名称" /><TextBox x:Name="TitleBox" Style="{StaticResource DialogTextBoxStyle}" /></StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18,16" Background="#78FFFFFF" BorderBrush="#B9DCE8F2" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel x:Name="AccountPanel"><TextBlock x:Name="AccountLabel" Style="{StaticResource FieldLabelStyle}" Text="账号" /><TextBox x:Name="AccountBox" Style="{StaticResource DialogTextBoxStyle}" /></StackPanel>
                            <StackPanel x:Name="SecretPanel" Grid.Column="2"><TextBlock x:Name="SecretLabel" Style="{StaticResource FieldLabelStyle}" Text="密码或密钥" /><PasswordBox x:Name="SecretBox" Style="{StaticResource DialogPasswordBoxStyle}" /></StackPanel>
                            <StackPanel x:Name="RecoveryCodesPanel" Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="恢复码（每行一个）" /><TextBox x:Name="RecoveryCodesBox" MinHeight="112" Style="{StaticResource DialogTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /></StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ConnectionPanel" Margin="0,12,0,0" Padding="18,16" Background="#78FFFFFF" BorderBrush="#B9DCE8F2" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="主机或 IP" /><TextBox x:Name="HostBox" Style="{StaticResource DialogTextBoxStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="端口" /><TextBox x:Name="PortBox" Style="{StaticResource DialogTextBoxStyle}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock x:Name="DatabaseLabel" Style="{StaticResource FieldLabelStyle}" Text="数据库" /><TextBox x:Name="DatabaseBox" Style="{StaticResource DialogTextBoxStyle}" /></StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18,16" Background="#78FFFFFF" BorderBrush="#B9DCE8F2" BorderThickness="1" CornerRadius="14">
                        <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="备注" /><TextBox x:Name="NotesBox" MinHeight="92" Style="{StaticResource DialogTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /></StackPanel>
                    </Border>
                    <TextBlock x:Name="ValidationText" Margin="4,12,4,0" MinHeight="18" Foreground="#C44747" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#E3EBF3" BorderThickness="0,1,0,0">
                <Grid Margin="24,0"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#7C8A99" Text="保存前请确认类型与字段内容" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button Margin="0,0,10,0" Style="{StaticResource DialogButtonStyle}" Content="取消" Click="Cancel_Click" /><Button Style="{StaticResource DialogPrimaryButtonStyle}" Content="保存记录" Click="Save_Click" /></StackPanel></Grid>
            </Border>
        </Grid>
    </Border>
</Window>
