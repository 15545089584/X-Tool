<Window x:Class="ScreenshotApp.InformationVault.InformationVaultResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置信息库"
        Width="500" Height="310"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ResetTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="12,8" /><Setter Property="Background" Value="#B8FFFFFF" /><Setter Property="BorderBrush" Value="#E7C5C5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#2D4258" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#D36A6A" /><Setter TargetName="Root" Property="Background" Value="#FFF8F8" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#D99A9A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="92" /><Setter Property="Padding" Value="16,0" /><Setter Property="Background" Value="#86FFFFFF" /><Setter Property="BorderBrush" Value="#A9D4E8F7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#46627D" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#DCEEFF" /><Setter TargetName="Root" Property="BorderBrush" Value="#74A9E8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ResetDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ResetButtonStyle}"><Setter Property="MinWidth" Value="112" /><Setter Property="Background" Value="#D65A5A" /><Setter Property="BorderBrush" Value="#E47B7B" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    </Window.Resources>

    <Border Margin="18" Padding="26,24" Background="#FFF9FBFE" BorderBrush="#E7CFD5" BorderThickness="1" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.18" Color="#60494F" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Border Width="44" Height="44" HorizontalAlignment="Left" Background="#FFE7E7" CornerRadius="13"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#C45353" Text="&#xE7BA;" /></Border>
                <StackPanel Margin="58,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold" Text="清空并重置信息库" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#8A6A70" Text="此操作不可撤销" /></StackPanel>
            </Grid>
            <Border Grid.Row="2" Padding="13,10" Background="#FFF2F2" BorderBrush="#F2D1D1" BorderThickness="1" CornerRadius="10"><TextBlock FontSize="12" Foreground="#8E5151" TextWrapping="Wrap" Text="忘记主密码后无法恢复任何记录。清空后，所有账号、密码、密钥和恢复码都会永久删除。" /></Border>
            <Grid Grid.Row="4"><TextBox x:Name="ConfirmationBox" Style="{StaticResource ResetTextBoxStyle}" TextChanged="ConfirmationBox_TextChanged" /><TextBlock x:Name="ConfirmationPlaceholder" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12" Foreground="#A48D92" Text="输入“清空信息库”确认" /></Grid>
            <Grid Grid.Row="6"><TextBlock x:Name="ValidationText" VerticalAlignment="Center" FontSize="11" Foreground="#C44747" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,10,0" Style="{StaticResource ResetButtonStyle}" Content="取消" IsCancel="True" Click="Cancel_Click" /><Button Style="{StaticResource ResetDangerButtonStyle}" Content="永久清空" IsDefault="True" Click="Confirm_Click" /></StackPanel></Grid>
        </Grid>
    </Border>
</Window>
