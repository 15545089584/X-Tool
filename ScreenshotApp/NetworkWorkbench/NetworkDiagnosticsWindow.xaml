<Window x:Class="ScreenshotApp.NetworkWorkbench.NetworkDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接诊断" Width="860" Height="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="13,0" /><Setter Property="Background" Value="#92FFFFFF" /><Setter Property="BorderBrush" Value="#B1CFE5F5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Background" Value="#4D7CFE" /><Setter Property="BorderBrush" Value="#76A0FF" /><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="11,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="#C8FFFFFF" /><Setter Property="BorderBrush" Value="#B1CFE5F5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#405F7C" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" Padding="22" Background="#EEF8FCFF" BorderBrush="#B9D8EAF8" BorderThickness="1" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#36536D" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel><TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#304E69" Text="连接诊断" /><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#718AA2" Text="测试目标地址的 Ping、DNS、TCP、HTTP 与路由追踪；完整诊断会按层记录默认路由、DNS、TCP、HTTP 与当前代理的结果。" TextWrapping="Wrap" /></StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0" Background="#66FFFFFF" BorderBrush="#A7CEE6F5" BorderThickness="1" Foreground="#607C96" FontSize="16" Content="×" Click="Close_Click" />
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="82" /><ColumnDefinition Width="10" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBox x:Name="TargetTextBox" Text="www.microsoft.com" ToolTip="域名、IP 或 HTTP 地址" /><TextBox x:Name="PortTextBox" Grid.Column="2" Text="443" ToolTip="TCP 端口" /><Button Grid.Column="4" Style="{StaticResource PrimaryGlassButton}" Tag="Full" Content="完整诊断" Click="Diagnostic_Click" /></Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Width="72" Style="{StaticResource GlassButton}" Tag="Ping" Content="Ping" Click="Diagnostic_Click" /><Button Width="72" Margin="8,0,0,0" Style="{StaticResource GlassButton}" Tag="DNS" Content="DNS" Click="Diagnostic_Click" /><Button Width="86" Margin="8,0,0,0" Style="{StaticResource GlassButton}" Tag="TCP" Content="TCP 端口" Click="Diagnostic_Click" /><Button Width="76" Margin="8,0,0,0" Style="{StaticResource GlassButton}" Tag="HTTP" Content="HTTP" Click="Diagnostic_Click" /><Button Width="86" Margin="8,0,0,0" Style="{StaticResource GlassButton}" Tag="Trace" Content="路由追踪" Click="Diagnostic_Click" /><TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="等待诊断" /></StackPanel>
            <Border Grid.Row="6" Padding="12" Background="#70FFFFFF" BorderBrush="#9BCDE4F5" BorderThickness="1" CornerRadius="13">
                <ListBox x:Name="ResultsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Padding="12,9" Background="#82FFFFFF" BorderBrush="#7DCEE2F1" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="82" /><ColumnDefinition Width="145" /><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontSize="10" Foreground="#7890A6" Text="{Binding TimeText}" /><TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding Kind}" /><TextBlock Grid.Column="2" FontSize="11" Foreground="#45627E" Text="{Binding Target}" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="3"><TextBlock FontSize="10" Foreground="#567EA9" Text="{Binding StatusText}" /><TextBlock Margin="0,2,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding ElapsedText}" /></StackPanel><TextBlock Grid.Column="4" FontSize="10" Foreground="#526F8B" Text="{Binding Detail}" TextWrapping="Wrap" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid Grid.Row="8"><StackPanel Orientation="Horizontal"><Button x:Name="CancelButton" Width="86" Style="{StaticResource GlassButton}" Content="取消任务" Click="Cancel_Click" IsEnabled="False" /><Button Width="86" Margin="8,0,0,0" Style="{StaticResource GlassButton}" Content="清空记录" Click="Clear_Click" /></StackPanel><Button HorizontalAlignment="Right" Width="82" Style="{StaticResource PrimaryGlassButton}" Content="关闭" Click="Close_Click" /></Grid>
        </Grid>
    </Border>
</Window>
