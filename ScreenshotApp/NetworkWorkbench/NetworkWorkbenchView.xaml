                <Border Grid.Row="2" Padding="14" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="16" FontWeight="SemiBold" Text="活动端点与连接" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock x:Name="ExactTrafficStatusText" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="切换到此页时将按需启用 ETW 精确监测" ToolTip="逐连接精确流量需要 Windows 管理员授权；仅统计连接字节数，不读取数据包内容。" /><TextBlock x:Name="ConnectionsSummaryText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" /></StackPanel></Grid>
                    <Grid Grid.Row="2" Margin="6,0,21,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="0.83*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="90" /><ColumnDefinition Width="88" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><Button x:Name="ProtocolSortHeader" Style="{StaticResource NetworkSortHeader}" Tag="Protocol" Content="协议" Click="ConnectionColumnHeader_Click" /><Button x:Name="LocalAddressSortHeader" Grid.Column="1" Style="{StaticResource NetworkSortHeader}" Tag="LocalAddress" Content="本地端点" Click="ConnectionColumnHeader_Click" /><Button x:Name="RemoteAddressSortHeader" Grid.Column="2" Style="{StaticResource NetworkSortHeader}" Tag="RemoteAddress" Content="远程端点" Click="ConnectionColumnHeader_Click" /><Button x:Name="ProcessSortHeader" Grid.Column="3" Style="{StaticResource NetworkSortHeader}" Tag="Process" Content="进程" Click="ConnectionColumnHeader_Click" /><Button x:Name="PidSortHeader" Grid.Column="4" Style="{StaticResource NetworkSortHeader}" Tag="ProcessId" Content="PID" Click="ConnectionColumnHeader_Click" /><Button x:Name="TrafficSortHeader" Grid.Column="5" Style="{StaticResource NetworkSortHeader}" Tag="Traffic" Content="实时速率" ToolTip="启用精确监测后显示逐连接 ETW 数据；否则明确显示 PID 系统 I/O 估算" Click="ConnectionColumnHeader_Click" /><Button x:Name="TotalTrafficSortHeader" Grid.Column="6" Style="{StaticResource NetworkSortHeader}" Tag="TotalTraffic" Content="会话累计" ToolTip="精确模式按连接累计；估算模式按进程累计" Click="ConnectionColumnHeader_Click" /><Button x:Name="StateSortHeader" Grid.Column="7" HorizontalContentAlignment="Right" Style="{StaticResource NetworkSortHeader}" Tag="State" Content="状态" Click="ConnectionColumnHeader_Click" /></Grid>
                    <ListBox x:Name="ConnectionsListBox" Grid.Row="3" Style="{StaticResource NetworkList}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="0.83*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="90" /><ColumnDefinition Width="88" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding Protocol}" /><TextBlock Grid.Column="1" FontSize="11" Foreground="#45627E" Text="{Binding LocalAddress}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" FontSize="11" Foreground="#45627E" Text="{Binding RemoteAddress}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" FontSize="11" Foreground="#45627E" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" FontSize="10" Foreground="#617D98" Text="{Binding ProcessId}" /><TextBlock Grid.Column="5" FontSize="10" Foreground="#8A5BCC" Text="{Binding TrafficText}" /><TextBlock Grid.Column="6" FontSize="10" Foreground="#4D7CFE" Text="{Binding TotalTrafficText}" /><TextBlock Grid.Column="7" HorizontalAlignment="Right" FontSize="10" Foreground="#617D98" Text="{Binding State}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid></Border>
            </Grid>

            <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions>
                <Border Padding="18" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="保存当前网络方案" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="保存代理、PAC、主用网卡、DNS、DHCP/静态地址与 MTU 快照；应用前展示差异并创建 24 小时恢复点。" TextWrapping="Wrap" /></StackPanel><TextBox x:Name="ProfileNameTextBox" Grid.Row="2" Style="{StaticResource NetworkTextBox}" Text="开发网络" /><WrapPanel Grid.Row="4"><CheckBox x:Name="ApplyProfileProxyCheckBox" Margin="0,0,14,0" IsChecked="True" Style="{StaticResource NetworkCheckBox}" Content="代理"/><CheckBox x:Name="ApplyProfileDnsCheckBox" Margin="0,0,14,0" IsChecked="True" Style="{StaticResource NetworkCheckBox}" Content="DNS"/><CheckBox x:Name="ApplyProfileAddressCheckBox" Margin="0,0,14,0" Style="{StaticResource NetworkCheckBox}" Content="DHCP / 静态 IPv4"/><CheckBox x:Name="ApplyProfileMtuCheckBox" Style="{StaticResource NetworkCheckBox}" Content="MTU"/></WrapPanel><Grid Grid.Row="6" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource NetworkPrimaryButton}" Content="保存方案" Click="SaveProfile_Click" /><Button Grid.Column="2" Style="{StaticResource NetworkButton}" Content="重新读取" Click="ReloadProfiles_Click" /><Button Grid.Column="4" Style="{StaticResource NetworkButton}" Content="恢复应用前配置" Click="RestoreProfileSnapshot_Click" /></Grid><Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Style="{StaticResource NetworkButton}" Content="导入方案" Click="ImportProfiles_Click"/><Button Grid.Column="2" Style="{StaticResource NetworkButton}" Content="导出全部方案" Click="ExportProfiles_Click"/></Grid></Grid></Border>
                <Border Grid.Column="2" Padding="18" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock FontSize="17" FontWeight="SemiBold" Text="网络方案" /><TextBlock x:Name="ProfilesSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" /></Grid><ListBox x:Name="ProfilesListBox" Grid.Row="2" Style="{StaticResource NetworkList}"><ListBox.ItemTemplate><DataTemplate><Border Padding="14,11" Background="#50FFFFFF" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3F607F" Text="{Binding Name}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding UpdatedAtText}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#567EA9" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Style="{StaticResource NetworkPrimaryButton}" Content="应用方案" Click="ApplyProfile_Click" /><Button Grid.Column="4" Style="{StaticResource NetworkButton}" Content="删除" Click="DeleteProfile_Click" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
