                                    <Button x:Name="Days90RangeButton" Width="46" Height="22" Padding="0" Margin="3,0,0,0" Style="{StaticResource NetworkButton}" Tag="90d" Click="TrafficRange_Click" Content="90天" FontSize="9" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="3" Background="#36E8F2FF" BorderBrush="#72CFE4F4" BorderThickness="1" CornerRadius="12">
