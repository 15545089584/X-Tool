                                    <Grid Grid.Column="1"><Canvas x:Name="TrafficGridCanvas" Margin="4,0,0,0" ClipToBounds="True" IsHitTestVisible="False" /><Canvas x:Name="TrafficCanvas" Margin="4,0,0,0" Panel.ZIndex="2" ClipToBounds="True" IsHitTestVisible="False" /></Grid>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="4,3,0,0"><TextBlock x:Name="TrafficAxisStartText" HorizontalAlignment="Left" FontSize="9" Foreground="#7890A6" Text="60 秒前" /><TextBlock x:Name="TrafficAxisCenterText" HorizontalAlignment="Center" FontSize="9" Foreground="#7890A6" Text="30 秒前" /><TextBlock x:Name="TrafficAxisEndText" HorizontalAlignment="Right" FontSize="9" Foreground="#7890A6" Text="现在" /></Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="18" Style="{StaticResource NetworkCard}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="连接详情" />
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /><RowDefinition Height="21" /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource MetricTitle}" Text="主用网卡" /><TextBlock x:Name="OverviewActiveAdapterText" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Style="{StaticResource MetricTitle}" Text="默认网关" /><TextBlock x:Name="OverviewDetailGatewayText" Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Style="{StaticResource MetricTitle}" Text="DNS" /><TextBlock x:Name="OverviewDnsText" Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MetricTitle}" Text="DHCP" /><TextBlock x:Name="OverviewDhcpText" Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="#45627E" />
                                <TextBlock Grid.Row="4" Style="{StaticResource MetricTitle}" Text="Wi-Fi" /><TextBlock x:Name="OverviewWifiText" Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="5" Style="{StaticResource MetricTitle}" Text="信号 / 信道" /><TextBlock x:Name="OverviewWifiSignalText" Grid.Row="5" Grid.Column="1" FontSize="11" Foreground="#45627E" />
                                <TextBlock Grid.Row="6" Style="{StaticResource MetricTitle}" Text="当前代理" /><TextBlock x:Name="OverviewProxyText" Grid.Row="6" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="7" Style="{StaticResource MetricTitle}" Text="联网检测" /><TextBlock x:Name="OverviewProbeText" Grid.Row="7" Grid.Column="1" FontSize="10" Foreground="#45627E" TextTrimming="CharacterEllipsis" ToolTip="依次显示默认网关、DNS 与直连 HTTP 探测结果" />
                                <TextBlock Grid.Row="8" Style="{StaticResource MetricTitle}" Text="探测时间" /><TextBlock x:Name="OverviewProbeTimeText" Grid.Row="8" Grid.Column="1" FontSize="10" Foreground="#7890A6" />
                                <TextBlock Grid.Row="9" Style="{StaticResource MetricTitle}" Text="IPv6" /><TextBlock x:Name="OverviewIpv6Text" Grid.Row="9" Grid.Column="1" FontSize="11" Foreground="#45627E" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Grid.Row="4"><TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="网络事件" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button Style="{StaticResource NetworkChipButton}" Content="告警 / 预算" Click="AlertSettings_Click"/><Button Margin="7,0,0,0" Style="{StaticResource NetworkChipButton}" Content="导出历史" Click="ExportNetworkHistory_Click" ToolTip="导出当前保留期内的分钟统计与事件 CSV"/><Button x:Name="RetentionButton" Margin="7,0,0,0" Style="{StaticResource NetworkChipButton}" Content="保留 7 天" Click="RetentionButton_Click" ToolTip="点击切换 1、7、30、90 天保留期" /><Button Margin="7,0,0,0" Style="{StaticResource NetworkDangerChipButton}" Content="清除" Click="ClearNetworkHistory_Click" ToolTip="清除流量历史与网络事件" /></StackPanel></Grid>
                            <Grid Grid.Row="6">
                                <TextBlock x:Name="HistoryStatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#7890A6" Text="正在读取历史记录…" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                                <ListBox x:Name="NetworkEventsListBox" Style="{StaticResource NetworkList}">
                                    <ListBox.ItemTemplate><DataTemplate><Border MinHeight="46" Padding="12,7" Background="#58FFFFFF" BorderBrush="#58CFE3F2" BorderThickness="1" CornerRadius="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Grid.RowSpan="2" Background="{Binding AccentColor}" CornerRadius="3" /><TextBlock Grid.Column="2" VerticalAlignment="Top" FontSize="10" Foreground="#7890A6" Text="{Binding TimeText}" /><TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" FontSize="11" Foreground="#496984" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </ScrollViewer>

            <Grid x:Name="RoutesFirewallPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="790">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="330" /><RowDefinition Height="14" /><RowDefinition Height="480" /></Grid.RowDefinitions>
                <Border Padding="16" Style="{StaticResource NetworkCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="网卡、路由与防火墙" />
                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="网卡信息与路由、防火墙配置均来自 Windows；路由和防火墙区域只读，刷新不会修改系统设置。" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="RoutesFirewallStatusText" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="等待读取" />
                            <Button Width="92" Style="{StaticResource NetworkButton}" Content="重新读取" Click="RefreshDeepNetwork_Click" />
                            <Button Width="88" Margin="8,0,0,0" Style="{StaticResource NetworkButton}" Content="取消任务" Click="CancelDeepTask_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Padding="16" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="网络接口" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="物理链路与虚拟接口分开标注；地址、网关、DNS、MTU 与累计流量均来自 Windows 网络接口。" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="AdapterRefreshStatusText" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="10" Foreground="#7890A6" Text="等待刷新" /><Button x:Name="RefreshAdaptersButton" Width="96" Style="{StaticResource NetworkPrimaryButton}" Content="刷新网卡" Click="RefreshAdapters_Click" /></StackPanel></Grid>
                    <ListBox x:Name="AdaptersListBox" Grid.Row="2" Style="{StaticResource NetworkList}"><ListBox.ItemTemplate><DataTemplate><Border Padding="14,11" Background="#50FFFFFF" CornerRadius="10"><Border.ContextMenu><ContextMenu><MenuItem Header="启用网卡" Click="EnableAdapter_Click" /><MenuItem Header="禁用网卡" Click="DisableAdapter_Click" /><Separator /><MenuItem Header="释放并续租 DHCP" Click="RenewAdapterDhcp_Click" /><MenuItem Header="恢复自动 DNS" Click="ResetAdapterDns_Click" /></ContextMenu></Border.ContextMenu><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.82*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3F607F" Text="{Binding Name}" /><TextBlock Margin="8,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#4D7CFE" Text="{Binding PrimaryText}" /></StackPanel><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding Description}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1"><TextBlock FontSize="11" Foreground="#45627E" Text="{Binding StatusText}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding LinkSpeedText}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="11" Foreground="#45627E" Text="{Binding IPv4Address}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding DhcpText}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock FontSize="11" Foreground="#45627E" Text="{Binding Gateway}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding DnsServers}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="4"><TextBlock FontSize="10" Foreground="#45627E" Text="{Binding InterfaceType}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#7890A6" Text="{Binding MacText}" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid></Border>
                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#405F7C" Text="IPv4 / IPv6 路由表" /><TextBox x:Name="RoutesTextBox" Grid.Row="2" Style="{StaticResource NetworkReadOnlyTextBox}" /></Grid></Border>
                    <Border Grid.Column="2" Padding="16" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#405F7C" Text="Windows 防火墙配置文件" /><TextBox x:Name="FirewallTextBox" Grid.Row="2" Style="{StaticResource NetworkReadOnlyTextBox}" /></Grid></Border>
                </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ProxyPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                <Border Padding="18" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="38" /></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="当前用户代理" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="影响遵循 Windows 当前用户代理的应用；保存前会保留本次页面快照。" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><CheckBox x:Name="ProxyEnabledCheckBox" Content="手动代理" Style="{StaticResource NetworkCheckBox}" /><CheckBox x:Name="ProxyAutoDetectCheckBox" Margin="14,0,0,0" Content="自动检测" Style="{StaticResource NetworkCheckBox}" /></StackPanel></Grid>
                    <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource MetricTitle}" Text="代理服务器（例如 127.0.0.1:7890）" /><TextBox x:Name="ProxyServerTextBox" Margin="0,6,0,0" Style="{StaticResource NetworkTextBox}" /></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Style="{StaticResource MetricTitle}" Text="绕过列表（使用分号分隔）" /><TextBox x:Name="ProxyBypassTextBox" Margin="0,6,0,0" Style="{StaticResource NetworkTextBox}" /></StackPanel>
                    <StackPanel Grid.Row="6"><TextBlock Style="{StaticResource MetricTitle}" Text="PAC 自动配置地址" /><TextBox x:Name="ProxyPacTextBox" Margin="0,6,0,0" Style="{StaticResource NetworkTextBox}" /></StackPanel>
                    <Border Grid.Row="8" Padding="12" Background="#56EAF3FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="10"><TextBlock x:Name="ProxyChangeHintText" FontSize="10" Foreground="#5D7892" Text="尚未修改代理设置" TextWrapping="Wrap" /></Border>
                    <Grid Grid.Row="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource NetworkButton}" Content="重新读取" Click="ReloadProxy_Click" /><Button Grid.Column="2" Style="{StaticResource NetworkButton}" Content="恢复页面快照" Click="RestoreProxy_Click" /><Button Grid.Column="4" Style="{StaticResource NetworkPrimaryButton}" Content="保存代理" Click="SaveProxy_Click" /></Grid>
                </Grid></Border>
                <Border Grid.Column="2" Padding="18" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="92" /><RowDefinition Height="8" /><RowDefinition Height="38" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="38" /></Grid.RowDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="WinHTTP 与 DNS" />
                    <Border Grid.Row="2" Padding="12" Background="#56EAF3FF" BorderBrush="#8ACCE2F5" BorderThickness="1" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WinHttpProxyText" FontFamily="Consolas" FontSize="10" Foreground="#4D6883" Text="正在读取…" TextWrapping="Wrap" /></ScrollViewer></Border>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource NetworkButton}" Content="检测代理" Click="TestProxy_Click" /><Button Grid.Column="2" Style="{StaticResource NetworkButton}" Content="同步 WinHTTP" Click="SyncWinHttpProxy_Click" /><Button Grid.Column="4" Style="{StaticResource NetworkButton}" Content="清除 WinHTTP" Click="ResetWinHttpProxy_Click" /></Grid>
                    <TextBlock Grid.Row="6" FontSize="13" FontWeight="SemiBold" Foreground="#45627E" Text="主用网卡 DNS" />
                    <StackPanel Grid.Row="8"><TextBlock x:Name="ProxyDnsText" Margin="0,0,0,6" FontSize="10" Foreground="#7890A6" Text="—" TextTrimming="CharacterEllipsis" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="PrimaryDnsTextBox" Style="{StaticResource NetworkTextBox}" ToolTip="主 DNS，例如 1.1.1.1" /><TextBox x:Name="SecondaryDnsTextBox" Grid.Column="2" Style="{StaticResource NetworkTextBox}" ToolTip="备用 DNS，例如 8.8.8.8" /></Grid></StackPanel>
                    <Grid Grid.Row="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource NetworkButton}" Content="测试 DNS" Click="TestDns_Click" /><Button Grid.Column="2" Style="{StaticResource NetworkButton}" Content="自动获取" Click="ResetDns_Click" /><Button Grid.Column="4" Style="{StaticResource NetworkPrimaryButton}" Content="保存 DNS" Click="SaveDns_Click" /></Grid>
                </Grid></Border>
            </Grid>

            <ScrollViewer x:Name="WifiScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <Grid x:Name="WifiPanel" MinHeight="1212">
                <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="14" /><RowDefinition Height="560" /><RowDefinition Height="14" /><RowDefinition Height="520" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource NetworkCard}"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="当前 Wi-Fi" /><TextBlock x:Name="WifiSsidText" Style="{StaticResource MetricValue}" Text="—" /><TextBlock x:Name="WifiRadioText" Margin="0,5,0,0" FontSize="10" Foreground="#7890A6" Text="无线制式 —" /></StackPanel></Border>
                    <Border Grid.Column="2" Padding="16" Style="{StaticResource NetworkCard}"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="信号与信道" /><TextBlock x:Name="WifiSignalText" Style="{StaticResource MetricValue}" Foreground="#4D7CFE" Text="—" /><TextBlock x:Name="WifiChannelText" Margin="0,5,0,0" FontSize="10" Foreground="#7890A6" Text="信道 —" /></StackPanel></Border>
                    <Border Grid.Column="4" Padding="16" Style="{StaticResource NetworkCard}"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="接入点 BSSID" /><TextBlock x:Name="WifiBssidText" Style="{StaticResource MetricValue}" FontSize="14" Text="—" /><TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#7890A6" Text="当前无线接入点" /></StackPanel></Border>
                    <Border Grid.Column="6" Padding="16" Style="{StaticResource NetworkCard}"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="安全与带宽" /><TextBlock x:Name="WifiSecurityText" Style="{StaticResource MetricValue}" FontSize="14" Text="—" /><TextBlock x:Name="WifiWidthText" Margin="0,5,0,0" FontSize="10" Foreground="#7890A6" Text="信道宽度 —" /></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.32*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.68*" /></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource NetworkCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
