<Window x:Class="ScreenshotApp.NetworkWorkbench.NetworkDeepToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-Tool · 网络深度工具" Width="1040" Height="720" WindowStartupLocation="CenterOwner" Background="#EEF4FA">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="96"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#E8FFFFFF"/><Setter Property="BorderBrush" Value="#A9D9F3"/><Setter Property="Foreground" Value="#34516E"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#BFFFFFFF"/><Setter Property="BorderBrush" Value="#CFE2F2"/><Setter Property="Foreground" Value="#34516E"/><Setter Property="Padding" Value="12"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="Foreground" Value="#34516E"/></Style>
    </Window.Resources>
    <Border Margin="18" Padding="20" Background="#CFFFFFFF" BorderBrush="#AEDAF2" BorderThickness="1" CornerRadius="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="网络深度工具"/><TextBlock Margin="0,5,0,0" Foreground="#708AA2" Text="路由与防火墙只读核查、Wi-Fi 环境、受限局域网发现和可恢复修复。"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="重新读取" Click="Refresh_Click"/><Button Content="取消任务" Click="Cancel_Click"/></StackPanel></Grid>
            <TabControl Grid.Row="2">
                <TabItem Header="路由与防火墙"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="RoutesTextBox" FontFamily="Cascadia Mono" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><TextBox x:Name="FirewallTextBox" Grid.Column="2" FontFamily="Cascadia Mono" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"><Button Content="清理 DNS 缓存" Tag="FlushDns" Click="Repair_Click"/><Button Content="重置 Winsock" Tag="Winsock" Click="Repair_Click"/><Button Content="重置 TCP/IP" Tag="TcpIp" Click="Repair_Click"/><TextBox x:Name="FirewallPortTextBox" Width="92" Height="38" Padding="10,0" VerticalContentAlignment="Center" Text="443"/><Button Margin="8,0,8,0" Content="临时阻止端口" Tag="BlockPort" Click="Repair_Click"/><Button Content="删除临时规则" Tag="RemoveRule" Click="Repair_Click"/></StackPanel></Grid></TabItem>
                <TabItem Header="连接解释"><TextBox x:Name="ExplanationTextBox" Margin="12" FontFamily="Cascadia Mono" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
                <TabItem Header="Wi-Fi 环境"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="WifiTextBox" FontFamily="Cascadia Mono" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/><TextBox x:Name="NearbyWifiTextBox" Grid.Column="2" FontFamily="Cascadia Mono" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
                <TabItem Header="局域网发现"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Foreground="#45627E" Text="当前私有 IPv4："/><TextBox x:Name="LanAddressTextBox" Width="180" Height="38" Padding="10,0" VerticalContentAlignment="Center"/><Button Margin="8,0,0,0" Content="扫描当前 /24" Click="ScanLan_Click"/><TextBlock x:Name="LanStatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#7890A6"/></StackPanel><ListBox x:Name="LanDevicesListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono" FontSize="11" DisplayMemberPath="Display"/></Grid></TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
