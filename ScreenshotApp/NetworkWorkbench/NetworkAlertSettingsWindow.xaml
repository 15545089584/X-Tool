<Window x:Class="ScreenshotApp.NetworkWorkbench.NetworkAlertSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="网络告警与预算" Width="460" Height="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#EEF4FA">
    <Border Margin="16" Padding="22" Background="#EFFFFFFF" BorderBrush="#B8DDF2" BorderThickness="1" CornerRadius="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition/><RowDefinition Height="14"/><RowDefinition Height="42"/></Grid.RowDefinitions><StackPanel><TextBlock FontSize="21" FontWeight="SemiBold" Text="告警与流量预算"/><TextBlock Margin="0,5,0,0" Foreground="#7890A6" Text="告警连续 3 次命中后触发，并在 10 分钟内去重。预算设为 0 表示关闭。" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock VerticalAlignment="Center" Text="持续高上传阈值（MB/s）"/><TextBox x:Name="UploadTextBox" Grid.Column="1" Margin="0,6" Padding="8"/><TextBlock Grid.Row="1" VerticalAlignment="Center" Text="HTTP 高延迟阈值（ms）"/><TextBox x:Name="LatencyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="8"/><TextBlock Grid.Row="2" VerticalAlignment="Center" Text="每日流量预算（GB）"/><TextBox x:Name="BudgetTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="8"/><TextBlock Grid.Row="3" VerticalAlignment="Center" Text="静默开始小时（0-23）"/><TextBox x:Name="QuietStartTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="8"/><TextBlock Grid.Row="4" VerticalAlignment="Center" Text="静默结束小时（0-23）"/><TextBox x:Name="QuietEndTextBox" Grid.Row="4" Grid.Column="1" Margin="0,6" Padding="8"/></Grid><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="40" Content="取消" Click="Cancel_Click"/><Button Grid.Column="2" Height="40" Background="#4D7CFE" Foreground="White" Content="保存设置" Click="Save_Click"/></Grid></Grid></Border>
</Window>
