<Window x:Class="ScreenshotApp.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字提取"
        Width="680"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#596575" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#E8EEF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="#F8FBFDFF"
            BorderBrush="#D7E3F0"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#17263A" BlurRadius="28" ShadowDepth="8" Opacity="0.34" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#E4EFFF" CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#2D7DFF" FontSize="17" FontWeight="SemiBold" Text="文" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#182230" FontSize="16" FontWeight="SemiBold" Text="文字提取" />
                        <TextBlock Foreground="#8A96A6" FontSize="11" Text="完全在本机处理，不上传截图" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock FontSize="17" Text="×" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="22,0,22,12" Padding="14,10"
                    Background="#EDF5FF" BorderBrush="#D9E9FF" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                               Foreground="#34506F" FontSize="12" Text="识别完成" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="#6D7D90" FontSize="11" Text="PP-OCRv5 · CPU" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="22,0" Padding="1"
                    Background="#DDE6F0" CornerRadius="12">
                <TextBox x:Name="ResultTextBox"
                         Padding="16,14"
                         Background="#FCFDFFFF"
                         BorderThickness="0"
                         Foreground="#202B38"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="14"
                         TextBlock.LineHeight="23"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="False" />
            </Border>

            <Grid Grid.Row="3" Margin="22,12,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CopyStatusText" VerticalAlignment="Center"
                           Foreground="#7B899A" FontSize="12" Text="可以编辑识别结果后再复制" />
                <Button Grid.Column="1" Width="82" Height="36" Margin="0,0,8,0"
                        Background="#ECF1F7" BorderThickness="0" Cursor="Hand"
                        Content="关闭" Click="CloseButton_Click" />
                <Button Grid.Column="2" Width="112" Height="36"
                        Background="#2D7DFF" BorderThickness="0" Foreground="White"
                        FontWeight="SemiBold" Cursor="Hand"
                        Content="复制全部" Click="CopyAllButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
