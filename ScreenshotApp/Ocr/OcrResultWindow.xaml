<Window x:Class="ScreenshotApp.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字提取"
        Width="520"
        Height="390"
        MinWidth="420"
        MinHeight="280"
        MaxWidth="760"
        MaxHeight="680"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#596575" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#E8EEF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#F8FBFDFF"
            BorderBrush="#D7E3F0"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#17263A" BlurRadius="22" ShadowDepth="6" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,8,0" Background="Transparent"
                  Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#E4EFFF" CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#2D7DFF" FontSize="17" FontWeight="SemiBold" Text="文" />
                    </Border>
                    <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="#182230" FontSize="16" FontWeight="SemiBold" Text="文字提取" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock FontSize="17" Text="×" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="16,0" Padding="1"
                    Background="#DDE6F0" CornerRadius="12">
                <TextBox x:Name="ResultTextBox"
                         Padding="14,12"
                         Background="#FCFDFFFF"
                         BorderThickness="0"
                         Foreground="#202B38"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="14"
                         TextBlock.LineHeight="23"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="False" />
            </Border>

            <Grid Grid.Row="2" Margin="16,10,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CopyStatusText" VerticalAlignment="Center"
                           Foreground="#7B899A" FontSize="12" Text="可以编辑识别结果后再复制" />
                <Button Grid.Column="1" Width="82" Height="36" Margin="0,0,8,0"
                        Background="#ECF1F7" BorderThickness="0" Cursor="Hand"
                        Content="关闭" Click="CloseButton_Click" />
                <Button Grid.Column="2" Width="104" Height="36"
                        Background="#2D7DFF" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Click="CopyAllButton_Click">
                    <TextBlock Foreground="White" Text="复制全部" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
