<Window x:Class="ScreenshotApp.Translation.TranslationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="英译中"
        Width="540"
        Height="430"
        MinWidth="430"
        MinHeight="300"
        MaxWidth="780"
        MaxHeight="700"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#596575" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#E8EEF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#F8FBFDFF"
            BorderBrush="#D7E3F0"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#17263A" BlurRadius="22" ShadowDepth="6" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,8,0" Background="Transparent"
                  Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#E6F5EE" CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#1A9A67" FontSize="16" FontWeight="SemiBold" Text="译" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#182230" FontSize="16" FontWeight="SemiBold" Text="英译中" />
                        <TextBlock Foreground="#7B899A" FontSize="11" Text="完全离线处理" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock FontSize="17" Text="×" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="#738196" FontSize="12" FontWeight="SemiBold" Text="英文原文" />
                <Border Grid.Row="1" Margin="0,6,0,10" Background="#EEF3F8" CornerRadius="9">
                    <TextBox x:Name="SourceTextBox" Padding="10,8" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Foreground="#405064"
                             FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Border>
                <TextBlock Grid.Row="2" Foreground="#27835E" FontSize="12" FontWeight="SemiBold" Text="中文译文" />
                <Border Grid.Row="3" Margin="0,6,0,0" Background="#F4FAF7" BorderBrush="#D7EEE2" BorderThickness="1" CornerRadius="9">
                    <TextBox x:Name="TranslationTextBox" Padding="10,8" Background="Transparent" BorderThickness="0"
                             Foreground="#1F3B2F" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="16,9,16,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#7B899A" FontSize="12" />
                <Button Grid.Column="1" Width="76" Height="34" Margin="0,0,8,0"
                        Background="#ECF1F7" BorderThickness="0" Cursor="Hand" Content="关闭" Click="CloseButton_Click" />
                <Button x:Name="CopyButton" Grid.Column="2" Width="92" Height="34"
                        Background="#2D7DFF" BorderThickness="0" Cursor="Hand" Click="CopyButton_Click">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="复制译文" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
