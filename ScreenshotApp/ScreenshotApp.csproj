<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 仅面向 Windows x64：避免 onnxruntime/OpenCvSharp 等包复制全部平台原生库，输出体积可缩减约 400 MB。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>XTool</AssemblyName>
    <RootNamespace>ScreenshotApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\XTool.ico</ApplicationIcon>
    <!-- WPF 仍通过 manifest 配置 PerMonitorV2；WinForms 只承载托盘图标。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-scroll-test\**;bin-scroll-test\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ScrollCaptureTestMode)' == 'true'">
    <!-- 专用回归构建：启动后直接进入长截图，不影响 Debug/Release 正式行为。 -->
    <DefineConstants>$(DefineConstants);SCROLL_CAPTURE_TEST</DefineConstants>
    <OutputPath>bin-scroll-test\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <!-- 本地离线语音识别运行时，使用预构建 Windows C# 库。 -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SIL.Machine.Tokenization.SentencePiece" Version="3.7.1" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
    <PackageReference Include="Vortice.Direct3D11" Version="2.4.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="2.4.2" />
    <!-- 二维码的本地生成与识别，全程离线；Apache-2.0 许可。 -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- 图片与已有 PDF 的本地生成、合并采用 MIT 许可的 PDFsharp。 -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- 网络工作台历史监测数据；所有数据库 I/O 均在专用后台线程执行。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <!-- 显式使用 SQLitePCLRaw 3.x，发布 SQLite 3.50.4，避开旧 2.x 原生包的高危漏洞链。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Windows ETW 网络事件解析，用于管理员授权后的逐进程精确流量采集。 -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
    <!-- 系统概览读取只读 WMI/SMBIOS 公开信息，不用于任何系统写操作。 -->
    <PackageReference Include="System.Management" Version="6.0.0" />
    <!-- 系统诊断按需读取 Windows System/Application 事件日志，不订阅实时事件。 -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="6.0.0" />
    <!-- Windows Search 的只读 OLE DB 查询接口；索引不可用时文件工作台会自动回退到本地扫描。 -->
    <PackageReference Include="System.Data.OleDb" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 仅用于系统托盘；避免其全局 using 与 WPF 类型重名。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="RemoveLegacyReleaseArtifacts" BeforeTargets="Build">
    <!-- 清理旧版增量构建遗留的已废弃发布目录。 -->
    <RemoveDir Directories="$(OutDir)tools\hardware-sensors-v2;$(OutDir)tools\hardware-sensor;$(OutDir)tools\pawnio" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\XTool.ico" />
    <Resource Include="Assets\XTool.png" />
    <Resource Include="Assets\XToolMark.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 随程序发布经校验的 FFmpeg 命令行引擎；运行时优先从 tools\ffmpeg 查找。 -->
    <Content Include="tools\ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>tools\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- 默认 OCR 模型固定版本随程序发布，不在用户电脑现场转换。 -->
    <Content Include="Models\Ocr\default\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>models\ocr\default\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- 翻译模型按语言包独立分发，避免基础安装包被大模型拖慢。 -->
    <Content Include="Models\Translation\default\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>models\translation\default\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- 可选的中译英语言包：文件存在时随 Release 一起发布；未安装时界面会明确提示。 -->
    <Content Include="Models\Translation\zh-en\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>models\translation\zh-en\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- 固定版中文离线语音输入模型与语音端点检测模型随程序发布。 -->
    <Content Include="Models\VoiceInput\default\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>models\voice-input\default\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
