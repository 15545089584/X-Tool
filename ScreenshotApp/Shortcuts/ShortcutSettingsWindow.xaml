<Window x:Class="ScreenshotApp.Shortcuts.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Width="620" Height="590" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#92FFFFFF" />
            <Setter Property="BorderBrush" Value="#B1CFE5F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#405F7C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="#4D7CFE" />
            <Setter Property="BorderBrush" Value="#76A0FF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- 快捷键值使用紧凑的半透明圆角玻璃按钮，保持可点击语义。 -->
        <Style x:Key="ShortcutValueButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#3F5F7E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="#7EFFFFFF" BorderBrush="#A9D4EAF8" BorderThickness="1" CornerRadius="12">
                            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#466785" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C7EAF5FF" /><Setter TargetName="Root" Property="BorderBrush" Value="#6FAEF5" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#548FFF" /><Setter TargetName="Root" Property="BorderThickness" Value="1.5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.74" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" Padding="24" Background="#EEF8FCFF" BorderBrush="#B9D8EAF8" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#36536D" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#304E69" Text="快捷键设置" />
                    <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#718AA2" TextWrapping="Wrap"
                               Text="点击快捷键后按下新组合；保存前会检查应用内、系统保留及已注册的全局快捷键冲突。" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0"
                        Background="#66FFFFFF" BorderBrush="#A7CEE6F5" BorderThickness="1" Foreground="#607C96"
                        FontSize="16" Content="×" Click="Close_Click" />
            </Grid>

            <Border Grid.Row="2" Padding="0,6" Background="#70FFFFFF" BorderBrush="#9BCDE4F5" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <Grid Height="72" Margin="22,0">
                        <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#3E5B76" Text="截图" />
                        <Button x:Name="ScreenshotShortcutButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ShortcutValueButtonStyle}"
                                Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" Tag="Screenshot" />
                    </Grid>
                    <Border Height="1" Background="#55FFFFFF" />
                    <Grid Height="72" Margin="22,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="15" Foreground="#3E5B76" Text="全屏截图" />
                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#7890A6" Text="直接截取鼠标所在屏幕，无需框选" />
                        </StackPanel>
                        <Button x:Name="FullScreenShortcutButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ShortcutValueButtonStyle}"
                                Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" Tag="FullScreen" />
                    </Grid>
                    <Border Height="1" Background="#55FFFFFF" />
                    <Grid Height="72" Margin="22,0">
                        <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#3E5B76" Text="剪贴板选择粘贴" />
                        <Button x:Name="ClipboardShortcutButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ShortcutValueButtonStyle}"
                                Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" Tag="Clipboard" />
                    </Grid>
                    <Border Height="1" Background="#55FFFFFF" />
                    <Grid Height="72" Margin="22,0">
                        <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#3E5B76" Text="本地语音输入" />
                        <Button x:Name="VoiceShortcutButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ShortcutValueButtonStyle}"
                                Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" Tag="Voice" />
                    </Grid>
                    <Border Height="1" Background="#55FFFFFF" />
                    <TextBlock x:Name="ShortcutCaptureStatusText" Margin="22,14,22,16" FontSize="11" Foreground="#5E819F" TextWrapping="Wrap"
                               Text="提示：Windows 无法枚举未注册全局热键的第三方键盘钩子，X-Tool 会验证可注册的系统级冲突。" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="6">
                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#8A9AAA"
                           Text="修改后立即生效并保存到本机设置。" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="82" Style="{StaticResource PrimaryGlassButton}" Content="关闭" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
